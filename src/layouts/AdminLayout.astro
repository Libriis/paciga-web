---
// Spoločný obal admin/CRM stránok. Skelet (sidebar, horná lišta, menu podľa
// právomocí) vykresľuje React ostrov AdminShell — layout podľa vzoru
// „Efferd Dashboard 2" z 21st.dev. Autentifikáciu naďalej rieši skript
// každej stránky cez requireAuth() z admin-core.
// tw.css = Tailwind v4 utility + tokeny. Admin ho potrebuje rovnako ako web:
// skelet aj nový dashboard sú písané utility-first.
import '../styles/tw.css';
import AdminShell from '../components/admin/AdminShell.tsx';

interface Props {
  title: string;
  /** kľúč sekcie pre zvýraznenie položky v menu */
  sekcia?: string;
  /** ponechané pre staršie stránky, ktoré ešte nie sú prerobené */
  siroky?: boolean;
  /** prerobená stránka: obsah nedostane legacy triedu .adm-main, ktorej
      nadpisové pravidlá by prebili Tailwind typografiu ostrova */
  nove?: boolean;
}
const { title, sekcia = '', siroky = false, nove = false } = Astro.props;

// Brána pred prvým vykreslením. Admin stránky sú statické a session drží
// supabase-js v localStorage pod kľúčom sb-<ref>-auth-token, server ju
// nevidí. requireAuth() v každej stránke beží až po načítaní ostrovov,
// takže bez session sa na sekundu ukázal celý skelet a až potom login
// (nahlásené 30. 8. 2026 po prepnutí domény). Preto inline skript v <head>:
// beží pred parsovaním <body>, bez tokenu presmeruje ešte pred vykreslením,
// s tokenom odkryje stránku. Skutočné overenie tokenu ďalej robí
// requireAuth() a hranicu dát drží RLS; toto je len proti prebliknutiu.
// V DEMO režime (bez Supabase URL) sa brána vynechá.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
const ref = supabaseUrl ? new URL(supabaseUrl).hostname.split('.')[0] : '';
const klucSession = ref ? `sb-${ref}-auth-token` : '';
---
<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} | Paciga admin</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0c0d0f">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230c0d0f'/%3E%3Ctext x='32' y='45' font-family='Arial' font-size='40' font-weight='700' fill='%23f5f5f5' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/assets/archivo-sk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/admin-obsah.css">
<style>html:not(.adm-ok) body { visibility: hidden; }</style>
<script is:inline define:vars={{ klucSession }}>
  try {
    if (klucSession && !localStorage.getItem(klucSession)) {
      location.replace('/admin/login?next=' + encodeURIComponent(location.pathname + location.search));
    } else {
      document.documentElement.classList.add('adm-ok');
    }
  } catch (e) {
    // localStorage nedostupný (súkromný režim, blokované úložisko):
    // ukáž stránku, requireAuth() rozhodne.
    document.documentElement.classList.add('adm-ok');
  }
</script>
</head>
<body class="adm-body">
<AdminShell client:load titul={title} sekcia={sekcia}>
  <div class:list={[nove ? "adm-nove" : "adm-main", { siroky: siroky && !nove }]}>
    <slot />
  </div>
</AdminShell>
</body>
</html>
