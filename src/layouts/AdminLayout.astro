---
// Spoločný obal admin/CRM stránok: sidebar navigácia + user box + demo banner.
// Autentifikáciu rieši skript každej stránky cez requireAuth() z admin-core.

interface Props {
  title: string;
  /** obsahové stránky potrebujú širší priestor pre dvojstĺpcový editor */
  siroky?: boolean;
}
const { title, siroky = false } = Astro.props;

---
<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} | Paciga admin</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0c0d0f">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230c0d0f'/%3E%3Ctext x='32' y='45' font-family='Arial' font-size='40' font-weight='700' fill='%23f5f5f5' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/assets/archivo-sk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/admin-obsah.css">
</head>
<body>
<div class="adm-shell">
  <aside class="adm-side">
    {/* Hotové súbory, nie <Image>. Ten dáva atribút width s pôvodnou šírkou
        obrázka (1435 px) a CSS mu nastavuje len výšku, takže sa logo
        roztiahlo cez celý sidebar. Rovnaké varianty používa aj web. */}
    <a class="logo" href="/admin"><img
      src="/assets/logo-130.webp"
      srcset="/assets/logo-130.webp 130w, /assets/logo-260.webp 260w"
      sizes="130px" width="130" height="46"
      alt="Paciga" loading="eager" decoding="async" /></a>
    <a class="adm-cta" href="/admin/zakazky?nova=1">+ Nová zákazka</a>
    {/* Menu je zámerne prázdne. Skladá ho requireAuth() v admin-core podľa
        právomocí prihláseného. Keby tu bol statický zoznam, na okamih by
        blikli položky, ktoré daný používateľ vidieť nemá. */}
    <nav class="adm-nav" aria-busy="true"></nav>
    <div class="spacer"></div>
    <a class="adm-weblink" href="/" target="_blank" rel="noopener">Zobraziť web →</a>
    <div class="adm-userbox">
      <span id="adm-user"></span>
      <button type="button" id="adm-logout" class="adm-btn ghost sm">Odhlásiť</button>
    </div>
  </aside>
  <main class:list={["adm-main", { siroky }]}>
    <div id="demo-banner" class="adm-demo hidden"><strong>DEMO režim.</strong> Supabase zatiaľ nie je pripojené — všetko si môžeš preklikať, zmeny sa ukladajú len v tomto prehliadači. Po nastavení Supabase (README-BACKEND.md) sa systém prepne na ostré dáta sám.</div>
    <slot />
  </main>
</div>
</body>
</html>
