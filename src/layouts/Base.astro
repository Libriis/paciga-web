---
// Spoločný layout: hlavička, navigácia, pätička a skripty pre všetky stránky.
// tw.css = globálny Tailwind v4 (utility + Paciga tokeny) — nové veci píšeme
// utility-first, legacy classy v public/css/styles.css ostávajú v platnosti.
import '../styles/tw.css';
import { GOOGLE_PROFIL } from '../data/recenzie';
import { lokalnyObrazok } from '../lib/images';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  active?: string;
  mainId?: string;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/assets/asset-07.jpg',
  active = '',
  mainId,
} = Astro.props;

/* OG obrázok: fotky žijú v src/assets, takže pôvodná verejná cesta už na
   súbor nevedie. Cez getImage() to ale ísť nesmie. Base.astro obaľuje aj
   stránky s prerender = false a tam getImage() vráti runtime cestu
   /_image?href=..., ktorá sa pri output: 'static' nenasadzuje. Facebook by
   si teda pri zdieľaní parte vypýtal 404 a náhľad by ostal prázdny.
   Náhľady sú preto hotové súbory v public/og/, ktoré generuje
   scripts/staticke-obrazky.mjs. Externé URL (Supabase foto v parte)
   ostávajú tak, ako prišli. */
const ogCesta = lokalnyObrazok(ogImage)
  ? '/og/' + ogImage!.replace('/assets/', '').replace(/\//g, '-').replace(/\.[^.]+$/, '.jpg')
  : ogImage;
const ogImageAbs = new URL(ogCesta, Astro.site ?? Astro.url).href;

const NAV = [
  { key: 'domov', href: '/', label: 'Domov' },
  { key: 'o-nas', href: '/o-nas', label: 'O nás' },
  { key: 'informacie-pre-pozostalych', href: '/informacie-pre-pozostalych', label: 'Informácie pre pozostalých' },
  { key: 'pohrebne-sluzby', href: '/pohrebne-sluzby', label: 'Pohrebné služby' },
  { key: 'kamenarstvo', href: '/kamenarstvo', label: 'Kamenárstvo' },
  { key: 'sperky', href: '/sperky', label: 'Šperky' },
  { key: 'opustili-nas', href: '/opustili-nas', label: 'Opustili nás' },
  { key: 'aktuality', href: '/aktuality', label: 'Aktuality' },
  { key: 'kontakt', href: '/kontakt', label: 'Kontakt' },
];

/* Mega menu pod položkou Pohrebné služby: paleta všetkých 15 služieb
   v 4 skupinách. Desktop = pás pod lištou (hover/focus, JS v main.js),
   mobil = rozbaľovací zoznam skupín v draweri. Vzor: Rich Navigation
   Menu (21st.dev), implementované vanilla kvôli JS rozpočtu hlavičky. */
const SLUZBY_MEGA = [
  {
    skupina: 'Rozlúčka a obrad',
    kotva: '/pohrebne-sluzby#skupina-obrad',
    polozky: [
      { cislo: '01', nazov: 'Rakvy', href: '/pohrebne-sluzby/rakvy' },
      { cislo: '02', nazov: 'Rozlúčka a pochovanie', href: '/pohrebne-sluzby/rozlucka-a-pochovanie' },
      { cislo: '03', nazov: 'Kremácia', href: '/pohrebne-sluzby/kremacia' },
      { cislo: '04', nazov: 'Kvetinárstvo', href: '/pohrebne-sluzby/kvetinarstvo' },
      { cislo: '05', nazov: 'Oblečenie pre zosnulého', href: '/pohrebne-sluzby/oblecenie-pre-zosnuleho' },
      { cislo: '06', nazov: 'Spomienkové karty', href: '/pohrebne-sluzby/spomienkove-karty' },
    ],
  },
  {
    skupina: 'Prevoz a technológie',
    kotva: '/pohrebne-sluzby#skupina-prevoz',
    polozky: [
      { cislo: '07', nazov: 'Prevoz zosnulých NON STOP', href: '/pohrebne-sluzby/prevoz-zosnulych' },
      { cislo: '08', nazov: 'Medzinárodný prevoz', href: '/pohrebne-sluzby/medzinarodny-prevoz' },
      { cislo: '09', nazov: 'Pohrebná limuzína', href: '/pohrebne-sluzby/pohrebna-limuzina' },
      { cislo: '10', nazov: 'Prenosné chladenie', href: '/pohrebne-sluzby/prenosne-chladenie' },
    ],
  },
  {
    skupina: 'Kamenárstvo',
    kotva: '/pohrebne-sluzby#skupina-kamenarstvo',
    polozky: [
      { cislo: '11', nazov: 'Kamenárske práce', href: '/kamenarstvo' },
      { cislo: '12', nazov: '3D vizualizácia pomníka', href: '/kamenarstvo#navrh' },
    ],
  },
  {
    skupina: 'Podpora a spomienka',
    kotva: '/pohrebne-sluzby#skupina-podpora',
    polozky: [
      { cislo: '13', nazov: 'Smútkové poradenstvo', href: '/pohrebne-sluzby/smutkove-poradenstvo' },
      { cislo: '14', nazov: 'Predpríprava pohrebu', href: '/pohrebne-sluzby/predpriprava-pohrebu' },
      { cislo: '15', nazov: 'Spomienkové šperky', href: '/sperky' },
    ],
  },
];
---
<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:type" content="website">
<meta property="og:locale" content="sk_SK">
<meta property="og:image" content={ogImageAbs}>
<!-- web beží len v tmavej tónine (prepínač deň/noc odstránený 29. 7. 2026) -->
<meta name="theme-color" content="#0c0d0f">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230c0d0f'/%3E%3Ctext x='32' y='45' font-family='Arial' font-size='40' font-weight='700' fill='%23f5f5f5' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/assets/archivo-sk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="/css/dynamic.css">
<slot name="head" />
</head>
<body>

<!-- svetlo: jedna fixná vrstva pod obsahom, spojitá cez celý dokument -->
<div class="pagelight" aria-hidden="true"></div>

<!-- scroll progress -->
<div id="progress" aria-hidden="true"></div>

<!-- fixed nav -->
<header id="site-nav">
  <div class="container nav-inner">
    {/* Logo ide zámerne cez hotový súbor v public/, nie cez <Image>.
        Base.astro obaľuje aj stránky s prerender = false (index,
        opustili-nas, parte/[slug]) a tam <Image> vracia runtime cestu na
        obrázkovú službu, ktorá sa pri output: 'static' nenasadzuje.
        Logo preto na homepage vracalo 404. Rovnaký dôvod ako pri
        posteroch kariet pobočiek (commit fc64033).
        Varianty prekresli cez scripts/staticke-obrazky.mjs.
        Zložené zátvorky, nie HTML komentár: ten by šiel do každej stránky. */}
    <a href="/" class="nav-logo"><img
      src="/assets/logo-130.webp"
      srcset="/assets/logo-130.webp 130w, /assets/logo-260.webp 260w"
      sizes="130px" width="130" height="46"
      alt="Paciga, pohrebné a kamenárske služby" loading="eager" decoding="async" /></a>
    <button class="nav-burger" id="nav-burger" aria-label="Otvoriť menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav-links" id="nav-links" aria-label="Hlavné menu">
      {NAV.map((item) => item.key === 'pohrebne-sluzby' ? (
        <div class="nav-item" id="nav-sluzby">
          <a href={item.href} class:list={['nav-link', { 'is-active': item.key === active }]} id="nav-sluzby-link" aria-haspopup="true" aria-expanded="false">{item.label}</a>
          <button class="nav-sub-toggle" id="nav-sub-toggle" type="button" aria-expanded="false" aria-controls="nav-sub" aria-label="Rozbaliť prehľad služieb"><span aria-hidden="true"></span></button>
          <div class="megamenu" id="megamenu" aria-label="Prehľad služieb">
            <div class="container mega-grid">
              {SLUZBY_MEGA.map((sk) => (
                <div class="mega-col">
                  <a class="mega-label" href={sk.kotva}>{sk.skupina}</a>
                  {sk.polozky.map((p) => (
                    <a href={p.href} class="mega-link"><i>{p.cislo}</i>{p.nazov}</a>
                  ))}
                </div>
              ))}
            </div>
            <div class="container mega-foot">
              <a href="/pohrebne-sluzby" class="mega-all">Prehľad všetkých 15 služieb →</a>
              <span class="mega-note">NON STOP · 0903 596 364</span>
            </div>
          </div>
          <div class="nav-sub" id="nav-sub">
            {SLUZBY_MEGA.map((sk) => (
              <a class="nav-sub-link" href={sk.kotva}>{sk.skupina}</a>
            ))}
          </div>
        </div>
      ) : (
        <a href={item.href} class:list={['nav-link', { 'is-active': item.key === active }]}>{item.label}</a>
      ))}
      <a href="tel:0903596364" class="nav-cta"><span class="dot"></span>NON STOP · 0903 596 364</a>
    </nav>
  </div>
</header>

<!-- trvalé click-to-call: viditeľné, keď nav (a s ním telefón) nie je poruke -->
<a href="tel:0903596364" class="callpill" id="callpill" aria-label="Zavolať NON STOP linku 0903 596 364">
  <span class="dot" aria-hidden="true"></span>NON STOP · 0903 596 364
</a>

<main id={mainId}>

<slot />

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <img
          src="/assets/logo-110.webp"
          srcset="/assets/logo-110.webp 110w, /assets/logo-220.webp 220w"
          sizes="110px" width="110" height="39"
          alt="Paciga, pohrebné a kamenárske služby" loading="lazy" decoding="async" />
        <p>Pohrebné a kamenárske služby Paciga. Rodinná firma, ktorá vás sprevádza s úctou od roku 2018.</p>
        <div class="footer-social">
          <a href="https://www.facebook.com/pakspaciga/" target="_blank" rel="noopener">Facebook</a>
          <a href="https://www.youtube.com/@PacigaPohrebneSluzby" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>
      <div>
        <div class="footer-title">Kontakt</div>
        <div class="footer-col">
          <a href="tel:0903596364" class="footer-phone">0903 596 364</a>
          <a href="tel:0948110109" class="footer-phone">0948 110 109</a>
          <a href="mailto:paciga@paciga.sk" class="footer-mail">paciga@paciga.sk</a>
          <span class="footer-dim">NON STOP prevoz zosnulých · 24/7</span>
        </div>
      </div>
      <div>
        <div class="footer-title">Pobočky</div>
        <div class="footer-col addresses">
          <span>Francisciho 3288/35<br>058 01 Poprad<br><a class="footer-map" href="https://www.google.com/maps/search/?api=1&query=Pohrebn%C3%A9%20a%20kamen%C3%A1rske%20slu%C5%BEby%20Paciga%20Poprad" target="_blank" rel="noopener">Navigovať na pobočku →</a></span>
          <span>Letná 17<br>059 01 Spišská Belá<br><a class="footer-map" href="https://www.google.com/maps/search/?api=1&query=Pohrebn%C3%A9%20a%20kamen%C3%A1rske%20slu%C5%BEby%20Paciga%20Spi%C5%A1sk%C3%A1%20Bel%C3%A1" target="_blank" rel="noopener">Navigovať na pobočku →</a></span>
          <span>Ester Šimerovej Martinčekovej 4506/4<br>031 01 Liptovský Mikuláš<br><a class="footer-map" href="https://www.google.com/maps/search/?api=1&query=Pohrebn%C3%A9%20a%20kamen%C3%A1rske%20slu%C5%BEby%20Paciga%20Liptovsk%C3%BD%20Mikul%C3%A1%C5%A1" target="_blank" rel="noopener">Navigovať na pobočku →</a></span>
        </div>
      </div>
      <div>
        <div class="footer-title">Menu</div>
        <div class="footer-col">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container footer-bottom-inner">
        <span>© 2026 Pohrebné a kamenárske služby Paciga, s. r. o. · IČO: 51 736 039 · IČ DPH: SK2120765900</span>
        <span class="footer-legal">
          <a href={GOOGLE_PROFIL} target="_blank" rel="noopener">Recenzie na Google</a>
          {/* Pripravené: odkomentovať, keď vzniknú právne stránky (texty dodá klient).
          <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
          <a href="/cookies">Cookies</a> */}
        </span>
      </div>
    </div>
    <!-- typografický monument — tichý podpis na konci každej stránky -->
    <div class="footer-monument" aria-hidden="true"><span>Paciga</span></div>
  </footer>

</main>

<script is:inline src="/assets/vendor/gsap.min.js"></script>
<script is:inline src="/assets/vendor/ScrollTrigger.min.js"></script>
<script is:inline src="/assets/vendor/lenis.min.js"></script>
<script is:inline src="/js/main.js"></script>
{/* Core Web Vitals z terénu. defer, aby nesúperili o pásmo s ničím
    dôležitým; web-vitals číta buffered záznamy, takže mu neskoré
    pripojenie LCP ani FCP neujde. Poradie drží defer. */}
<script is:inline defer src="/assets/vendor/web-vitals.js"></script>
<script is:inline defer src="/js/vitals.js"></script>
<slot name="scripts" />
{/* Úprava obsahu priamo na stránke. Bežný návštevník stiahne len tento
    krátky test: Supabase si reláciu ukladá do localStorage pod kľúčom
    sb-<ref>-auth-token, takže bez prihlásenia sa editor vôbec nenačíta. */}
<span id="edit-cfg" data-url={import.meta.env.PUBLIC_SUPABASE_URL} data-kluc={import.meta.env.PUBLIC_SUPABASE_ANON_KEY} hidden></span>
<script>
  /* Dynamický import: Astro z neho spraví samostatný súbor, ktorý sa stiahne
     až po zavolaní. Návštevník bez relácie teda editor ani jeho závislosti
     nesťahuje. */
  try {
    let prihlaseny = false;
    for (let i = 0; i < localStorage.length; i++) {
      if (/^sb-.*-auth-token$/.test(localStorage.key(i))) { prihlaseny = true; break; }
    }
    if (prihlaseny) import('../scripts/edit-obsah.js');
  } catch (e) { /* prehliadač bez localStorage: editor sa proste nenačíta */ }
</script>
</body>
</html>
