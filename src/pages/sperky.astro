---
/*
  Spomienkové šperky — „Ateliér": tmavá stránka s konfigurátorom.
  Veľká biela foto scéna (biele pozadie fotiek priznané ako svetlo v tmavej
  miestnosti) a segmentové prepínače tvaru a kovu. Vzor: Nike By You
  konfigurátor (Mobbin) + segmented button group (21st.dev).
  Prepínanie čistým DOM skriptom, bez React ostrova.
*/
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { Image, getImage } from 'astro:assets';
import { lokalnyObrazok, SIRKY_MEDAILON, SIRKY_KRONIKA, KVALITA_DETAIL } from '../lib/images';
import filipFoto from '../assets/filip-mesar.png';
import type { FaqItem } from '../components/Faq.astro';

const SIZES_SPERK = '(max-width: 900px) 92vw, 46vw';

const otazky: FaqItem[] = [
  {
    q: 'Čo sa do šperku gravíruje?',
    a: 'Odtlačok prsta vášho blízkeho a nápis podľa vášho želania. Práve odtlačok robí zo šperku kúsok, ktorý sa nedá nahradiť.',
  },
  {
    q: 'Ako sa získava odtlačok prsta?',
    a: 'Ak pohreb vášho blízkeho zabezpečujeme my, odtlačok snímeme sami a vy na nič nemusíte myslieť. Ak pohreb vybavovala iná služba, odtlačok nám prinesie pozostalá rodina.',
  },
  {
    q: 'V akých farbách si môžem vybrať?',
    a: 'Zlatá, strieborná a ružová, náramok vyrábame aj v čiernej. Prívesok nosíte na jemnej retiazke alebo na kordónovej šnúrke, náramok na čiernej šnúrke s posuvnými uzlami.',
  },
  {
    q: 'Aké tvary sú v ponuke?',
    a: 'Srdce a okrúhly medailón. Oba tvary vieme vyrobiť v ktorejkoľvek z ponúkaných farieb, ako náhrdelník aj ako náramok.',
  },
  {
    q: 'Môžem si zvoliť vlastný nápis?',
    a: 'Áno. Každý šperk gravírujeme na mieru a znenie nápisu je celkom na vás. Najčastejšie býva na šperku meno, dátum alebo krátke venovanie.',
  },
  {
    q: 'Kde si šperky môžem pozrieť naživo?',
    a: 'Na každej našej pobočke. Fotografie na tejto stránke sú len ukážkou, kompletnú kolekciu vám ukážeme na mieste.',
  },
  {
    q: 'Ako si šperk objednám?',
    a: 'Osobne na ktorejkoľvek našej pobočke. Zavolajte na 0903 596 364 a dohodnite si návštevu, na mieste prejdeme výber typu, tvaru, farby aj znenie gravíru.',
  },
];

// Fotomapa konfigurátora: typ × tvar × farba. Čierne prevedenie existuje
// len pri náramku (reálna ponuka klienta, 14.8.2026), náhrdelník má tri
// farby — spolu 14 kombinácií. Päť pôvodných fotiek je z ateliérového
// fotenia, zvyšok sú úpravy reálnych fotiek (paciga-image).
const varianty = [
  { id: 'nahrdelnik-srdce-zlata', img: '/assets/sperky/srdce-zlato.jpg', popis: 'Zlaté srdce na retiazke' },
  { id: 'nahrdelnik-srdce-strieborna', img: '/assets/sperky/srdce-striebro.jpg', popis: 'Strieborné srdce na retiazke' },
  { id: 'nahrdelnik-srdce-ruzova', img: '/assets/sperky/srdce-ruzove.jpg', popis: 'Srdce z ružového zlata na čiernej šnúrke' },
  { id: 'nahrdelnik-kruh-zlata', img: '/assets/sperky/kruh-zlato.jpg', popis: 'Zlatý medailón na retiazke' },
  { id: 'nahrdelnik-kruh-strieborna', img: '/assets/sperky/kruh-striebro.jpg', popis: 'Strieborný medailón na retiazke' },
  { id: 'nahrdelnik-kruh-ruzova', img: '/assets/sperky/nh-kruh-ruzova.jpg', popis: 'Medailón z ružového zlata na čiernej šnúrke' },
  { id: 'naramok-srdce-zlata', img: '/assets/sperky/nr-srdce-zlata.jpg', popis: 'Náramok so zlatým srdcom' },
  { id: 'naramok-srdce-strieborna', img: '/assets/sperky/nr-srdce-strieborna.jpg', popis: 'Náramok so strieborným srdcom' },
  { id: 'naramok-srdce-ruzova', img: '/assets/sperky/nr-srdce-ruzova.jpg', popis: 'Náramok so srdcom z ružového zlata' },
  { id: 'naramok-srdce-cierna', img: '/assets/sperky/nr-srdce-cierna.jpg', popis: 'Náramok s čiernym srdcom' },
  { id: 'naramok-kruh-zlata', img: '/assets/sperky/nr-kruh-zlata.jpg', popis: 'Náramok so zlatým medailónom' },
  { id: 'naramok-kruh-strieborna', img: '/assets/sperky/nr-kruh-strieborna.jpg', popis: 'Náramok so strieborným medailónom' },
  { id: 'naramok-kruh-ruzova', img: '/assets/sperky/nr-kruh-ruzova.jpg', popis: 'Náramok s medailónom z ružového zlata' },
  { id: 'naramok-kruh-cierna', img: '/assets/sperky/nr-kruh-cierna.jpg', popis: 'Náramok s čiernym medailónom' },
];

/* Fotky konfigurátora si predpočítame ručne, nie cez <Image>.
   Všetkých šestnásť leží na sebe v jednej scéne, takže sú technicky vo
   viewporte a loading="lazy" ich nezdrží — prehliadač stiahne celú sadu.
   Na mobile to bolo skoro pol megabajtu za fotky, z ktorých vidno jednu.
   Preto nesie zdroj len práve zobrazená; zvyšok čaká v data- atribútoch
   a doplní ho skript pri prepnutí (a v pokoji po načítaní stránky). */
const fotky = await Promise.all(
  varianty.map(async (v) => {
    const o = await getImage({
      src: lokalnyObrazok(v.img)!,
      widths: SIRKY_MEDAILON,
      sizes: SIZES_SPERK,
      quality: KVALITA_DETAIL,
      format: 'webp',
    });
    return {
      ...v,
      src: o.src,
      srcset: o.srcSet.attribute,
      sirka: o.attributes.width,
      vyska: o.attributes.height,
    };
  }),
);

const title = "Spomienkové šperky | Paciga, pohrebné a kamenárske služby";
const description = "Spomienkové šperky s odtlačkom prsta vášho blízkeho. Retiazky a náramky zo zlata, striebra a ružového zlata, gravírovanie podľa želania. Dostupné na každej pobočke Paciga.";
const ogTitle = "Spomienkové šperky | Paciga";
const ogDescription = "Nikdy nezabudnem. Šperky s odtlačkom prsta vášho blízkeho, gravírované podľa vášho želania.";
---
<Base title={title} description={description} active="sperky" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/sperky/kolekcia.jpg">

  <!-- ============ HERO: split s diagonálnou fotkou ============
       Podľa 21st.dev hero-section-2, preložené do brand tokenov bez Reactu:
       obsah + kontaktný riadok vľavo, fotka kolekcie s clip-path odkrytím
       vpravo. Stagger nesú existujúce data-reveal (GSAP). -->
  <section class="sperk-hero">
    <div class="sh-left">
      <div>
        <div class="eyebrow" data-reveal>Spomienkové šperky</div>
        <h1 class="sh-title" data-reveal><span class="sh-quiet">Navrhnite šperk,</span><br>ktorý pretrvá.</h1>
        <div class="sh-line" data-line></div>
        <p class="sh-lead" data-reveal>
          Typ, tvar, farba aj nápis podľa vášho želania v kombinácii
          s odtlačkom prsta vášho blízkeho. Vyskúšajte si rôzne kombinácie nižšie.
        </p>
        <a href="#konfigurator" class="sh-cta" data-reveal>Navrhnúť šperk →</a>
      </div>
      <div class="sh-contact">
        <a class="sh-ci" href="tel:0903596364">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          0903 596 364
        </a>
        <span class="sh-ci">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Dostupné na každej pobočke
        </span>
      </div>
    </div>
    <div class="sh-photo" role="img" aria-label="Kolekcia spomienkových šperkov"></div>
  </section>

  <!-- ============ KONFIGURÁTOR ============ -->
  <section id="konfigurator" class="scroll-mt-[90px] pt-[clamp(36px,5vh,60px)] pb-[clamp(72px,9vh,100px)]">
    <div class="container">
      <div class="grid gap-9 lg:grid-cols-[1.35fr_1fr] lg:items-center">

        <!-- scéna — fotky sa krížovo prelínajú -->
        <div class="v3-stage" data-reveal>
          {fotky.map((v, i) => (
            <img
              class:list={['v3-photo', { 'is-on': i === 0 }]}
              src={i === 0 ? v.src : undefined}
              srcset={i === 0 ? v.srcset : undefined}
              data-src={i === 0 ? undefined : v.src}
              data-srcset={i === 0 ? undefined : v.srcset}
              sizes={SIZES_SPERK}
              width={v.sirka}
              height={v.vyska}
              alt={v.popis}
              data-variant={v.id}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          ))}
          <div class="v3-stage-caption">
            <span id="v3-popis">Zlaté srdce na retiazke</span>
            <span class="text-dim">Gravír: odtlačok + nápis podľa želania</span>
          </div>
        </div>

        <!-- ovládanie -->
        <div>
          <div class="v3-group" data-reveal>
            <div class="v3-label">Typ</div>
            <div class="v3-seg" role="group" aria-label="Výber typu">
              <button type="button" class="v3-opt is-on" data-typ="nahrdelnik">Náhrdelník</button>
              <button type="button" class="v3-opt" data-typ="naramok">Náramok</button>
            </div>
          </div>

          <div class="v3-group" data-reveal>
            <div class="v3-label">Tvar</div>
            <div class="v3-seg" role="group" aria-label="Výber tvaru">
              <button type="button" class="v3-opt is-on" data-tvar="srdce">Srdce</button>
              <button type="button" class="v3-opt" data-tvar="kruh">Kruh</button>
            </div>
          </div>

          <div class="v3-group" data-reveal>
            <div class="v3-label">Farba</div>
            <div class="v3-seg" role="group" aria-label="Výber farby">
              <button type="button" class="v3-opt is-on" data-farba="zlata">Zlatá</button>
              <button type="button" class="v3-opt" data-farba="strieborna">Strieborná</button>
              <button type="button" class="v3-opt" data-farba="ruzova">Ružová</button>
              <button type="button" class="v3-opt" data-farba="cierna">Čierna</button>
            </div>
            <p class="v3-note">Čierne prevedenie vyrábame len pri náramku.</p>
          </div>

          <div class="v3-group" data-reveal>
            <div class="v3-label">Nápis podľa vášho želania</div>
            <p class="mt-2 max-w-[42ch] text-[15.5px] leading-[1.65] text-soft">
              Na šperku býva najčastejšie meno a dátum alebo krátke venovanie,
              napríklad „Láska pretrvá" či „Nikdy nezabudnem". Znenie je celkom na vás.
            </p>
          </div>

          <div class="mt-9 flex flex-wrap items-center gap-6" data-reveal>
            <a href="mailto:paciga@paciga.sk" class="btn-gold">Napíšte nám</a>
            <a href="tel:0903596364" class="btn-line">Zavolať 0903 596 364</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ FILIP MEŠÁR ============
       Zámer klienta (14.8.2026): nie „tvár kampane", ale osobný uhol
       „jeho najcennejší šperk" + zmienka o Montreale.
       Fotka je výrez s priehľadným pozadím (billboardové fotenie),
       sedí na presvetlenom paneli, mramorový stôl uzemňuje spodnú hranu. -->
  <section class="py-[clamp(72px,9vh,100px)]">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-[clamp(30px,4.5vw,70px)] md:grid-cols-2">
        <div>
          <div class="eyebrow" data-reveal>Montreal Canadiens</div>
          <h2 data-textreveal>Filip Mešár<br>a jeho najcennejší šperk</h2>
          <p class="mt-4 max-w-[52ch] text-[16.5px] leading-[1.7] text-soft" data-reveal>Hokejista z organizácie Montreal Canadiens sa pre náš billboard fotil so spomienkovým šperkom. Trofeje a medaily sa vyhrávajú, no šperk s odtlačkom prsta blízkeho človeka má cenu, ktorá sa nedá zmerať.</p>
        </div>
        {/* čistý výrez bez akejkoľvek podložky: mramorový stôl uzemňuje
            fotku sám, spodné rohy sú zaoblené, aby hrana nesekala */}
        <div class="relative" data-reveal>
          <Image src={filipFoto} widths={SIRKY_KRONIKA} sizes="(max-width: 900px) 92vw, 45vw" quality={KVALITA_DETAIL} alt="Filip Mešár so spomienkovým príveskom v tvare srdca s gravírovaným odtlačkom prsta" loading="lazy" class="relative block h-auto w-full rounded-b-[12px]" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AKO TO PREBIEHA ============ -->
  <section class="bg-ink2 py-[clamp(72px,9vh,100px)]">
    <div class="container">
      <div class="eyebrow" data-reveal>Ako to prebieha</div>
      <h2 data-textreveal>O všetko sa postaráme.</h2>
      <div class="mt-12 grid grid-cols-1 gap-[22px] md:grid-cols-3">
        {[
          { n: '01', t: 'Príďte na pobočku', p: 'Šperk sa objednáva osobne na ktorejkoľvek našej pobočke. Na mieste prejdeme výber typu, tvaru, farby aj znenie nápisu.' },
          { n: '02', t: 'Snímeme odtlačok', p: 'Ak pohreb zabezpečujeme my, odtlačok prsta snímeme sami. Inak nám ho prinesie pozostalá rodina.' },
          { n: '03', t: 'Šperk je váš', p: 'Hotový kúsok si prevezmete na pobočke, na ktorej ste si ho objednali.' },
        ].map((k) => (
          <div class="rounded-[18px] border border-line bg-panel p-[26px]" data-reveal>
            <div class="text-[13px] tracking-[0.2em] text-dim">{k.n}</div>
            <h3 class="mt-3 text-[21px]">{k.t}</h3>
            <p class="mt-2.5 text-[15.5px] leading-relaxed text-soft">{k.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ČASTÉ OTÁZKY ============ -->
  <section class="py-[clamp(72px,9vh,100px)]">
    <div class="container">
      <Faq items={otazky} eyebrow="Časté otázky" heading="Čo sa najčastejšie pýtate" />
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-panel py-[clamp(72px,9vh,100px)] text-center">
    <div class="container">
      <h2 data-textreveal>Napíšte nám. Radi vám poradíme.</h2>
      <p class="mx-auto mt-5 max-w-[52ch] text-[clamp(18px,1.7vw,22px)] leading-relaxed text-soft" data-reveal>Šperky si môžete pozrieť na každej našej pobočke.</p>
      {/* Len telefón. Predtým bolo pod číslom ešte tlačidlo „Napíšte nám“,
          tretí raz na stránke (konfigurátor ho má aj s telefónom). Vizuálny
          audit 22. 8. 2026: dva CTA s rovnakým zámerom pri sebe. Nadpis
          sekcie „Napíšte nám“ ostáva, mail je v pätičke o pár riadkov nižšie. */}
      <div class="mt-8" data-reveal>
        <a href="tel:0903596364" class="phone-big inline-block">0903 596 364</a>
        <div class="mt-3.5 text-[14px] tracking-[0.04em] text-dim">📍 Poprad · Spišská Belá · Liptovský Mikuláš</div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Split hero (21st.dev hero-section-2 v brand tokenoch): obsah vľavo,
     fotka kolekcie s diagonálnym clip-path odkrytím vpravo. */
  /* Hero drží len výšku obsahu — konfigurátor nastupuje hneď pod CTA. */
  .sperk-hero {
    display: flex;
    flex-direction: column;
  }
  .sh-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 44px;
    padding: clamp(110px, 14vh, 150px) clamp(28px, 4vw, 64px) 40px max(24px, calc((100vw - 1240px) / 2));
  }
  .sh-title { margin-top: 18px; font-size: clamp(38px, 4.6vw, 72px); font-weight: 680; line-height: 1.06; letter-spacing: -0.01em; font-variation-settings: var(--wide); }
  .sh-quiet { color: var(--muted); }
  .sh-line { width: 72px; height: 2px; margin: 28px 0; background: linear-gradient(90deg, var(--gold), transparent); transform-origin: left; }
  .sh-lead { max-width: 44ch; font-size: clamp(16.5px, 1.5vw, 19px); line-height: 1.7; color: var(--muted); }
  .sh-cta {
    display: inline-block;
    margin-top: 34px;
    font-size: 14px;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 0 100% / 0 1px;
    padding-bottom: 6px;
    transition: background-size 0.4s ease, color 0.3s ease;
  }
  .sh-cta:hover { background-size: 100% 1px; color: var(--fg-strong); }
  .sh-contact { display: flex; flex-wrap: wrap; gap: 14px 36px; }
  .sh-ci { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; letter-spacing: 0.04em; color: var(--dim); transition: color 0.3s ease; }
  /* telefón a adresa v hlavičke: plná dotyková výška na mobile */
  @media (max-width: 900px) { a.sh-ci { min-height: 44px; } }
  .sh-ci svg { width: 18px; height: 18px; flex: none; }
  a.sh-ci:hover { color: var(--text); }
  .sh-photo {
    min-height: 44vh;
    /* kolekcia-hero má po stranách dotiahnuté pozadie, aby sa všetkých sedem
       kúskov zmestilo do panela aj po diagonálnom reze (rozmery panela
       ostávajú nezmenené) */
    background: #f9f9f9 url('../assets/sperky/kolekcia-hero.jpg') center / cover no-repeat;
  }
  @media (min-width: 900px) {
    .sperk-hero { flex-direction: row; }
    .sh-left { width: 58%; }
    .sh-photo { width: 42%; min-height: 100%; clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); }
    :global(.js) .sh-photo { animation: shReveal 1.2s cubic-bezier(0, 0.55, 0.45, 1) both; }
  }
  @keyframes shReveal {
    from { clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%); }
    to { clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .sh-photo { animation: none; }
  }

  /* Scéna ateliéru — biely ostrov v tmavej miestnosti. Fotka vypĺňa celú
     scénu, biele pozadie fotky JE pozadím scény. */
  .v3-stage {
    position: relative;
    aspect-ratio: 1;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: #f9f9f9;
    overflow: hidden;
  }
  .v3-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .v3-photo.is-on { opacity: 1; }
  .v3-stage-caption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 13px 18px;
    border-radius: 14px;
    background: rgba(12, 13, 15, 0.82);
    backdrop-filter: blur(10px);
    color: var(--text);
    font-size: 13.5px;
    letter-spacing: 0.03em;
  }
  /* Segmentový prepínač — pilulky v spoločnom ráme (vzor 21st.dev). */
  .v3-group { margin-top: 30px; }
  .v3-group:first-child { margin-top: 0; }
  .v3-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    font-weight: 600;
  }
  .v3-seg {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 10px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(var(--fg-rgb) / 0.03);
  }
  .v3-opt {
    flex: 1 1 0;
    padding: 10px 20px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.3s ease, background 0.3s ease, opacity 0.3s ease;
  }
  .v3-opt:hover { color: var(--text); }
  .v3-opt.is-on { background: var(--gold); color: var(--bg); }
  .v3-opt:disabled { opacity: 0.35; cursor: not-allowed; }
  .v3-opt:disabled:hover { color: var(--muted); }
  .v3-note { margin-top: 10px; font-size: 13.5px; color: var(--dim); }

  /* Čítaný text nesmie na mobile klesnúť pod 14 px (pravidlo z 30. 7. 2026).
     Tieto tri miesta sa naň vtedy nedostali, merané 22. 8. 2026. Verzálkové
     štítky ako .v3-label ostávajú malé, tie nesú hierarchiu, nie obsah. */
  @media (max-width: 900px) {
    .v3-stage-caption { font-size: 14px; }
    .v3-note { font-size: 14px; }
  }
</style>

<script is:inline slot="scripts">
  // Konfigurátor — kombinácia typ × tvar × farba prepína fotku na scéne.
  // Popisy sa čítajú z alt textov fotiek, zdroj pravdy je pole varianty.
  (function () {
    var stav = { typ: 'nahrdelnik', tvar: 'srdce', farba: 'zlata' };
    var fotky = document.querySelectorAll('.v3-photo');
    var popis = document.getElementById('v3-popis');
    var ciernaBtn = document.querySelector('[data-farba="cierna"]');

    /* Doplní zdroj fotke, ktorá ho ešte nemá (viď komentár pri poli fotky). */
    function nacitaj(f) {
      if (!f.dataset.src) return;
      f.srcset = f.dataset.srcset || '';
      f.src = f.dataset.src;
      delete f.dataset.src;
      delete f.dataset.srcset;
    }

    function render() {
      /* Čierna existuje len pri náramku. Pri prepnutí na náhrdelník
         s čiernou v stave sa farba vráti na zlatú a tlačidlo sa vypne. */
      var ciernaOk = stav.typ === 'naramok';
      if (ciernaBtn) ciernaBtn.disabled = !ciernaOk;
      if (!ciernaOk && stav.farba === 'cierna') stav.farba = 'zlata';

      var id = stav.typ + '-' + stav.tvar + '-' + stav.farba;
      fotky.forEach(function (f) {
        var on = f.getAttribute('data-variant') === id;
        if (on) nacitaj(f);
        f.classList.toggle('is-on', on);
        if (on) popis.textContent = f.getAttribute('alt');
      });
      ['typ', 'tvar', 'farba'].forEach(function (os) {
        document.querySelectorAll('[data-' + os + ']').forEach(function (b) {
          b.classList.toggle('is-on', b.getAttribute('data-' + os) === stav[os]);
        });
      });
    }

    ['typ', 'tvar', 'farba'].forEach(function (os) {
      document.querySelectorAll('[data-' + os + ']').forEach(function (b) {
        b.addEventListener('click', function () {
          stav[os] = b.getAttribute('data-' + os);
          render();
        });
      });
    });
    render();

    /* Zvyšok sady dotiahneme až pri prvom dotyku ovládania. Kto stránku len
       prečíta, nezaplatí za pätnásť fotiek, ktoré neuvidí — na mobilných
       dátach je to skoro pol megabajtu. Kto konfigurátor otvorí, má ďalšie
       prepnutia okamžité. */
    var zvysokIde = false;
    function dotiahniZvysok() {
      if (zvysokIde) return;
      zvysokIde = true;
      fotky.forEach(nacitaj);
    }
    document.querySelectorAll('.v3-seg').forEach(function (seg) {
      ['pointerdown', 'focusin'].forEach(function (ev) {
        seg.addEventListener(ev, dotiahniZvysok, { once: true, passive: true });
      });
    });
  })();
</script>
