---
/*
  Detail článku — newsroom band (variant V3, vybraný 30. 7. 2026).
  Článok otvára ten istý pás s fotkou ako hlavičky podstránok, len namiesto
  názvu sekcie nesie titulok článku. Pod ním telo v úzkom stĺpci, CTA
  a tri ďalšie články.
*/
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import { SIRKY_HERO, verejnyObrazok } from '../../lib/images';
import { drobcekyLd } from '../../data/firma';
import Zdielanie from '../../components/Zdielanie.astro';
import { getClanok, ostatneClanky, bloky, maDetail, sOdkazmi } from '../../lib/clanky';

/* Články spravuje redaktor v /admin/clanky, takže zoznam adries nie je
   pri builde známy. Predtým tu bol getStaticPaths a nový článok by dostal
   stránku až po nasadení webu. */
export const prerender = false;

const { slug } = Astro.params;
const c = slug ? await getClanok(slug) : undefined;
/* Neznámy článok: 404 na pôvodnej adrese (predtým 302 na zoznam). SEO fáza 3. */
if (!c) return Astro.rewrite('/404');

const dalsie = await ostatneClanky(c.slug);

const title = `${c.titulok} | Aktuality | Paciga`;
const description = c.text;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: c.titulok,
  datePublished: c.datumIso,
  dateModified: c.upravenoIso ?? c.datumIso,
  /* SEO 10. 11. 2026: obrázok cez public/og (predtým /assets/clanky/… = 404), autor a vydavateľ = firma. */
  image: new URL(verejnyObrazok(c.foto), Astro.site ?? Astro.url).href,
  author: { '@id': new URL('/', Astro.site ?? Astro.url).href + '#firma' },
  publisher: { '@id': new URL('/', Astro.site ?? Astro.url).href + '#firma' },
}).replace(/</g, '\\u003c');
const drobceky = JSON.stringify(drobcekyLd((Astro.site ?? Astro.url).href, [['Domov', '/'], ['Aktuality', '/aktuality'], [c.titulok, '/aktuality/' + c.slug]])).replace(/</g, '\\u003c');
---
<Base title={title} description={description} active="aktuality"
  ogTitle={c.titulok} ogDescription={c.text} ogImage={c.foto}>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonld}></script>
    <script type="application/ld+json" set:html={drobceky}></script>
  </Fragment>

  <!-- ============ HLAVIČKA: newsroom band s fotkou článku ============ -->
  <section class="news-hero has-photo">
    <div class="nh-media" aria-hidden="true">
      <Foto src={c.foto} alt="" widths={SIRKY_HERO} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="container news-hero-inner">
      <div>
        <a href="/aktuality" class="clanok-back" data-reveal>← Späť na aktuality</a>
        <h1 data-textreveal>{c.titulok}</h1>
        <div class="clanok-meta" data-reveal>
          <time datetime={c.datumIso}>{c.datum}</time>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TELO ČLÁNKU ============ -->
  <article class="clanok">
    <p class="clanok-lead" data-reveal>{c.text}</p>
    {bloky(c.telo!).map((b) =>
      b.typ === 'h' ? <h2 data-reveal>{b.text}</h2>
      : b.typ === 'ul' ? <ul class="clanok-zoznam" data-reveal>{b.polozky.map((p) => <li>{sOdkazmi(p).map((x) => typeof x === 'string' ? x : <a class="gold-link" href={x.href} rel={x.href.startsWith('http') ? 'noopener' : undefined}>{x.text}</a>)}</li>)}</ul>
      : <p data-reveal>{sOdkazmi(b.text).map((x) => typeof x === 'string' ? x : <a class="gold-link" href={x.href} rel={x.href.startsWith('http') ? 'noopener' : undefined}>{x.text}</a>)}</p>
    )}

    <Zdielanie url={new URL(`/aktuality/${c.slug}`, Astro.site ?? Astro.url).href} titulok={c.titulok} typ="clanok" />

    {c.cta && (
      <aside class="clanok-cta" data-reveal>
        <h2>{c.cta.nadpis}</h2>
        <p>{c.cta.text}</p>
        <a class="btn-gold" href={c.cta.odkaz}>{c.cta.odkazText}</a>
      </aside>
    )}
  </article>

  <!-- ============ ĎALŠIE ČLÁNKY ============ -->
  <section class="clanok-dalsie">
    <div class="container">
      <h2 data-reveal>Ďalšie články</h2>
      <!-- has-detail + news-card-link rovnako ako na prehľade aktualít.
           Bez nich bol klikateľný len samotný nadpis, teda pás vysoký
           24 px, kým na prehľade sa dá klepnúť na celú kartu (odkaz má
           natiahnuté ::after cez celú plochu). Merané 22. 8. 2026.
           Komentár je nad mapou, nie v nej: telo šípky vracia jeden
           výraz, takže súrodenec pred <article> zhodí kompilátor. -->
      <div class="news-grid">
        {dalsie.map((d) => (
          <article class:list={['news-card', { 'has-detail': maDetail(d) }]} data-reveal>
            <div class="news-photo">
              <Foto src={d.foto} alt={d.fotoAlt} widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, (max-width: 1100px) 46vw, 30vw" />
            </div>
            <div class="news-card-body">
              <h3>{maDetail(d)
                ? <a class="news-card-link" href={`/aktuality/${d.slug}`}>{d.titulok}</a>
                : d.titulok}</h3>
              <div class="news-date">{d.datum}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>
