---
// Prihlásenie do administrácie / CRM.
import '../../styles/tw.css';
---
<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prihlásenie | Paciga admin</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0c0d0f">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230c0d0f'/%3E%3Ctext x='32' y='45' font-family='Arial' font-size='40' font-weight='700' fill='%23f5f5f5' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/assets/archivo-sk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div data-ui21 class="grid min-h-svh place-items-center bg-background px-5 py-16 font-sans text-foreground">
  <div id="login-wrap" class="w-full max-w-sm">
    <div class="mb-7 flex items-center gap-2.5">
      <span class="grid size-8 place-items-center rounded-[6px] bg-primary text-[14px] font-bold text-primary-foreground">P</span>
      <span class="text-[16px] font-semibold tracking-tight">Paciga</span>
    </div>

    <h1 class="text-xl font-semibold leading-tight tracking-tight">Administrácia</h1>
    <p class="mt-1 text-[14px] text-muted-foreground">Prihlás sa menom, ktoré ti nastavil správca.</p>

    <div id="demo-banner" class="mt-5 hidden rounded-md border border-border bg-secondary px-4 py-3 text-[13px] text-muted-foreground">
      <strong class="font-semibold text-foreground">DEMO režim.</strong> Prihlásiš sa ľubovoľným menom a heslom.
    </div>

    <form id="login-form" class="mt-6 rounded-lg border border-border p-5">
      <label class="block">
        <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Prihlasovacie meno</span>
        <input type="text" name="login" required autocomplete="username"
          autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="napr. paciga"
          class="mt-1.5 block h-11 w-full rounded-md border border-border bg-background px-3 text-[15px] text-foreground outline-none [color-scheme:dark] focus:border-foreground/30">
      </label>
      <label class="mt-4 block">
        <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Heslo</span>
        <input type="password" name="password" required autocomplete="current-password"
          class="mt-1.5 block h-11 w-full rounded-md border border-border bg-background px-3 text-[15px] text-foreground outline-none [color-scheme:dark] focus:border-foreground/30">
      </label>
      <button type="submit"
        class="mt-6 h-11 w-full rounded-md bg-primary text-[14.5px] font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        Prihlásiť sa
      </button>
      <p class="mt-3 min-h-5 text-[13.5px] text-muted-foreground" id="login-status"></p>
    </form>
  </div>
</div>

<script>
import { getClient, DEMO } from '../../scripts/admin-core.js';

const sb = getClient();
const next = new URLSearchParams(location.search).get('next') || '/admin';
if (DEMO) document.getElementById('demo-banner').classList.remove('hidden');

// už prihlásený? rovno dnu
sb.auth.getSession().then(({ data: { session } }) => {
  if (session) location.href = next;
});

/* Supabase Auth prihlasuje e-mailom alebo telefónom, prihlasovacie meno
   nepozná. Riešime to bez vlastnej tabuľky a bez verejného vyhľadávania:
   krátke meno doplníme na firemnú adresu. Účet „paciga" má teda v Supabase
   e-mail paciga@paciga.sk.

   Kto zadá celú adresu (obsahuje @), pošle sa tak, ako ju napísal. Vďaka
   tomu fungujú aj správcovské účty mimo firemnej domény. */
const DOMENA = 'paciga.sk';

const naEmail = (vstup) => {
  const v = vstup.trim().toLowerCase();
  return v.includes('@') ? v : `${v}@${DOMENA}`;
};

document.getElementById('login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = e.target;
  const status = document.getElementById('login-status');
  status.textContent = 'Prihlasujem…';
  status.classList.remove('text-[#d18a8a]');
  const { error } = await sb.auth.signInWithPassword({
    email: naEmail(f.elements.login.value),
    password: f.elements.password.value,
  });
  if (error) {
    // Zámerne nehovoríme, ktorá z dvoch hodnôt je zlá.
    status.textContent = 'Nesprávne prihlasovacie meno alebo heslo.';
    status.classList.add('text-[#d18a8a]');
  } else {
    location.href = next;
  }
});
</script>
</body>
</html>
