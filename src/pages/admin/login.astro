---
// Prihlásenie do administrácie / CRM.
// Fotku do pravého panelu pripraví Astro pri builde (stránka je statická),
// komponent dostane hotovú adresu — React ostrov si astro:assets nepýta.
import { getImage } from 'astro:assets';
import interierLm from '../../assets/interier-lm-showroom.jpg';
import Prihlasenie from '../../components/admin/Prihlasenie.tsx';
import '../../styles/tw.css';

const foto = await getImage({ src: interierLm, width: 1400, format: 'webp', quality: 72 });
---
<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prihlásenie | Paciga admin</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0c0d0f">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230c0d0f'/%3E%3Ctext x='32' y='45' font-family='Arial' font-size='40' font-weight='700' fill='%23f5f5f5' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/assets/archivo-sk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<Prihlasenie client:load fotoSrc={foto.src} fotoAlt="Showroom Paciga v Liptovskom Mikuláši" />

<script>
import { getClient } from '../../scripts/admin-core.js';
// Kto už session má, nech na prihlásení nestojí.
const next = new URLSearchParams(location.search).get('next') || '/admin';
getClient().auth.getSession().then(({ data: { session } }) => {
  if (session) location.href = next;
});
</script>
</body>
</html>
