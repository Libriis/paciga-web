---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Štatistiky" sekcia="statistiky">

  <h1>Štatistiky a vyhodnotenia</h1>

  <div class="chips" id="obdobie-chips" style="margin-bottom:10px"></div>
  <div class="chips" id="pobocka-chips"></div>

  <!-- ---- KPI ---- -->
  <div class="dash-grid">
    <div class="dash-card">
      <div class="dash-num" id="k-pohreby">–</div>
      <div class="dash-label">pohrebov za obdobie</div>
      <div class="kpi-poznamka" id="k-pohreby-pozn"></div>
    </div>
    <div class="dash-card">
      <div class="dash-num" id="k-trzby">–</div>
      <div class="dash-label">tržby za obdobie</div>
      <div class="kpi-poznamka" id="k-trzby-pozn"></div>
    </div>
    <div class="dash-card">
      <div class="dash-num" id="k-priemer">–</div>
      <div class="dash-label">priemerná hodnota zákazky</div>
    </div>
    <div class="dash-card">
      <div class="dash-num" id="k-kremacie">–</div>
      <div class="dash-label">podiel kremácií</div>
      <div class="kpi-poznamka" id="k-kremacie-pozn"></div>
    </div>
  </div>

  <!-- ---- POHREBY PO MESIACOCH ---- -->
  <div class="adm-card" style="margin-top:14px">
    <h2 style="margin:0 0 4px">Pohreby po mesiacoch</h2>
    <div class="legend" id="g1-legend"></div>
    <div class="chart-wrap" id="g1"></div>
    <details class="chart-tabulka"><summary>Zobraziť ako tabuľku</summary><div id="g1-tbl"></div></details>
  </div>

  <!-- ---- TRŽBY PO MESIACOCH ---- -->
  <div class="adm-card">
    <h2 style="margin:0 0 10px">Tržby po mesiacoch</h2>
    <div class="chart-wrap" id="g2"></div>
    <details class="chart-tabulka"><summary>Zobraziť ako tabuľku</summary><div id="g2-tbl"></div></details>
  </div>

  <!-- ---- POROVNANIE POBOČIEK + KREMÁCIE ---- -->
  <div class="dash-cols">
    <div class="adm-card" style="margin:0">
      <h2 style="margin:0 0 10px">Porovnanie pobočiek</h2>
      <div id="pobocky-tbl"></div>
    </div>
    <div class="adm-card" style="margin:0">
      <h2 style="margin:0 0 10px">Podiel kremácií v čase</h2>
      <div class="chart-wrap" id="g3"></div>
    </div>
  </div>

  <!-- ---- ZDROJE + MIESTA ---- -->
  <div class="dash-cols" style="margin-top:14px">
    <div class="adm-card" style="margin:0">
      <h2 style="margin:0 0 10px">Zdroje zákaziek</h2>
      <div id="zdroje-list"></div>
      <p class="kpi-poznamka" style="margin-top:12px">Odkiaľ prišla objednávka pohrebu. Pomáha rozhodnúť, kam dávať energiu v marketingu.</p>
    </div>
    <div class="adm-card" style="margin:0">
      <h2 style="margin:0 0 10px">Najčastejšie miesta rozlúčok</h2>
      <div id="miesta-list" class="rank-list"></div>
    </div>
  </div>

  <!-- ---- WEB ---- -->
  <div class="adm-card" style="margin-top:14px">
    <h2 style="margin:0 0 14px">Web a spomienky</h2>
    <div class="dash-grid">
      <div class="dash-card" style="background:var(--bg2)">
        <div class="dash-num" id="w-sviecky">–</div>
        <div class="dash-label">zapálených sviečok spolu</div>
      </div>
      <div class="dash-card" style="background:var(--bg2)">
        <div class="dash-num" id="w-kondolencie">–</div>
        <div class="dash-label">zverejnených kondolencií</div>
      </div>
      <div class="dash-card" style="background:var(--bg2)">
        <div class="dash-num" id="w-dopyty">–</div>
        <div class="dash-label">dopytov z formulára</div>
      </div>
      <div class="dash-card" style="background:var(--bg2)">
        <div class="dash-num" id="w-konverzia">–</div>
        <div class="dash-label">dopyty premenené na zákazky</div>
      </div>
    </div>
    <h2 style="font-size:15px;margin:22px 0 6px">Parte s najväčším ohlasom (sviečky)</h2>
    <div id="w-parte" class="rank-list"></div>
  </div>

<script>
import { getClient, requireAuth, esc, fmtD, fmtEUR, POBOCKY, POBOCKY_FARBY, MESIACE_KRATKE, ZDROJE, zdrojLabel, pobockaChips } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (sel) => document.querySelector(sel);

await requireAuth('statistiky');

const [zRes, dRes, kRes, pRes] = await Promise.all([
  sb.from('zakazky').select('*'),
  sb.from('dopyty').select('*'),
  sb.from('kondolencie').select('*'),
  sb.from('parte').select('*'),
]);
const vsetky = zRes.data || [];
const dopyty = dRes.data || [];
const kondolencie = kRes.data || [];
const parte = pRes.data || [];

/* ---------- tooltip vrstva ---------- */
const tip = document.createElement('div');
tip.className = 'tip hidden';
document.body.appendChild(tip);
document.addEventListener('mousemove', (e) => {
  if (tip.classList.contains('hidden')) return;
  tip.style.left = Math.min(window.innerWidth - 275, e.clientX + 14) + 'px';
  tip.style.top = (e.clientY + 16) + 'px';
});
function bindTips(root) {
  root.querySelectorAll('[data-tip]').forEach((el) => {
    el.addEventListener('mouseenter', () => { tip.innerHTML = el.dataset.tip; tip.classList.remove('hidden'); });
    el.addEventListener('mouseleave', () => tip.classList.add('hidden'));
  });
}

/* ---------- filtre ---------- */
const dnes = new Date();
const OBDOBIA = [
  { key: '12m', label: 'Posledných 12 mesiacov' },
  { key: 'rok', label: `Rok ${dnes.getFullYear()}` },
  { key: 'vlani', label: `Rok ${dnes.getFullYear() - 1}` },
  { key: 'vsetko', label: 'Celá história' },
];
let obdobie = '12m';

function rozsahMesiacov() {
  const mesiace = [];
  const push = (rok, m) => mesiace.push({ klic: `${rok}-${String(m + 1).padStart(2, '0')}`, label: `${MESIACE_KRATKE[m]}${m === 0 || mesiace.length === 0 ? ' ' + String(rok).slice(2) : ''}` });
  if (obdobie === '12m') {
    for (let i = 11; i >= 0; i--) {
      const d = new Date(dnes.getFullYear(), dnes.getMonth() - i, 1);
      push(d.getFullYear(), d.getMonth());
    }
  } else if (obdobie === 'rok') {
    for (let m = 0; m <= dnes.getMonth(); m++) push(dnes.getFullYear(), m);
  } else if (obdobie === 'vlani') {
    for (let m = 0; m < 12; m++) push(dnes.getFullYear() - 1, m);
  } else {
    const daty = vsetky.map((z) => z.datum_umrtia).filter(Boolean).sort();
    if (!daty.length) return [];
    let d = new Date(daty[0].slice(0, 7) + '-01T12:00');
    const koniec = new Date(dnes.getFullYear(), dnes.getMonth(), 1);
    while (d <= koniec && mesiace.length < 36) {
      push(d.getFullYear(), d.getMonth());
      d = new Date(d.getFullYear(), d.getMonth() + 1, 1);
    }
  }
  return mesiace;
}

function renderObdobie() {
  $('#obdobie-chips').innerHTML = OBDOBIA.map((o) =>
    `<button type="button" class="chip${obdobie === o.key ? ' on' : ''}" data-o="${o.key}">${o.label}</button>`).join('');
  document.querySelectorAll('#obdobie-chips .chip').forEach((ch) => {
    ch.addEventListener('click', () => { obdobie = ch.dataset.o; renderObdobie(); render(); });
  });
}
renderObdobie();
const aktualnaPobocka = pobockaChips($('#pobocka-chips'), render);
render();

/* ---------- hlavné vykreslenie ---------- */
function render() {
  const mesiace = rozsahMesiacov();
  const klice = new Set(mesiace.map((m) => m.klic));
  const p = aktualnaPobocka();

  const data = vsetky.filter((z) =>
    z.datum_umrtia && klice.has(z.datum_umrtia.slice(0, 7)) && (!p || z.pobocka === p));

  /* --- KPI --- */
  const trzby = data.reduce((s, z) => s + (Number(z.suma) || 0), 0);
  const soSumou = data.filter((z) => z.suma);
  const kremacie = data.filter((z) => z.typ === 'kremacia').length;
  $('#k-pohreby').textContent = data.length;
  $('#k-pohreby-pozn').textContent = data.length ? `Ø ${(data.length / mesiace.length).toFixed(1)} mesačne` : '';
  $('#k-trzby').textContent = fmtEUR(trzby);
  $('#k-trzby-pozn').textContent = trzby ? `Ø ${fmtEUR(trzby / mesiace.length)} mesačne` : '';
  $('#k-priemer').textContent = soSumou.length ? fmtEUR(trzby / soSumou.length) : '—';
  $('#k-kremacie').textContent = data.length ? Math.round((kremacie / data.length) * 100) + ' %' : '—';
  $('#k-kremacie-pozn').textContent = data.length ? `${kremacie} z ${data.length}` : '';

  /* --- príprava mesačných agregátov --- */
  const poMesiacoch = mesiace.map((m) => ({
    ...m,
    celkom: 0,
    trzby: 0,
    kremacie: 0,
    podla: Object.fromEntries(POBOCKY.map((x) => [x, 0])),
  }));
  data.forEach((z) => {
    const m = poMesiacoch.find((x) => z.datum_umrtia.startsWith(x.klic));
    if (!m) return;
    m.celkom++;
    m.trzby += Number(z.suma) || 0;
    if (z.typ === 'kremacia') m.kremacie++;
    if (m.podla[z.pobocka] !== undefined) m.podla[z.pobocka]++;
  });

  kresliPohreby(poMesiacoch, p);
  kresliTrzby(poMesiacoch);
  kresliKremacie(poMesiacoch);
  kresliPobocky(mesiace, klice);
  kresliZdroje(data);
  kresliMiesta(data);
  kresliWeb();
}

/* --- graf 1: stacked stĺpce pohrebov podľa pobočiek --- */
function kresliPohreby(mes, p) {
  const serie = p ? [p] : POBOCKY;
  $('#g1-legend').innerHTML = serie.map((x) =>
    `<span><span class="dot-p" style="background:${POBOCKY_FARBY[x]}"></span>${esc(x)}</span>`).join('');

  const W = Math.max(900, mes.length * 58), H = 190, PAD = 6, OSY = 24;
  const max = Math.max(1, ...mes.map((m) => m.celkom));
  const vyska = (n) => (n / max) * (H - 40);
  const sirka = (W - PAD * 2) / mes.length;

  let svg = `<svg viewBox="0 0 ${W} ${H + OSY}" width="${W}" height="${H + OSY}" role="img" aria-label="Pohreby po mesiacoch podľa pobočiek">`;
  mes.forEach((m, i) => {
    const x = PAD + i * sirka + sirka * 0.18;
    const w = sirka * 0.64;
    let y = H - 8;
    for (const s of [...serie].reverse()) {
      const n = m.podla[s] ?? (s === p ? m.celkom : 0);
      if (!n) continue;
      const h = Math.max(2, vyska(n));
      y -= h;
      svg += `<rect x="${x}" y="${y}" width="${w}" height="${h - 1.5}" fill="${POBOCKY_FARBY[s]}" data-tip="<div class='t-title'>${esc(s)}</div>${esc(m.label.trim())}: <b>${n}</b> pohreb${n === 1 ? '' : n < 5 ? 'y' : 'ov'}"/>`;
    }
    if (m.celkom && (m.celkom === max || i === mes.length - 1)) {
      svg += `<text x="${x + w / 2}" y="${y - 6}" class="ax" text-anchor="middle">${m.celkom}</text>`;
    }
    svg += `<text x="${x + w / 2}" y="${H + 14}" class="ax" text-anchor="middle">${esc(m.label)}</text>`;
  });
  svg += '</svg>';
  $('#g1').innerHTML = svg;
  bindTips($('#g1'));

  $('#g1-tbl').innerHTML = `<table class="tbl"><tr><th>Mesiac</th>${POBOCKY.map((x) => `<th class="num">${esc(x)}</th>`).join('')}<th class="num">Spolu</th></tr>${mes.map((m) =>
    `<tr><td>${esc(m.label)}</td>${POBOCKY.map((x) => `<td class="num">${m.podla[x] || 0}</td>`).join('')}<td class="num"><b>${m.celkom}</b></td></tr>`).join('')}</table>`;
}

/* --- graf 2: tržby po mesiacoch --- */
function kresliTrzby(mes) {
  const W = Math.max(900, mes.length * 58), H = 190, PAD = 6, OSY = 24;
  const max = Math.max(1, ...mes.map((m) => m.trzby));
  const sirka = (W - PAD * 2) / mes.length;

  let svg = `<svg viewBox="0 0 ${W} ${H + OSY}" width="${W}" height="${H + OSY}" role="img" aria-label="Tržby po mesiacoch">`;
  mes.forEach((m, i) => {
    const x = PAD + i * sirka + sirka * 0.18;
    const w = sirka * 0.64;
    const h = Math.max(m.trzby ? 3 : 0, (m.trzby / max) * (H - 40));
    const y = H - 8 - h;
    if (h) svg += `<path d="M${x},${y + h} L${x},${y + 4} Q${x},${y} ${x + 4},${y} L${x + w - 4},${y} Q${x + w},${y} ${x + w},${y + 4} L${x + w},${y + h} Z" fill="rgba(245,245,245,0.82)" data-tip="<div class='t-title'>${esc(m.label.trim())}</div>Tržby: <b>${fmtEUR(m.trzby)}</b><br><span class='t-dim'>${m.celkom} pohrebov</span>"/>`;
    if (m.trzby && (m.trzby === max || i === mes.length - 1)) {
      svg += `<text x="${x + w / 2}" y="${y - 6}" class="ax" text-anchor="middle">${Math.round(m.trzby / 1000)}k</text>`;
    }
    svg += `<text x="${x + w / 2}" y="${H + 14}" class="ax" text-anchor="middle">${esc(m.label)}</text>`;
  });
  svg += '</svg>';
  $('#g2').innerHTML = svg;
  bindTips($('#g2'));

  $('#g2-tbl').innerHTML = `<table class="tbl"><tr><th>Mesiac</th><th class="num">Pohreby</th><th class="num">Tržby</th><th class="num">Ø na zákazku</th></tr>${mes.map((m) =>
    `<tr><td>${esc(m.label)}</td><td class="num">${m.celkom}</td><td class="num">${fmtEUR(m.trzby)}</td><td class="num">${m.celkom ? fmtEUR(m.trzby / m.celkom) : '—'}</td></tr>`).join('')}</table>`;
}

/* --- graf 3: podiel kremácií v čase (čiara) --- */
function kresliKremacie(mes) {
  const W = 460, H = 170, PADX = 14, PADY = 16;
  const body = mes.map((m, i) => ({
    x: PADX + (i / Math.max(1, mes.length - 1)) * (W - PADX * 2),
    y: null,
    pct: m.celkom ? Math.round((m.kremacie / m.celkom) * 100) : null,
    m,
  }));
  const maxPct = Math.max(50, ...body.map((b) => b.pct || 0));
  body.forEach((b) => { if (b.pct !== null) b.y = H - PADY - (b.pct / maxPct) * (H - PADY * 2); });

  const platne = body.filter((b) => b.y !== null);
  let svg = `<svg viewBox="0 0 ${W} ${H + 20}" width="100%" style="max-width:${W}px" role="img" aria-label="Podiel kremácií v čase">`;
  [0, 25, 50].filter((g) => g <= maxPct).forEach((g) => {
    const gy = H - PADY - (g / maxPct) * (H - PADY * 2);
    svg += `<line x1="${PADX}" x2="${W - PADX}" y1="${gy}" y2="${gy}" stroke="rgba(245,245,245,0.08)"/><text x="${PADX - 2}" y="${gy - 3}" class="ax">${g} %</text>`;
  });
  if (platne.length > 1) {
    svg += `<polyline points="${platne.map((b) => `${b.x},${b.y}`).join(' ')}" fill="none" stroke="#f5f5f5" stroke-width="2"/>`;
  }
  platne.forEach((b, i) => {
    svg += `<circle cx="${b.x}" cy="${b.y}" r="4.5" fill="#16181c" stroke="#f5f5f5" stroke-width="2" data-tip="<div class='t-title'>${esc(b.m.label.trim())}</div>Kremácie: <b>${b.pct} %</b><br><span class='t-dim'>${b.m.kremacie} z ${b.m.celkom}</span>"/>`;
    if (i === platne.length - 1) svg += `<text x="${b.x}" y="${b.y - 10}" class="ax" text-anchor="end" style="font-weight:700;fill:#f5f5f5">${b.pct} %</text>`;
  });
  const oznac = body.filter((_, i) => i === 0 || i === body.length - 1 || i === Math.floor(body.length / 2));
  oznac.forEach((b, oi) => { const anchor = oi === 0 ? 'start' : oi === oznac.length - 1 ? 'end' : 'middle'; svg += `<text x="${b.x}" y="${H + 12}" class="ax" text-anchor="${anchor}">${esc(b.m.label)}</text>`; });
  svg += '</svg>';
  $('#g3').innerHTML = svg;
  bindTips($('#g3'));
}

/* --- porovnanie pobočiek --- */
function kresliPobocky(mesiace, klice) {
  const riadky = POBOCKY.map((pob) => {
    const zak = vsetky.filter((z) => z.pobocka === pob && z.datum_umrtia && klice.has(z.datum_umrtia.slice(0, 7)));
    const trzby = zak.reduce((s, z) => s + (Number(z.suma) || 0), 0);
    const soSumou = zak.filter((z) => z.suma).length;
    const krem = zak.filter((z) => z.typ === 'kremacia').length;
    const dni = zak
      .filter((z) => z.termin_rozlucka && z.datum_umrtia)
      .map((z) => (new Date(z.termin_rozlucka.slice(0, 10)) - new Date(z.datum_umrtia)) / 864e5)
      .filter((d) => d >= 0 && d < 30);
    return {
      pob,
      pocet: zak.length,
      trzby,
      priemer: soSumou ? trzby / soSumou : null,
      kremPct: zak.length ? Math.round((krem / zak.length) * 100) : null,
      dni: dni.length ? (dni.reduce((a, b) => a + b, 0) / dni.length).toFixed(1) : null,
    };
  });
  const maxPocet = Math.max(1, ...riadky.map((r) => r.pocet));

  $('#pobocky-tbl').innerHTML = `
    <table class="tbl">
      <tr><th>Pobočka</th><th class="num">Pohreby</th><th class="num">Tržby</th><th class="num">Ø zákazka</th><th class="num">Kremácie</th><th class="num">Ø dní do rozlúčky</th></tr>
      ${riadky.map((r) => `
      <tr>
        <td><span class="dot-p" style="background:${POBOCKY_FARBY[r.pob]}"></span>${esc(r.pob)}</td>
        <td class="num"><b>${r.pocet}</b></td>
        <td class="num">${fmtEUR(r.trzby)}</td>
        <td class="num">${r.priemer ? fmtEUR(r.priemer) : '—'}</td>
        <td class="num">${r.kremPct === null ? '—' : r.kremPct + ' %'}</td>
        <td class="num">${r.dni ?? '—'}</td>
      </tr>
      <tr><td colspan="6" style="padding:0 10px 12px"><div class="bh-track" style="height:8px"><i style="width:${Math.round((r.pocet / maxPocet) * 100)}%;background:${POBOCKY_FARBY[r.pob]};border-radius:0 4px 4px 0"></i></div></td></tr>`).join('')}
    </table>`;
}

/* --- zdroje zákaziek --- */
function kresliZdroje(data) {
  const max = Math.max(1, ...ZDROJE.map((zd) => data.filter((z) => z.zdroj === zd.key).length));
  $('#zdroje-list').innerHTML = ZDROJE.map((zd) => {
    const n = data.filter((z) => z.zdroj === zd.key).length;
    const pct = data.length ? Math.round((n / data.length) * 100) : 0;
    return `
    <div class="bar-h">
      <span class="bh-label">${zd.label}</span>
      <span class="bh-track"><i style="width:${Math.round((n / max) * 100)}%"></i></span>
      <span class="bh-num">${n} · ${pct} %</span>
    </div>`;
  }).join('');
}

/* --- top miesta rozlúčok --- */
function kresliMiesta(data) {
  const pocty = {};
  data.forEach((z) => { if (z.miesto_rozlucky) pocty[z.miesto_rozlucky] = (pocty[z.miesto_rozlucky] || 0) + 1; });
  const top = Object.entries(pocty).sort((a, b) => b[1] - a[1]).slice(0, 6);
  const max = Math.max(1, ...top.map(([, n]) => n));
  $('#miesta-list').innerHTML = top.length
    ? top.map(([miesto, n]) => `
      <div class="bar-h">
        <span class="bh-label" title="${esc(miesto)}">${esc(miesto)}</span>
        <span class="bh-track"><i style="width:${Math.round((n / max) * 100)}%"></i></span>
        <span class="bh-num">${n}</span>
      </div>`).join('')
    : '<p class="adm-empty">Žiadne dáta za zvolené obdobie.</p>';
}

/* --- web a spomienky (bez filtra obdobia — celkové čísla webu) --- */
function kresliWeb() {
  const sviecky = parte.reduce((s, x) => s + (x.sviecky || 0), 0);
  const zakazkyZDopytu = vsetky.filter((z) => z.dopyt_id).length;
  $('#w-sviecky').textContent = sviecky;
  $('#w-kondolencie').textContent = kondolencie.filter((k) => k.schvalene).length;
  $('#w-dopyty').textContent = dopyty.length;
  $('#w-konverzia').textContent = dopyty.length ? Math.round((zakazkyZDopytu / dopyty.length) * 100) + ' %' : '—';

  const top = [...parte].sort((a, b) => (b.sviecky || 0) - (a.sviecky || 0)).slice(0, 5);
  const max = Math.max(1, ...top.map((x) => x.sviecky || 0));
  $('#w-parte').innerHTML = top.map((x) => `
    <div class="bar-h">
      <span class="bh-label"><a href="/parte/${esc(x.slug)}" target="_blank" rel="noopener" style="color:var(--text)">${esc(x.meno)}</a></span>
      <span class="bh-track"><i style="width:${Math.round(((x.sviecky || 0) / max) * 100)}%"></i></span>
      <span class="bh-num">${x.sviecky || 0}</span>
    </div>`).join('');
}
</script>

