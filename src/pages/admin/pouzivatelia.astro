---
/*
  Správa právomocí. Vidí ju iba hlavný správca.

  Stránka mení, kto sa ku ktorej sekcii dostane. Samotné účty (e-mail
  a heslo) sa zakladajú v Supabase, lebo vytvorenie používateľa vyžaduje
  servisný kľúč a ten do prehliadača nepatrí.

  Skrytie položky v menu nie je ochrana. Prístupy sa vynucujú v RLS na
  tabuľkách; toto rozhranie ich len nastavuje.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Používatelia" sekcia="pouzivatelia">

  <div class="adm-head">
    <h1>Používatelia</h1>
    <button type="button" class="adm-btn" id="user-new">+ Pridať používateľa</button>
  </div>

  <div class="adm-demo" style="margin-bottom:24px">
    <strong>Ako to funguje.</strong> Tu určuješ, kto čo vidí. Samotný účet
    (prihlasovacie meno a heslo) sa zakladá v Supabase: Authentication →
    Users → Add user, so zapnutým Auto Confirm User. Meno <code>peter</code>
    znamená adresu <code>peter@paciga.sk</code>. Riadok tu a účet tam sa
    musia zhodovať, inak sa používateľ prihlási, ale neuvidí nič.
  </div>

  <form id="user-form" class="adm-form hidden">
    <h2 style="margin-top:0" id="user-form-title">Nový používateľ</h2>
    <input type="hidden" name="povodny_email">

    <div class="adm-grid2">
      <label>Prihlasovacie meno
        <input type="text" name="login" required maxlength="80"
          autocapitalize="none" spellcheck="false" placeholder="napr. peter">
        <span class="adm-hint">Bez diakritiky a medzier. Doplní sa naň <code>@paciga.sk</code>.</span>
      </label>
      <label>Meno osoby
        <input type="text" name="meno" maxlength="120" placeholder="napr. Peter Kováč">
        <span class="adm-hint">Len pre prehľad, na prihlásenie nemá vplyv.</span>
      </label>
    </div>

    <div style="margin-top:22px">
      <span class="adm-label">Čo uvidí po prihlásení</span>
      <div id="sekcie-zoznam" class="sekcie"></div>
    </div>

    <label class="adm-check" style="margin:22px 0 0">
      <input type="checkbox" name="hlavny"> Hlavný správca
    </label>
    <span class="adm-hint" style="margin-top:4px">
      Vidí všetko a smie meniť právomoci ostatných. Nechaj vypnuté, ak ide o redaktora.
    </span>

    <div class="adm-actions" style="margin-top:26px;padding-top:22px;border-top:1px solid var(--line)">
      <button type="submit" class="adm-btn">Uložiť</button>
      <button type="button" class="adm-btn ghost" id="user-cancel">Zrušiť</button>
      <span id="user-status" class="adm-status"></span>
    </div>
  </form>

  <div id="user-list"><p class="adm-empty">Načítavam…</p></div>

<style>
  .sekcie { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
  .sekcia {
    display: flex; gap: 11px; align-items: flex-start; cursor: pointer;
    padding: 12px 14px; background: var(--bg2);
    border: 1px solid var(--line); border-radius: 9px;
    transition: border-color 0.16s ease;
  }
  .sekcia:hover { border-color: var(--gold-soft); }
  .sekcia input { margin: 2px 0 0; flex-shrink: 0; }
  .sekcia strong { display: block; font-size: 14.5px; font-weight: 620; margin-bottom: 2px; }
  .sekcia span { display: block; font-size: 12.5px; color: var(--dim); line-height: 1.45; }
  .sekcie.je-vypnute { opacity: 0.45; pointer-events: none; }
  .user-pristupy { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
</style>

<script>
import { getClient, requireAuth, mojProfil, esc, SEKCIE } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (s) => document.querySelector(s);

await requireAuth();

/* Stránku smie otvoriť iba hlavný správca. Ostatných pošleme preč.
   Naozajstnú hranicu drží RLS: politika na tabuľke admini pustí dnu
   len je_hlavny_admin(), takže bežný redaktor by aj tak nedostal riadok. */
const ja = await mojProfil();
if (!ja.hlavny) location.href = '/admin';

const f = $('#user-form');
const status = $('#user-status');
let ludia = [];
let upravovany = null;

/* ---------- formulár ---------- */

$('#sekcie-zoznam').innerHTML = SEKCIE.map((s) => `
  <label class="sekcia">
    <input type="checkbox" name="sekcia" value="${esc(s.key)}">
    <span>
      <strong>${esc(s.label)}</strong>
      <span>${esc(s.popis)}</span>
    </span>
  </label>`).join('');

// Hlavný správca vidí všetko, tak výber sekcií nemá čo riešiť.
f.hlavny.addEventListener('change', () => {
  $('#sekcie-zoznam').classList.toggle('je-vypnute', f.hlavny.checked);
});

const naLogin = (email) => String(email ?? '').replace(/@paciga\.sk$/, '');
const naEmail = (login) => {
  const v = login.trim().toLowerCase();
  return v.includes('@') ? v : `${v}@paciga.sk`;
};

function otvor(u) {
  upravovany = u || null;
  f.classList.remove('hidden');
  $('#user-form-title').textContent = u ? `Úprava: ${u.meno || naLogin(u.email)}` : 'Nový používateľ';
  status.textContent = '';
  status.classList.remove('err');

  f.povodny_email.value = u?.email ?? '';
  f.login.value = u ? naLogin(u.email) : '';
  f.meno.value = u?.meno ?? '';
  f.hlavny.checked = !!u?.hlavny;

  const ma = u?.pristupy ?? [];
  const vsetko = ma.includes('*');
  f.querySelectorAll('input[name="sekcia"]').forEach((ch) => {
    ch.checked = vsetko || ma.includes(ch.value);
  });
  $('#sekcie-zoznam').classList.toggle('je-vypnute', f.hlavny.checked);

  f.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

$('#user-new').addEventListener('click', () => otvor(null));
$('#user-cancel').addEventListener('click', () => { f.classList.add('hidden'); upravovany = null; });

f.addEventListener('submit', async (e) => {
  e.preventDefault();
  status.textContent = 'Ukladám…';
  status.classList.remove('err');

  const vybrane = [...f.querySelectorAll('input[name="sekcia"]:checked')].map((ch) => ch.value);
  const hlavny = f.hlavny.checked;

  if (!hlavny && !vybrane.length) {
    status.textContent = 'Vyber aspoň jednu sekciu, inak sa používateľ nedostane nikam.';
    status.classList.add('err');
    return;
  }

  const zaznam = {
    email: naEmail(f.login.value),
    meno: f.meno.value.trim() || null,
    pristupy: hlavny ? ['*'] : vybrane,
    hlavny,
  };

  const { error } = upravovany
    ? await sb.from('admini').update(zaznam).eq('email', f.povodny_email.value)
    : await sb.from('admini').insert(zaznam);

  if (error) {
    status.textContent = error.code === '23505'
      ? 'Používateľ s týmto menom už existuje.'
      : 'Uloženie zlyhalo: ' + error.message;
    status.classList.add('err');
    return;
  }

  status.textContent = 'Uložené.';
  f.classList.add('hidden');
  upravovany = null;
  await nacitaj();
});

/* ---------- zoznam ---------- */

async function nacitaj() {
  const { data, error } = await sb.from('admini').select('*').order('hlavny', { ascending: false }).order('email');
  if (error) {
    $('#user-list').innerHTML = `<p class="adm-status err">Nepodarilo sa načítať: ${esc(error.message)}</p>`;
    return;
  }
  ludia = data || [];
  vykresli();
}

function vykresli() {
  const nazov = (k) => SEKCIE.find((s) => s.key === k)?.label ?? k;

  $('#user-list').innerHTML = ludia.map((u) => {
    const vsetko = u.hlavny || (u.pristupy ?? []).includes('*');
    const stitky = vsetko
      ? '<span class="stitok hotovo">všetky sekcie</span>'
      : ((u.pristupy ?? []).map((p) => `<span class="stitok tiche">${esc(nazov(p))}</span>`).join('')
         || '<span class="stitok skryte">bez prístupu</span>');

    return `
    <div class="obsah-riadok">
      <div class="kruh-prazdny" aria-hidden="true">${esc(naLogin(u.email).slice(0, 2).toUpperCase())}</div>
      <div class="obsah-info">
        <strong>${esc(u.meno || naLogin(u.email))}</strong>
        <div class="obsah-meta">
          <span>${esc(naLogin(u.email))}</span>
          ${u.hlavny ? '<span class="stitok ceka">hlavný správca</span>' : ''}
          ${u.user_id ? '' : '<span class="stitok ceka">účet ešte nevznikol</span>'}
        </div>
        <div class="user-pristupy">${stitky}</div>
      </div>
      <div class="adm-actions">
        <button type="button" class="adm-btn ghost sm" data-upravit="${esc(u.email)}">Upraviť</button>
        ${u.email === ja.email ? '' : `<button type="button" class="adm-btn danger sm" data-zmazat="${esc(u.email)}">Odobrať</button>`}
      </div>
    </div>`;
  }).join('');

  $('#user-list').querySelectorAll('[data-upravit]').forEach((b) =>
    b.addEventListener('click', () => otvor(ludia.find((u) => u.email === b.dataset.upravit))));
  $('#user-list').querySelectorAll('[data-zmazat]').forEach((b) =>
    b.addEventListener('click', () => odober(ludia.find((u) => u.email === b.dataset.zmazat))));
}

async function odober(u) {
  if (!u) return;
  if (!confirm(`Odobrať prístup používateľovi „${u.meno || naLogin(u.email)}"?\n\nÚčet v Supabase ostane, len sa nedostane do administrácie.`)) return;
  const { error } = await sb.from('admini').delete().eq('email', u.email);
  if (error) { alert('Odobratie zlyhalo: ' + error.message); return; }
  await nacitaj();
}

await nacitaj();
</script>
</AdminLayout>
