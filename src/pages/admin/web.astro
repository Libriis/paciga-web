---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Web a parte" active="web">

  <div class="adm-tabs" style="display:flex;gap:8px;border-bottom:1px solid var(--line);margin-bottom:30px;flex-wrap:wrap">
    <button type="button" class="adm-tab on" data-tab="parte" style="background:none;border:0;cursor:pointer;font:inherit;font-size:15px;font-weight:600;color:var(--muted);padding:12px 18px;border-bottom:2px solid transparent">Parte</button>
    <button type="button" class="adm-tab" data-tab="kondolencie" style="background:none;border:0;cursor:pointer;font:inherit;font-size:15px;font-weight:600;color:var(--muted);padding:12px 18px;border-bottom:2px solid transparent">Kondolencie<span class="badge" id="kond-badge" style="display:inline-block;min-width:20px;padding:1px 7px;margin-left:7px;border-radius:99px;background:var(--gold);color:#0c0d0f;font-size:12px;font-weight:700"></span></button>
    <button type="button" class="adm-tab" data-tab="dopyty" style="background:none;border:0;cursor:pointer;font:inherit;font-size:15px;font-weight:600;color:var(--muted);padding:12px 18px;border-bottom:2px solid transparent">Dopyty<span class="badge" id="dopyt-badge" style="display:inline-block;min-width:20px;padding:1px 7px;margin-left:7px;border-radius:99px;background:var(--gold);color:#0c0d0f;font-size:12px;font-weight:700"></span></button>
  </div>
  <style>
    .adm-tab.on { color: var(--text) !important; border-bottom-color: var(--gold) !important; }
    .adm-tab .badge:empty { display: none !important; }
  </style>

  <!-- ---- TAB: PARTE ---- -->
  <section id="tab-parte">
    <div class="adm-head">
      <h1>Smútočné oznámenia</h1>
      <button type="button" class="adm-btn" id="parte-new">+ Pridať parte</button>
    </div>

    <form id="parte-form" class="adm-form hidden">
      <h2 style="margin-top:0" id="parte-form-title">Nové parte</h2>
      <input type="hidden" name="id">
      <label>Meno a priezvisko zosnulého
        <input type="text" name="meno" required maxlength="120" placeholder="napr. Anna Kičáková">
      </label>
      <div class="adm-radio">
        <label><input type="radio" name="pohlavie" value="zena" checked> žena</label>
        <label><input type="radio" name="pohlavie" value="muz"> muž</label>
      </div>
      <div class="adm-grid3" style="margin-top:18px">
        <label>Dátum narodenia
          <input type="date" name="datum_narodenia">
        </label>
        <label>Dátum úmrtia
          <input type="date" name="datum_umrtia" required>
        </label>
        <label>Vek (doplní sa sám)
          <input type="number" name="vek" min="0" max="130">
        </label>
      </div>
      <div class="adm-grid3">
        <label>Dátum rozlúčky
          <input type="date" name="rozlucka_datum">
        </label>
        <label>Čas rozlúčky
          <input type="time" name="rozlucka_cas">
        </label>
        <label>Miesto rozlúčky
          <input type="text" name="rozlucka_miesto" maxlength="200" placeholder="napr. Dom smútku v Poprade">
        </label>
      </div>
      <label>Odkaz rodine (nepovinné — zobrazí sa namiesto štandardného textu sústrasti)
        <textarea name="odkaz_rodine" rows="3" maxlength="500"></textarea>
      </label>
      <label>Fotografia (nepovinná — zobrazí sa v krúžku namiesto iniciálok)
        <input type="file" name="foto" accept="image/*">
      </label>
      <img id="foto-nahlad" class="adm-foto-nahlad hidden" alt="">
      <label>Webová adresa parte (doplní sa sama z mena)
        <input type="text" name="slug" required pattern="[a-z0-9-]{1,80}" maxlength="80">
      </label>
      <label class="adm-check" style="margin:20px 0">
        <input type="checkbox" name="published" checked> Zverejniť na webe
      </label>
      <div class="adm-actions">
        <button type="submit" class="adm-btn">Uložiť parte</button>
        <button type="button" class="adm-btn ghost" id="parte-cancel">Zrušiť</button>
      </div>
      <p class="adm-status" id="parte-status"></p>
    </form>

    <div id="parte-list"><p class="adm-empty">Načítavam…</p></div>
  </section>

  <!-- ---- TAB: KONDOLENCIE ---- -->
  <section id="tab-kondolencie" class="hidden">
    <h1>Kondolencie</h1>
    <h2>Čakajú na schválenie</h2>
    <div id="kond-pending"><p class="adm-empty">Načítavam…</p></div>
    <h2>Schválené</h2>
    <div id="kond-approved"><p class="adm-empty">Načítavam…</p></div>
  </section>

  <!-- ---- TAB: DOPYTY ---- -->
  <section id="tab-dopyty" class="hidden">
    <h1>Dopyty z kontaktného formulára</h1>
    <div id="dopyt-list"><p class="adm-empty">Načítavam…</p></div>
  </section>

<script>
import { getClient, requireAuth, esc, fmtD, fmtDT, zmensiFotku, vytvorZakazku, noveCisloZakazky, uuid } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (sel) => document.querySelector(sel);

await requireAuth();

/* prepínanie tabov (aj priamym odkazom /admin/web#dopyty) */
const tabs = document.querySelectorAll('.adm-tab');
function ukazTab(name) {
  tabs.forEach((t) => t.classList.toggle('on', t.dataset.tab === name));
  ['parte', 'kondolencie', 'dopyty'].forEach((n) => $(`#tab-${n}`).classList.toggle('hidden', n !== name));
}
tabs.forEach((tab) => tab.addEventListener('click', () => ukazTab(tab.dataset.tab)));
if (['#kondolencie', '#dopyty'].includes(location.hash)) ukazTab(location.hash.slice(1));

initParte();
loadKondolencie();
loadDopyty();

/* ============ PARTE ============ */

function slugify(s) {
  return s.normalize('NFD').replace(/[̀-ͯ]/g, '')
    .toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
}

function vypocitajVek(nar, umr) {
  if (!nar || !umr) return '';
  const n = new Date(nar), u = new Date(umr);
  let v = u.getFullYear() - n.getFullYear();
  if (u.getMonth() < n.getMonth() || (u.getMonth() === n.getMonth() && u.getDate() < n.getDate())) v--;
  return v >= 0 ? v : '';
}

function initParte() {
  const form = $('#parte-form');
  const f = form.elements;

  $('#parte-new').addEventListener('click', () => {
    form.reset();
    f.id.value = '';
    $('#parte-form-title').textContent = 'Nové parte';
    $('#foto-nahlad').classList.add('hidden');
    form.classList.remove('hidden');
    form.scrollIntoView({ behavior: 'smooth' });
  });
  $('#parte-cancel').addEventListener('click', () => form.classList.add('hidden'));

  f.meno.addEventListener('input', () => { if (!f.id.value) f.slug.value = slugify(f.meno.value); });
  const prepocitajVek = () => { f.vek.value = vypocitajVek(f.datum_narodenia.value, f.datum_umrtia.value); };
  f.datum_narodenia.addEventListener('change', prepocitajVek);
  f.datum_umrtia.addEventListener('change', prepocitajVek);

  f.foto.addEventListener('change', () => {
    const file = f.foto.files[0];
    if (!file) return $('#foto-nahlad').classList.add('hidden');
    $('#foto-nahlad').src = URL.createObjectURL(file);
    $('#foto-nahlad').classList.remove('hidden');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const status = $('#parte-status');
    btn.disabled = true;
    status.textContent = 'Ukladám…';
    status.classList.remove('err');
    try {
      let foto_url;
      const file = f.foto.files[0];
      if (file) {
        status.textContent = 'Nahrávam fotku…';
        const blob = await zmensiFotku(file, 900);
        const cesta = `${f.slug.value}-${Date.now()}.webp`;
        const { error: upErr } = await sb.storage.from('parte-foto').upload(cesta, blob, { contentType: 'image/webp' });
        if (upErr) throw new Error('Fotku sa nepodarilo nahrať: ' + upErr.message);
        foto_url = sb.storage.from('parte-foto').getPublicUrl(cesta).data.publicUrl;
      }

      const zaznam = {
        meno: f.meno.value.trim(),
        pohlavie: f.pohlavie.value,
        slug: f.slug.value.trim(),
        datum_narodenia: f.datum_narodenia.value || null,
        datum_umrtia: f.datum_umrtia.value,
        vek: f.vek.value ? Number(f.vek.value) : null,
        rozlucka_datum: f.rozlucka_datum.value || null,
        rozlucka_cas: f.rozlucka_cas.value || null,
        rozlucka_miesto: f.rozlucka_miesto.value.trim() || null,
        odkaz_rodine: f.odkaz_rodine.value.trim() || null,
        published: f.published.checked,
        ...(foto_url ? { foto_url } : {}),
      };

      status.textContent = 'Ukladám parte…';
      const res = f.id.value
        ? await sb.from('parte').update(zaznam).eq('id', f.id.value)
        : await sb.from('parte').insert(zaznam);
      if (res.error) {
        throw new Error(res.error.code === '23505'
          ? 'Parte s touto webovou adresou už existuje — upravte pole „Webová adresa".'
          : res.error.message);
      }

      form.classList.add('hidden');
      status.textContent = '';
      loadParte();
    } catch (err) {
      status.textContent = err.message || 'Nepodarilo sa uložiť.';
      status.classList.add('err');
    } finally {
      btn.disabled = false;
    }
  });

  loadParte();
}

async function loadParte() {
  const { data, error } = await sb.from('parte').select('*')
    .order('datum_umrtia', { ascending: false }).order('created_at', { ascending: false });
  const box = $('#parte-list');
  if (error) { box.innerHTML = `<p class="adm-empty">Chyba: ${esc(error.message)}</p>`; return; }
  if (!data.length) { box.innerHTML = '<p class="adm-empty">Zatiaľ žiadne parte.</p>'; return; }
  box.innerHTML = data.map((p) => `
    <div class="adm-card adm-row">
      <div>
        <div class="nazov">${esc(p.meno)}${p.published ? '' : '<span class="off">skryté</span>'}</div>
        <div class="meta">† ${fmtD(p.datum_umrtia)}${p.rozlucka_datum ? ` · rozlúčka ${fmtD(p.rozlucka_datum)}${p.rozlucka_cas ? ' o ' + esc(p.rozlucka_cas) : ''}` : ''} · ${p.sviecky} sviečok</div>
      </div>
      <div class="adm-actions">
        <a class="adm-btn ghost sm" href="/parte/${esc(p.slug)}" target="_blank" rel="noopener">Zobraziť</a>
        <button type="button" class="adm-btn ghost sm" data-act="edit" data-id="${p.id}">Upraviť</button>
        <button type="button" class="adm-btn ghost sm" data-act="toggle" data-id="${p.id}">${p.published ? 'Skryť' : 'Zverejniť'}</button>
        <button type="button" class="adm-btn danger sm" data-act="del" data-id="${p.id}">Vymazať</button>
      </div>
    </div>`).join('');

  box.querySelectorAll('button[data-act]').forEach((btn) => {
    const p = data.find((x) => x.id === btn.dataset.id);
    btn.addEventListener('click', async () => {
      if (btn.dataset.act === 'edit') {
        const form = $('#parte-form');
        const f = form.elements;
        form.reset();
        f.id.value = p.id;
        f.meno.value = p.meno;
        f.pohlavie.value = p.pohlavie;
        f.slug.value = p.slug;
        f.datum_narodenia.value = p.datum_narodenia ?? '';
        f.datum_umrtia.value = p.datum_umrtia ?? '';
        f.vek.value = p.vek ?? '';
        f.rozlucka_datum.value = p.rozlucka_datum ?? '';
        f.rozlucka_cas.value = p.rozlucka_cas ?? '';
        f.rozlucka_miesto.value = p.rozlucka_miesto ?? '';
        f.odkaz_rodine.value = p.odkaz_rodine ?? '';
        f.published.checked = p.published;
        $('#parte-form-title').textContent = `Upraviť: ${p.meno}`;
        const nahlad = $('#foto-nahlad');
        if (p.foto_url) { nahlad.src = p.foto_url; nahlad.classList.remove('hidden'); }
        else nahlad.classList.add('hidden');
        form.classList.remove('hidden');
        form.scrollIntoView({ behavior: 'smooth' });
      }
      if (btn.dataset.act === 'toggle') {
        await sb.from('parte').update({ published: !p.published }).eq('id', p.id);
        loadParte();
      }
      if (btn.dataset.act === 'del') {
        if (!confirm(`Naozaj vymazať parte „${p.meno}"? Vymažú sa aj kondolencie a sviečky.`)) return;
        await sb.from('parte').delete().eq('id', p.id);
        loadParte();
      }
    });
  });
}

/* ============ KONDOLENCIE ============ */

async function loadKondolencie() {
  const { data, error } = await sb.from('kondolencie')
    .select('*, parte(meno)').order('created_at', { ascending: false });
  const pend = $('#kond-pending');
  const appr = $('#kond-approved');
  if (error) { pend.innerHTML = `<p class="adm-empty">Chyba: ${esc(error.message)}</p>`; appr.innerHTML = ''; return; }

  const render = (k) => `
    <div class="adm-card">
      <div class="adm-row">
        <div class="nazov">${esc(k.meno)} <span class="off">k parte ${esc(k.parte?.meno ?? '?')}</span></div>
        <div class="meta">${fmtDT(k.created_at)}</div>
      </div>
      <p class="kond-text">${esc(k.odkaz)}</p>
      <div class="adm-actions">
        ${k.schvalene ? '' : `<button type="button" class="adm-btn sm" data-act="ok" data-id="${k.id}">Schváliť a zverejniť</button>`}
        <button type="button" class="adm-btn danger sm" data-act="del" data-id="${k.id}">Vymazať</button>
      </div>
    </div>`;

  const cakajuce = data.filter((k) => !k.schvalene);
  const schvalene = data.filter((k) => k.schvalene);
  pend.innerHTML = cakajuce.length ? cakajuce.map(render).join('') : '<p class="adm-empty">Žiadne čakajúce kondolencie.</p>';
  appr.innerHTML = schvalene.length ? schvalene.map(render).join('') : '<p class="adm-empty">Zatiaľ žiadne schválené kondolencie.</p>';
  $('#kond-badge').textContent = cakajuce.length || '';

  document.querySelectorAll('#tab-kondolencie button[data-act]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (btn.dataset.act === 'ok') await sb.from('kondolencie').update({ schvalene: true }).eq('id', btn.dataset.id);
      if (btn.dataset.act === 'del') {
        if (!confirm('Naozaj vymazať túto kondolenciu?')) return;
        await sb.from('kondolencie').delete().eq('id', btn.dataset.id);
      }
      loadKondolencie();
    });
  });
}

/* ============ DOPYTY ============ */

async function loadDopyty() {
  const { data, error } = await sb.from('dopyty').select('*').order('created_at', { ascending: false }).limit(200);
  const box = $('#dopyt-list');
  if (error) { box.innerHTML = `<p class="adm-empty">Chyba: ${esc(error.message)}</p>`; return; }
  if (!data.length) { box.innerHTML = '<p class="adm-empty">Zatiaľ žiadne dopyty.</p>'; return; }

  box.innerHTML = data.map((d) => `
    <div class="adm-card" style="${d.precitane ? 'opacity:0.55' : ''}">
      <div class="adm-row">
        <div class="nazov">${esc(d.meno)}${d.precitane ? '<span class="off">vybavené</span>' : ''}</div>
        <div class="meta">${fmtDT(d.created_at)}</div>
      </div>
      <div class="meta">${d.telefon ? `Tel: <a href="tel:${esc(d.telefon)}" style="color:var(--text)">${esc(d.telefon)}</a>` : ''}${d.telefon && d.email ? ' · ' : ''}${d.email ? `E-mail: <a href="mailto:${esc(d.email)}" style="color:var(--text)">${esc(d.email)}</a>` : ''}</div>
      <p class="kond-text">${esc(d.sprava)}</p>
      <div class="adm-actions">
        <button type="button" class="adm-btn sm" data-act="zakazka" data-id="${d.id}">Vytvoriť zákazku</button>
        <button type="button" class="adm-btn ghost sm" data-act="precitane" data-id="${d.id}" data-val="${!d.precitane}">${d.precitane ? 'Označiť ako nevybavené' : 'Označiť ako vybavené'}</button>
      </div>
    </div>`).join('');
  $('#dopyt-badge').textContent = data.filter((d) => !d.precitane).length || '';

  box.querySelectorAll('button[data-act]').forEach((btn) => {
    const d = data.find((x) => x.id === btn.dataset.id);
    btn.addEventListener('click', async () => {
      if (btn.dataset.act === 'precitane') {
        await sb.from('dopyty').update({ precitane: btn.dataset.val === 'true' }).eq('id', d.id);
        loadDopyty();
      }
      if (btn.dataset.act === 'zakazka') {
        btn.disabled = true;
        try {
          // dopyt → kontakt + rozpracovaná zákazka
          const kontaktId = uuid();
          const { error: ke } = await sb.from('kontakty').insert({
            id: kontaktId,
            meno: d.meno,
            telefon: d.telefon || null,
            email: d.email || null,
            poznamka: 'Z dopytu na webe: ' + d.sprava.slice(0, 200),
          });
          if (ke) throw new Error(ke.message);
          const id = await vytvorZakazku(sb, {
            cislo: await noveCisloZakazky(sb),
            pobocka: null,
            zosnuly_meno: '',
            datum_umrtia: null,
            objednavatel_id: kontaktId,
            dopyt_id: d.id,
            poznamka: 'Vytvorené z dopytu: ' + d.sprava,
          });
          await sb.from('dopyty').update({ precitane: true }).eq('id', d.id);
          location.href = `/admin/zakazka?id=${id}`;
        } catch (err) {
          alert('Zákazku sa nepodarilo vytvoriť: ' + (err.message || err));
          btn.disabled = false;
        }
      }
    });
  });
}
</script>
</AdminLayout>
