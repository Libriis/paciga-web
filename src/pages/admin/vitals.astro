---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Rýchlosť webu" active="vitals">

  <h1>Rýchlosť webu</h1>
  <p class="kpi-poznamka" style="margin:-6px 0 14px">
    Core Web Vitals namerané skutočným návštevníkom na skutočnej sieti. Nie sú to
    laboratórne testy z Lighthouse. CrUX o tejto doméne dáta nemá, takže toto je
    jediný zdroj, ktorý povie, čo ľudia naozaj zažívajú.
  </p>

  <div class="chips" id="obdobie-chips" style="margin-bottom:10px"></div>
  <div class="chips" id="zariadenie-chips"></div>

  <div id="prazdno" class="adm-card hidden" style="margin-top:14px">
    <p style="margin:0">Zatiaľ žiadne merania za zvolené obdobie.</p>
  </div>

  <div id="obsah">
    <!-- ---- KPI za metriku ---- -->
    <div class="dash-grid" id="kpi" style="margin-top:14px"></div>

    <!-- ---- podľa stránok ---- -->
    <div class="adm-card" style="margin-top:14px">
      <h2 style="margin:0 0 4px">Podľa stránky</h2>
      <p class="kpi-poznamka" style="margin:0 0 12px">
        Zoradené od najpomalšieho LCP. Tu sa hľadá stránka, ktorá ťahá web dole.
      </p>
      <div id="cesty-tbl"></div>
    </div>

    <!-- ---- rozdelenie hodnotení ---- -->
    <div class="adm-card">
      <h2 style="margin:0 0 12px">Rozdelenie hodnotení</h2>
      <div id="rating-list"></div>
    </div>

    <p class="kpi-poznamka" id="pozn-vzorka" style="margin-top:14px"></p>
  </div>

<script>
import { getClient, requireAuth, esc, DEMO } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (s) => document.querySelector(s);

await requireAuth();

/* Prahy Core Web Vitals. Hodnota je hranica „good", druhá hranica „poor";
   medzi nimi je needs-improvement. Merané vždy na 75. percentile. */
const METRIKY = [
  { key: 'LCP', popis: 'Najväčší prvok vykreslený', good: 2500, poor: 4000, jednotka: 'ms' },
  { key: 'INP', popis: 'Odozva na interakciu', good: 200, poor: 500, jednotka: 'ms' },
  { key: 'CLS', popis: 'Poskakovanie rozloženia', good: 0.1, poor: 0.25, jednotka: '' },
  { key: 'FCP', popis: 'Prvé vykreslenie obsahu', good: 1800, poor: 3000, jednotka: 'ms' },
  { key: 'TTFB', popis: 'Odpoveď servera', good: 800, poor: 1800, jednotka: 'ms' },
];

const OBDOBIA = [
  { key: '7', label: 'Posledných 7 dní' },
  { key: '28', label: 'Posledných 28 dní' },
  { key: '90', label: 'Posledných 90 dní' },
];
const ZARIADENIA = [
  { key: '', label: 'Všetky zariadenia' },
  { key: 'mobile', label: 'Mobil' },
  { key: 'desktop', label: 'Desktop' },
];

let obdobie = '28';
let zariadenie = '';
let data = [];

/* p75 je hodnota, na ktorej stoja prahy Core Web Vitals: 3 zo 4 návštevníkov
   to majú rovnako dobré alebo lepšie. Priemer by tu klamal, pomalý chvost
   zážitok kazí a priemer ho rozriedi. */
function percentil(hodnoty, p) {
  if (!hodnoty.length) return null;
  const zoradene = [...hodnoty].sort((a, b) => a - b);
  const idx = (zoradene.length - 1) * p;
  const dolu = Math.floor(idx);
  const hore = Math.ceil(idx);
  if (dolu === hore) return zoradene[dolu];
  return zoradene[dolu] + (zoradene[hore] - zoradene[dolu]) * (idx - dolu);
}

function hodnotenie(metrika, hodnota) {
  if (hodnota === null) return 'ziadne';
  if (hodnota <= metrika.good) return 'good';
  if (hodnota <= metrika.poor) return 'ni';
  return 'poor';
}

const STITOK = { good: 'dobré', ni: 'treba zlepšiť', poor: 'zlé', ziadne: '—' };
const FARBA = { good: '#2f9e77', ni: '#bf7c2c', poor: '#c0504d', ziadne: 'var(--dim)' };

function fmt(metrika, hodnota) {
  if (hodnota === null) return '–';
  if (metrika.key === 'CLS') return hodnota.toFixed(3);
  return Math.round(hodnota).toLocaleString('sk-SK') + ' ms';
}

function chips(el, polozky, aktualna, onChange) {
  el.innerHTML = polozky
    .map((p) => `<button type="button" class="chip${p.key === aktualna ? ' on' : ''}" data-k="${esc(p.key)}">${esc(p.label)}</button>`)
    .join('');
  el.querySelectorAll('.chip').forEach((b) => {
    b.addEventListener('click', () => onChange(b.dataset.k));
  });
}

async function nacitaj() {
  const od = new Date(Date.now() - Number(obdobie) * 86400000).toISOString();
  let q = sb.from('web_vitals').select('*').gte('created_at', od).order('created_at', { ascending: false }).limit(20000);
  if (zariadenie) q = q.eq('zariadenie', zariadenie);
  const { data: d, error } = await q;
  if (error) {
    console.error('[vitals]', error.message);
    return [];
  }
  return d || [];
}

function vykresli() {
  const prazdne = data.length === 0;
  $('#prazdno').classList.toggle('hidden', !prazdne);
  $('#obsah').classList.toggle('hidden', prazdne);
  if (prazdne) return;

  /* ---- KPI za metriku ---- */
  $('#kpi').innerHTML = METRIKY.map((m) => {
    const hodnoty = data.filter((r) => r.metrika === m.key).map((r) => r.hodnota);
    const p75 = percentil(hodnoty, 0.75);
    const h = hodnotenie(m, p75);
    return `<div class="dash-card">
      <div class="dash-num" style="color:${FARBA[h]}">${fmt(m, p75)}</div>
      <div class="dash-label">${m.key} <span style="color:var(--dim)">p75</span></div>
      <div class="kpi-poznamka">${esc(m.popis)}<br>${STITOK[h]} · ${hodnoty.length} vzoriek</div>
    </div>`;
  }).join('');

  /* ---- podľa stránok ---- */
  const cesty = [...new Set(data.map((r) => r.cesta))].map((cesta) => {
    const riadky = data.filter((r) => r.cesta === cesta);
    const zaMetriku = {};
    for (const m of METRIKY) {
      zaMetriku[m.key] = percentil(riadky.filter((r) => r.metrika === m.key).map((r) => r.hodnota), 0.75);
    }
    return { cesta, vzoriek: riadky.length, ...zaMetriku };
  }).sort((a, b) => (b.LCP ?? -1) - (a.LCP ?? -1));

  const bunka = (m, v) => `<td style="color:${FARBA[hodnotenie(m, v)]}">${fmt(m, v)}</td>`;
  $('#cesty-tbl').innerHTML = `<table class="adm-tbl">
    <thead><tr><th>Stránka</th><th>Vzoriek</th>${METRIKY.map((m) => `<th>${m.key} p75</th>`).join('')}</tr></thead>
    <tbody>${cesty.map((c) => `<tr>
      <td><a href="${esc(c.cesta)}" target="_blank" rel="noopener">${esc(c.cesta)}</a></td>
      <td>${c.vzoriek}</td>
      ${METRIKY.map((m) => bunka(m, c[m.key])).join('')}
    </tr>`).join('')}</tbody></table>`;

  /* ---- rozdelenie hodnotení podľa toho, čo poslal prehliadač ---- */
  $('#rating-list').innerHTML = METRIKY.map((m) => {
    const riadky = data.filter((r) => r.metrika === m.key);
    if (!riadky.length) return '';
    const pocet = (r) => riadky.filter((x) => x.rating === r).length;
    const g = pocet('good'), n = pocet('needs-improvement'), p = pocet('poor');
    const spolu = riadky.length;
    const pct = (x) => (100 * x / spolu).toFixed(0);
    return `<div style="margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px">
        <strong>${m.key}</strong><span style="color:var(--dim)">${pct(g)} % dobrých z ${spolu}</span>
      </div>
      <div style="display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--bg2)">
        <div style="width:${pct(g)}%;background:${FARBA.good}" title="dobré: ${g}"></div>
        <div style="width:${pct(n)}%;background:${FARBA.ni}" title="treba zlepšiť: ${n}"></div>
        <div style="width:${pct(p)}%;background:${FARBA.poor}" title="zlé: ${p}"></div>
      </div>
    </div>`;
  }).join('');

  /* ---- poctivá poznámka o vzorke ---- */
  const zariadenia = [...new Set(data.map((r) => r.zariadenie))];
  const maloVzoriek = METRIKY.some((m) => {
    const n = data.filter((r) => r.metrika === m.key).length;
    return n > 0 && n < 100;
  });
  $('#pozn-vzorka').innerHTML = `${data.length} meraní za ${obdobie} dní, zariadenia: ${esc(zariadenia.join(', ') || '—')}.` +
    (maloVzoriek
      ? ' <strong>Vzorka je malá.</strong> Pri menej než sto meraniach na metriku vie p75 skákať o stovky milisekúnd medzi dvomi návštevami. Na rozhodnutia počkaj, kým čísla ustália.'
      : '');
}

async function obnov() {
  data = await nacitaj();
  vykresli();
}

if (DEMO) {
  $('#obsah').classList.add('hidden');
  $('#prazdno').classList.remove('hidden');
  $('#prazdno').innerHTML = '<p style="margin:0"><strong>Telemetria beží len na ostrých dátach.</strong> ' +
    'Merania zbiera nasadený web od skutočných návštevníkov, takže v demo režime nie je čo ukázať. ' +
    'Vymyslené čísla by tu boli horšie než prázdna stránka.</p>';
  $('#obdobie-chips').classList.add('hidden');
  $('#zariadenie-chips').classList.add('hidden');
} else {
  const nastavChips = () => {
    chips($('#obdobie-chips'), OBDOBIA, obdobie, (k) => { obdobie = k; nastavChips(); obnov(); });
    chips($('#zariadenie-chips'), ZARIADENIA, zariadenie, (k) => { zariadenie = k; nastavChips(); obnov(); });
  };
  nastavChips();
  await obnov();
}
</script>
</AdminLayout>
