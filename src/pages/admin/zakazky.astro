---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Zákazky" active="zakazky">

  <div class="adm-head">
    <h1>Zákazky</h1>
    <button type="button" class="adm-btn" id="zakazka-new">+ Nová zákazka</button>
  </div>

  <form id="zakazka-form" class="adm-form hidden">
    <h2 style="margin-top:0">Nová zákazka</h2>
    <label>Meno a priezvisko zosnulého
      <input type="text" name="zosnuly_meno" required maxlength="120" placeholder="napr. Ján Novák">
    </label>
    <div class="adm-radio">
      <label><input type="radio" name="zosnuly_pohlavie" value="zena" checked> žena</label>
      <label><input type="radio" name="zosnuly_pohlavie" value="muz"> muž</label>
    </div>
    <div class="adm-radio" style="margin-top:14px">
      <label><input type="radio" name="typ" value="pochovanie" checked> pochovanie</label>
      <label><input type="radio" name="typ" value="kremacia"> kremácia</label>
    </div>
    <div class="adm-grid3" style="margin-top:18px">
      <label>Dátum narodenia
        <input type="date" name="datum_narodenia">
      </label>
      <label>Dátum úmrtia
        <input type="date" name="datum_umrtia">
      </label>
      <label>Miesto úmrtia
        <input type="text" name="miesto_umrtia" maxlength="200">
      </label>
    </div>
    <div class="adm-grid3">
      <label>Pobočka
        <select name="pobocka">
          <option value="">— vyberte —</option>
        </select>
      </label>
      <label>Zdroj zákazky
        <select name="zdroj">
          <option value="">— neuvedený —</option>
        </select>
      </label>
      <label>Predbežná suma (€)
        <input type="number" name="suma" min="0" step="10">
      </label>
    </div>
    <div class="adm-grid2">
      <label>Vzťah objednávateľa k zosnulému
        <input type="text" name="vztah" maxlength="60" placeholder="napr. dcéra">
      </label>
    </div>
    <label>Objednávateľ
      <select name="objednavatel_id">
        <option value="">+ nový kontakt (vyplňte nižšie)</option>
      </select>
    </label>
    <div class="adm-grid2" id="novy-kontakt-polia">
      <label>Meno nového kontaktu
        <input type="text" name="kontakt_meno" maxlength="120">
      </label>
      <label>Telefón nového kontaktu
        <input type="tel" name="kontakt_telefon" maxlength="40">
      </label>
    </div>
    <label>Poznámka
      <textarea name="poznamka" rows="2" maxlength="2000"></textarea>
    </label>
    <div class="adm-actions">
      <button type="submit" class="adm-btn">Založiť zákazku</button>
      <button type="button" class="adm-btn ghost" id="zakazka-cancel">Zrušiť</button>
    </div>
    <p class="adm-status" id="zakazka-status"></p>
  </form>

  <div class="chips" id="pobocka-chips" style="margin-bottom:10px"></div>
  <div class="chips" id="stav-chips"></div>
  <input type="search" class="adm-search" id="zakazka-hladanie" placeholder="Hľadať podľa mena zosnulého, čísla, miesta…">
  <div id="zakazky-list"><p class="adm-empty">Načítavam…</p></div>

<script>
import { getClient, requireAuth, esc, fmtD, fmtTermin, fmtEUR, STAVY, AKTIVNE_STAVY, POBOCKY, ZDROJE, stavLabel, typLabel, vytvorZakazku, noveCisloZakazky, uuid, pobockaChips } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (sel) => document.querySelector(sel);

await requireAuth();

let filter = 'aktivne';
let hladanie = '';
let zakazky = [];
let ukonyByZakazka = {};
let kontaktyById = {};

const aktualnaPobocka = pobockaChips($('#pobocka-chips'), () => { renderChips(); renderList(); });
$('#zakazka-hladanie').addEventListener('input', (e) => {
  hladanie = e.target.value.toLowerCase().trim();
  renderList();
});

/* ---- formulár novej zákazky ---- */
const form = $('#zakazka-form');
const f = form.elements;
POBOCKY.forEach((p) => f.pobocka.add(new Option(p, p)));
ZDROJE.forEach((z) => f.zdroj.add(new Option(z.label, z.key)));

$('#zakazka-new').addEventListener('click', () => {
  form.reset();
  form.classList.remove('hidden');
  form.scrollIntoView({ behavior: 'smooth' });
});
if (new URLSearchParams(location.search).has('nova')) {
  form.classList.remove('hidden');
  form.scrollIntoView({ behavior: 'smooth' });
}
$('#zakazka-cancel').addEventListener('click', () => form.classList.add('hidden'));
f.objednavatel_id.addEventListener('change', () => {
  $('#novy-kontakt-polia').style.display = f.objednavatel_id.value ? 'none' : '';
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = form.querySelector('button[type="submit"]');
  const status = $('#zakazka-status');
  btn.disabled = true;
  status.textContent = 'Zakladám zákazku…';
  status.classList.remove('err');
  try {
    let objednavatelId = f.objednavatel_id.value || null;
    if (!objednavatelId && f.kontakt_meno.value.trim()) {
      objednavatelId = uuid();
      const { error } = await sb.from('kontakty').insert({
        id: objednavatelId,
        meno: f.kontakt_meno.value.trim(),
        telefon: f.kontakt_telefon.value.trim() || null,
      });
      if (error) throw new Error(error.message);
    }
    const id = await vytvorZakazku(sb, {
      cislo: await noveCisloZakazky(sb),
      pobocka: f.pobocka.value || null,
      typ: f.typ.value,
      zdroj: f.zdroj.value || null,
      suma: f.suma.value ? Number(f.suma.value) : null,
      zosnuly_meno: f.zosnuly_meno.value.trim(),
      zosnuly_pohlavie: f.zosnuly_pohlavie.value,
      datum_narodenia: f.datum_narodenia.value || null,
      datum_umrtia: f.datum_umrtia.value || null,
      miesto_umrtia: f.miesto_umrtia.value.trim() || null,
      objednavatel_id: objednavatelId,
      vztah: f.vztah.value.trim() || null,
      poznamka: f.poznamka.value.trim() || null,
    });
    location.href = `/admin/zakazka?id=${id}`;
  } catch (err) {
    status.textContent = err.message || 'Nepodarilo sa založiť zákazku.';
    status.classList.add('err');
    btn.disabled = false;
  }
});

/* ---- zoznam ---- */

function najblizsiTermin(z) {
  const teraz = new Date().toISOString().slice(0, 16);
  const terminy = [
    [z.termin_vyzdvihnutie, 'vyzdvihnutie'],
    [z.termin_rakva, 'dovoz rakvy'],
    [z.termin_rozlucka, 'rozlúčka'],
  ].filter(([t]) => t && t >= teraz).sort((a, b) => (a[0] < b[0] ? -1 : 1));
  return terminy[0] || null;
}

function podlaPobocky() {
  const p = aktualnaPobocka();
  return p ? zakazky.filter((z) => z.pobocka === p) : zakazky;
}

function renderChips() {
  const zdroj = podlaPobocky();
  const counts = { aktivne: zdroj.filter((z) => AKTIVNE_STAVY.includes(z.stav)).length, vsetky: zdroj.length };
  STAVY.forEach((s) => { counts[s.key] = zdroj.filter((z) => z.stav === s.key).length; });
  const chips = [
    { key: 'aktivne', label: `Aktívne (${counts.aktivne})` },
    ...STAVY.map((s) => ({ key: s.key, label: `${s.label} (${counts[s.key]})` })),
    { key: 'vsetky', label: `Všetky (${counts.vsetky})` },
  ];
  $('#stav-chips').innerHTML = chips.map((c) =>
    `<button type="button" class="chip${filter === c.key ? ' on' : ''}" data-f="${c.key}">${c.label}</button>`).join('');
  document.querySelectorAll('#stav-chips .chip').forEach((ch) => {
    ch.addEventListener('click', () => { filter = ch.dataset.f; renderChips(); renderList(); });
  });
}

function renderList() {
  const box = $('#zakazky-list');
  let rows = podlaPobocky();
  if (filter === 'aktivne') rows = rows.filter((z) => AKTIVNE_STAVY.includes(z.stav));
  else if (filter !== 'vsetky') rows = rows.filter((z) => z.stav === filter);
  if (hladanie) {
    rows = rows.filter((z) => {
      const kontakt = kontaktyById[z.objednavatel_id];
      return [z.zosnuly_meno, z.cislo, z.miesto_umrtia, z.miesto_rozlucky, kontakt?.meno]
        .filter(Boolean).join(' ').toLowerCase().includes(hladanie);
    });
  }
  if (!rows.length) { box.innerHTML = '<p class="adm-empty">Žiadne zákazky v tomto pohľade.</p>'; return; }

  const telo = rows.slice(0, 60).map((z) => {
    const uk = ukonyByZakazka[z.id] || [];
    const hotovo = uk.filter((u) => u.hotovo).length;
    const kontakt = kontaktyById[z.objednavatel_id];
    const termin = najblizsiTermin(z);
    return `
    <tr class="klik" data-id="${esc(z.id)}">
      <td>
        <div class="nazov"><a href="/admin/zakazka?id=${esc(z.id)}">${esc(z.zosnuly_meno || 'Bez mena')}</a></div>
        <div class="sub">${esc(z.cislo || '')}${z.datum_umrtia ? ` · † ${fmtD(z.datum_umrtia)}` : ''} · ${esc(typLabel(z.typ))}${kontakt ? ` · ${esc(kontakt.meno)}` : ''}</div>
      </td>
      <td>${esc(z.pobocka || '—')}</td>
      <td>${termin ? `${termin[1]}<div class="sub">${fmtTermin(termin[0])}</div>` : '—'}</td>
      <td class="num">${z.suma ? fmtEUR(z.suma) : '—'}</td>
      <td><div class="mini-progress"><div class="progress"><i style="width:${uk.length ? Math.round((hotovo / uk.length) * 100) : 0}%"></i></div><span>${hotovo}/${uk.length}</span></div></td>
      <td><span class="stav-badge stav-${esc(z.stav)}">${esc(stavLabel(z.stav))}</span></td>
    </tr>`;
  }).join('');

  box.innerHTML = `
    <div class="adm-tablewrap">
      <table class="adm-tbl">
        <thead><tr><th>Zosnulý</th><th>Pobočka</th><th>Najbližší termín</th><th class="num">Suma</th><th>Kroky</th><th>Stav</th></tr></thead>
        <tbody>${telo}</tbody>
      </table>
    </div>` + (rows.length > 60 ? `<p class="adm-empty">…a ďalších ${rows.length - 60}. Použi vyhľadávanie alebo filtre.</p>` : '');

  box.querySelectorAll('tr.klik').forEach((tr) => {
    tr.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;
      location.href = `/admin/zakazka?id=${tr.dataset.id}`;
    });
  });
}

async function load() {
  const [zRes, uRes, kRes] = await Promise.all([
    sb.from('zakazky').select('*').order('created_at', { ascending: false }),
    sb.from('ukony').select('*'),
    sb.from('kontakty').select('*').order('meno'),
  ]);
  zakazky = zRes.data || [];
  ukonyByZakazka = {};
  (uRes.data || []).forEach((u) => { (ukonyByZakazka[u.zakazka_id] ??= []).push(u); });
  kontaktyById = {};
  (kRes.data || []).forEach((k) => { kontaktyById[k.id] = k; });

  // select objednávateľa vo formulári
  while (f.objednavatel_id.options.length > 1) f.objednavatel_id.remove(1);
  (kRes.data || []).forEach((k) => f.objednavatel_id.add(new Option(`${k.meno}${k.telefon ? ' · ' + k.telefon : ''}`, k.id)));

  renderChips();
  renderList();
}
load();
</script>
</AdminLayout>
