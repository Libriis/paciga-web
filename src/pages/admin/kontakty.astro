---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Kontakty">

  <div class="adm-head">
    <h1>Kontakty</h1>
    <button type="button" class="adm-btn" id="kontakt-new">+ Nový kontakt</button>
  </div>

  <form id="kontakt-form" class="adm-form hidden">
    <h2 style="margin-top:0" id="kontakt-form-title">Nový kontakt</h2>
    <input type="hidden" name="id">
    <label>Meno a priezvisko
      <input type="text" name="meno" required maxlength="120">
    </label>
    <div class="adm-grid2">
      <label>Telefón
        <input type="tel" name="telefon" maxlength="40">
      </label>
      <label>E-mail
        <input type="email" name="email" maxlength="200">
      </label>
    </div>
    <label>Adresa
      <input type="text" name="adresa" maxlength="300">
    </label>
    <label>Poznámka
      <textarea name="poznamka" rows="2" maxlength="2000"></textarea>
    </label>
    <div class="adm-actions">
      <button type="submit" class="adm-btn">Uložiť kontakt</button>
      <button type="button" class="adm-btn ghost" id="kontakt-cancel">Zrušiť</button>
    </div>
    <p class="adm-status" id="kontakt-status"></p>
  </form>

  <input type="search" class="adm-search" id="kontakt-hladanie" placeholder="Hľadať podľa mena, telefónu, e-mailu…">
  <div id="kontakty-list"><p class="adm-empty">Načítavam…</p></div>

<script>
import { getClient, requireAuth, esc, fmtD, stavLabel, uuid } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (sel) => document.querySelector(sel);

await requireAuth('kontakty');

let kontakty = [];
let zakazkyByKontakt = {};
let hladanie = '';
const oznaceny = new URLSearchParams(location.search).get('id');

const form = $('#kontakt-form');
const f = form.elements;

$('#kontakt-new').addEventListener('click', () => {
  form.reset();
  f.id.value = '';
  $('#kontakt-form-title').textContent = 'Nový kontakt';
  form.classList.remove('hidden');
  form.scrollIntoView({ behavior: 'smooth' });
});
$('#kontakt-cancel').addEventListener('click', () => form.classList.add('hidden'));

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = form.querySelector('button[type="submit"]');
  const status = $('#kontakt-status');
  btn.disabled = true;
  status.textContent = 'Ukladám…';
  status.classList.remove('err');
  const zaznam = {
    meno: f.meno.value.trim(),
    telefon: f.telefon.value.trim() || null,
    email: f.email.value.trim() || null,
    adresa: f.adresa.value.trim() || null,
    poznamka: f.poznamka.value.trim() || null,
  };
  const res = f.id.value
    ? await sb.from('kontakty').update(zaznam).eq('id', f.id.value)
    : await sb.from('kontakty').insert({ id: uuid(), ...zaznam });
  if (res.error) {
    status.textContent = 'Chyba: ' + res.error.message;
    status.classList.add('err');
  } else {
    form.classList.add('hidden');
    status.textContent = '';
    load();
  }
  btn.disabled = false;
});

$('#kontakt-hladanie').addEventListener('input', (e) => {
  hladanie = e.target.value.toLowerCase().trim();
  render();
});

function render() {
  const box = $('#kontakty-list');
  let rows = kontakty;
  if (hladanie) {
    rows = kontakty.filter((k) =>
      [k.meno, k.telefon, k.email, k.adresa, k.poznamka].filter(Boolean).join(' ').toLowerCase().includes(hladanie));
  }
  if (!rows.length) { box.innerHTML = '<p class="adm-empty">Žiadne kontakty.</p>'; return; }

  const telo = rows.map((k) => {
    const zakazky = zakazkyByKontakt[k.id] || [];
    return `
    <tr id="kontakt-${esc(k.id)}"${k.id === oznaceny ? ' class="oznac"' : ''}>
      <td>
        <div class="nazov">${esc(k.meno)}</div>
        ${k.adresa ? `<div class="sub">${esc(k.adresa)}</div>` : ''}
        ${k.poznamka ? `<div class="sub">${esc(k.poznamka)}</div>` : ''}
      </td>
      <td>${k.telefon ? `<a href="tel:${esc(k.telefon)}" style="color:var(--text)">${esc(k.telefon)}</a>` : '—'}</td>
      <td>${k.email ? `<a href="mailto:${esc(k.email)}" style="color:var(--text)">${esc(k.email)}</a>` : '—'}</td>
      <td>${zakazky.length ? zakazky.map((z) =>
        `<a href="/admin/zakazka?id=${esc(z.id)}" style="color:var(--gold-soft);font-size:13px">${esc(z.cislo || 'zákazka')} · ${esc(z.zosnuly_meno || 'bez mena')} (${esc(stavLabel(z.stav))})</a>`).join('<br>') : '—'}</td>
      <td>
        <div class="adm-actions" style="flex-wrap:nowrap;justify-content:flex-end">
          <button type="button" class="adm-btn ghost sm" data-act="edit" data-id="${esc(k.id)}">Upraviť</button>
          <button type="button" class="adm-btn danger sm" data-act="del" data-id="${esc(k.id)}">Vymazať</button>
        </div>
      </td>
    </tr>`;
  }).join('');

  box.innerHTML = `
    <div class="adm-tablewrap">
      <table class="adm-tbl">
        <thead><tr><th>Meno</th><th>Telefón</th><th>E-mail</th><th>Zákazky</th><th></th></tr></thead>
        <tbody>${telo}</tbody>
      </table>
    </div>`;

  box.querySelectorAll('button[data-act]').forEach((btn) => {
    const k = kontakty.find((x) => x.id === btn.dataset.id);
    btn.addEventListener('click', async () => {
      if (btn.dataset.act === 'edit') {
        form.reset();
        f.id.value = k.id;
        f.meno.value = k.meno;
        f.telefon.value = k.telefon ?? '';
        f.email.value = k.email ?? '';
        f.adresa.value = k.adresa ?? '';
        f.poznamka.value = k.poznamka ?? '';
        $('#kontakt-form-title').textContent = `Upraviť: ${k.meno}`;
        form.classList.remove('hidden');
        form.scrollIntoView({ behavior: 'smooth' });
      }
      if (btn.dataset.act === 'del') {
        const pocet = (zakazkyByKontakt[k.id] || []).length;
        if (!confirm(`Naozaj vymazať kontakt „${k.meno}"?${pocet ? ` Je objednávateľom ${pocet} zákaziek — tie ostanú bez kontaktu.` : ''}`)) return;
        await sb.from('kontakty').delete().eq('id', k.id);
        load();
      }
    });
  });

  if (oznaceny) document.getElementById(`kontakt-${oznaceny}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

async function load() {
  const [kRes, zRes] = await Promise.all([
    sb.from('kontakty').select('*').order('meno'),
    sb.from('zakazky').select('*'),
  ]);
  kontakty = kRes.data || [];
  zakazkyByKontakt = {};
  (zRes.data || []).forEach((z) => {
    if (z.objednavatel_id) (zakazkyByKontakt[z.objednavatel_id] ??= []).push(z);
  });
  render();
}
load();
</script>
</AdminLayout>
