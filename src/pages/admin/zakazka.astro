---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Zákazka" active="zakazky">

  <div id="nenajdene" class="hidden">
    <h1>Zákazka sa nenašla</h1>
    <a class="adm-btn ghost" href="/admin/zakazky">← Späť na zákazky</a>
  </div>

  <div id="obsah" class="hidden">
    <a href="/admin/zakazky" style="font-size:13.5px;color:var(--dim)">← Všetky zákazky</a>

    <div class="adm-head" style="margin-top:14px">
      <div>
        <h1 id="z-nadpis" style="margin-bottom:6px"></h1>
        <div class="meta" id="z-meta" style="font-size:13.5px;color:var(--muted)"></div>
      </div>
      <div class="adm-actions">
        <select id="z-stav" class="adm-btn ghost" style="font-weight:600"></select>
      </div>
    </div>

    <!-- ---- CHECKLIST ---- -->
    <div class="adm-card">
      <h2 style="margin:0 0 4px">Postup vybavenia</h2>
      <div class="progress"><i id="chk-bar" style="width:0%"></i></div>
      <div class="progress-label" id="chk-label"></div>
      <ul class="chk" id="chk-list"></ul>
    </div>

    <div class="adm-grid2" style="gap:14px;align-items:start">
      <!-- ---- ZOSNULÝ ---- -->
      <form class="adm-form" id="form-zosnuly" style="margin-bottom:14px">
        <h2 style="margin-top:0">Zosnulý</h2>
        <label>Meno a priezvisko
          <input type="text" name="zosnuly_meno" maxlength="120" required>
        </label>
        <div class="adm-radio" style="margin-bottom:18px">
          <label><input type="radio" name="zosnuly_pohlavie" value="zena"> žena</label>
          <label><input type="radio" name="zosnuly_pohlavie" value="muz"> muž</label>
        </div>
        <div class="adm-grid2">
          <label>Dátum narodenia
            <input type="date" name="datum_narodenia">
          </label>
          <label>Dátum úmrtia
            <input type="date" name="datum_umrtia">
          </label>
        </div>
        <label>Miesto úmrtia
          <input type="text" name="miesto_umrtia" maxlength="200">
        </label>
        <button type="submit" class="adm-btn sm">Uložiť</button>
        <p class="adm-status"></p>
      </form>

      <!-- ---- OBJEDNÁVATEĽ ---- -->
      <form class="adm-form" id="form-objednavatel" style="margin-bottom:14px">
        <h2 style="margin-top:0">Objednávateľ</h2>
        <label>Kontakt
          <select name="objednavatel_id">
            <option value="">— nevybraný —</option>
          </select>
        </label>
        <div class="meta" id="objednavatel-info" style="font-size:13.5px;color:var(--muted);margin:-8px 0 16px"></div>
        <label>Vzťah k zosnulému
          <input type="text" name="vztah" maxlength="60" placeholder="napr. dcéra">
        </label>
        <button type="submit" class="adm-btn sm">Uložiť</button>
        <p class="adm-status"></p>
      </form>
    </div>

    <!-- ---- PARAMETRE ZÁKAZKY ---- -->
    <form class="adm-form" id="form-parametre">
      <h2 style="margin-top:0">Parametre zákazky</h2>
      <div class="adm-radio" style="margin-bottom:18px">
        <label><input type="radio" name="typ" value="pochovanie"> pochovanie</label>
        <label><input type="radio" name="typ" value="kremacia"> kremácia</label>
      </div>
      <div class="adm-grid2">
        <label>Zdroj zákazky
          <select name="zdroj">
            <option value="">— neuvedený —</option>
          </select>
        </label>
        <label>Suma zákazky (€)
          <input type="number" name="suma" min="0" step="10">
        </label>
      </div>
      <button type="submit" class="adm-btn sm">Uložiť</button>
      <p class="adm-status"></p>
    </form>

    <!-- ---- TERMÍNY ---- -->
    <form class="adm-form" id="form-terminy">
      <h2 style="margin-top:0">Termíny</h2>
      <div class="adm-grid3">
        <label>Vyzdvihnutie zosnulého
          <input type="datetime-local" name="termin_vyzdvihnutie">
        </label>
        <label>Dovoz rakvy
          <input type="datetime-local" name="termin_rakva">
        </label>
        <label>Posledná rozlúčka
          <input type="datetime-local" name="termin_rozlucka">
        </label>
      </div>
      <label>Miesto rozlúčky
        <input type="text" name="miesto_rozlucky" maxlength="200" placeholder="napr. Dom smútku v Poprade">
      </label>
      <div class="adm-grid2">
        <label>Pobočka
          <select name="pobocka">
            <option value="">— vyberte —</option>
          </select>
        </label>
      </div>
      <button type="submit" class="adm-btn sm">Uložiť termíny</button>
      <p class="adm-status"></p>
    </form>

    <!-- ---- DOKUMENTY ---- -->
    <div class="adm-card">
      <h2 style="margin:0 0 6px">Dokumenty</h2>
      <p class="meta" style="font-size:13.5px;color:var(--muted);margin-bottom:16px">Odfoť alebo naskenuj doklady — uložia sa bezpečne k zákazke.</p>
      <form id="form-dokument" class="adm-actions" style="margin-bottom:6px">
        <select name="typ" class="adm-btn ghost sm" style="font-weight:600"></select>
        <label class="adm-btn ghost sm" style="cursor:pointer;margin:0">Vybrať fotku / scan
          <input type="file" name="subor" accept="image/*" class="hidden">
        </label>
        <button type="submit" class="adm-btn sm">Nahrať</button>
      </form>
      <p class="adm-status" id="dok-status"></p>
      <div class="dok-grid" id="dok-grid"></div>
    </div>

    <!-- ---- PARTE ---- -->
    <div class="adm-card">
      <h2 style="margin:0 0 6px">Parte na webe</h2>
      <div id="parte-box"></div>
      <p class="adm-status" id="parte-status"></p>
    </div>

    <!-- ---- POZNÁMKA ---- -->
    <form class="adm-form" id="form-poznamka">
      <h2 style="margin-top:0">Poznámka</h2>
      <label style="text-transform:none;letter-spacing:normal">
        <textarea name="poznamka" rows="3" maxlength="4000"></textarea>
      </label>
      <button type="submit" class="adm-btn sm">Uložiť poznámku</button>
      <p class="adm-status"></p>
    </form>

    <div class="adm-actions" style="margin-top:30px">
      <button type="button" class="adm-btn danger" id="z-vymazat">Vymazať zákazku</button>
    </div>
  </div>

<script>
import { getClient, requireAuth, esc, fmtD, fmtDT, STAVY, POBOCKY, ZDROJE, DOKUMENT_TYPY, dokumentTypLabel, zmensiFotku, dokumentUrl, uuid } from '../../scripts/admin-core.js';

const sb = getClient();
const $ = (sel) => document.querySelector(sel);

await requireAuth();

const id = new URLSearchParams(location.search).get('id');
let z = null;
let kontakty = [];

if (!id) {
  $('#nenajdene').classList.remove('hidden');
} else {
  const { data } = await sb.from('zakazky').select('*').eq('id', id).maybeSingle();
  z = data;
  if (!z) {
    $('#nenajdene').classList.remove('hidden');
  } else {
    const { data: kData } = await sb.from('kontakty').select('*').order('meno');
    kontakty = kData || [];
    $('#obsah').classList.remove('hidden');
    initHlavicka();
    initZosnuly();
    initObjednavatel();
    initParametre();
    initTerminy();
    initChecklist();
    initDokumenty();
    initParte();
    initPoznamka();
    initVymazanie();
  }
}

/* pomôcka: napojí formulár na uloženie stĺpcov do zákazky */
function napojUlozenie(formEl, zber, poUlozeni) {
  formEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = formEl.querySelector('button[type="submit"]');
    const status = formEl.querySelector('.adm-status');
    btn.disabled = true;
    status.textContent = 'Ukladám…';
    status.classList.remove('err');
    const zmeny = zber(formEl.elements);
    const { error } = await sb.from('zakazky').update(zmeny).eq('id', z.id);
    if (error) {
      status.textContent = 'Chyba: ' + error.message;
      status.classList.add('err');
    } else {
      Object.assign(z, zmeny);
      status.textContent = 'Uložené.';
      setTimeout(() => { if (status.textContent === 'Uložené.') status.textContent = ''; }, 2500);
      if (poUlozeni) poUlozeni();
    }
    btn.disabled = false;
  });
}

/* ---- hlavička ---- */
function initHlavicka() {
  const obnov = () => {
    $('#z-nadpis').textContent = z.zosnuly_meno || 'Bez mena';
    $('#z-meta').textContent = [z.cislo, z.datum_umrtia ? `† ${fmtD(z.datum_umrtia)}` : null, z.pobocka, `založená ${fmtDT(z.created_at)}`].filter(Boolean).join(' · ');
  };
  obnov();
  window.__obnovHlavicku = obnov;

  const sel = $('#z-stav');
  STAVY.forEach((s) => sel.add(new Option(s.label, s.key)));
  sel.value = z.stav;
  sel.addEventListener('change', async () => {
    await sb.from('zakazky').update({ stav: sel.value }).eq('id', z.id);
    z.stav = sel.value;
  });
}

/* ---- zosnulý ---- */
function initZosnuly() {
  const f = document.getElementById('form-zosnuly').elements;
  f.zosnuly_meno.value = z.zosnuly_meno || '';
  f.zosnuly_pohlavie.value = z.zosnuly_pohlavie || 'zena';
  f.datum_narodenia.value = z.datum_narodenia || '';
  f.datum_umrtia.value = z.datum_umrtia || '';
  f.miesto_umrtia.value = z.miesto_umrtia || '';
  napojUlozenie($('#form-zosnuly'), (f2) => ({
    zosnuly_meno: f2.zosnuly_meno.value.trim(),
    zosnuly_pohlavie: f2.zosnuly_pohlavie.value,
    datum_narodenia: f2.datum_narodenia.value || null,
    datum_umrtia: f2.datum_umrtia.value || null,
    miesto_umrtia: f2.miesto_umrtia.value.trim() || null,
  }), () => window.__obnovHlavicku());
}

/* ---- objednávateľ ---- */
function initObjednavatel() {
  const f = document.getElementById('form-objednavatel').elements;
  kontakty.forEach((k) => f.objednavatel_id.add(new Option(`${k.meno}${k.telefon ? ' · ' + k.telefon : ''}`, k.id)));
  f.objednavatel_id.value = z.objednavatel_id || '';
  f.vztah.value = z.vztah || '';
  const info = () => {
    const k = kontakty.find((x) => x.id === f.objednavatel_id.value);
    $('#objednavatel-info').innerHTML = k
      ? `${k.telefon ? `<a href="tel:${esc(k.telefon)}" style="color:var(--text)">${esc(k.telefon)}</a> · ` : ''}${k.email ? esc(k.email) + ' · ' : ''}<a href="/admin/kontakty?id=${esc(k.id)}" style="color:var(--gold-soft)">detail kontaktu →</a>`
      : '';
  };
  info();
  f.objednavatel_id.addEventListener('change', info);
  napojUlozenie($('#form-objednavatel'), (f2) => ({
    objednavatel_id: f2.objednavatel_id.value || null,
    vztah: f2.vztah.value.trim() || null,
  }));
}

/* ---- parametre (typ, zdroj, suma) ---- */
function initParametre() {
  const f = document.getElementById('form-parametre').elements;
  ZDROJE.forEach((zd) => f.zdroj.add(new Option(zd.label, zd.key)));
  f.typ.value = z.typ || 'pochovanie';
  f.zdroj.value = z.zdroj || '';
  f.suma.value = z.suma ?? '';
  napojUlozenie($('#form-parametre'), (f2) => ({
    typ: f2.typ.value,
    zdroj: f2.zdroj.value || null,
    suma: f2.suma.value ? Number(f2.suma.value) : null,
  }));
}

/* ---- termíny ---- */
function initTerminy() {
  const f = document.getElementById('form-terminy').elements;
  POBOCKY.forEach((p) => f.pobocka.add(new Option(p, p)));
  f.termin_vyzdvihnutie.value = z.termin_vyzdvihnutie || '';
  f.termin_rakva.value = z.termin_rakva || '';
  f.termin_rozlucka.value = z.termin_rozlucka || '';
  f.miesto_rozlucky.value = z.miesto_rozlucky || '';
  f.pobocka.value = z.pobocka || '';
  napojUlozenie($('#form-terminy'), (f2) => ({
    termin_vyzdvihnutie: f2.termin_vyzdvihnutie.value || null,
    termin_rakva: f2.termin_rakva.value || null,
    termin_rozlucka: f2.termin_rozlucka.value || null,
    miesto_rozlucky: f2.miesto_rozlucky.value.trim() || null,
    pobocka: f2.pobocka.value || null,
  }), () => window.__obnovHlavicku());
}

/* ---- checklist ---- */
async function initChecklist() {
  const { data } = await sb.from('ukony').select('*').eq('zakazka_id', z.id).order('poradie');
  const ukony = data || [];
  const list = $('#chk-list');

  const obnovProgress = () => {
    const hotovo = ukony.filter((u) => u.hotovo).length;
    $('#chk-bar').style.width = ukony.length ? `${Math.round((hotovo / ukony.length) * 100)}%` : '0%';
    $('#chk-label').textContent = `${hotovo} z ${ukony.length} krokov hotových`;
  };

  list.innerHTML = ukony.map((u) => `
    <li>
      <input type="checkbox" id="uk-${esc(u.id)}" ${u.hotovo ? 'checked' : ''}>
      <label for="uk-${esc(u.id)}" class="${u.hotovo ? 'hotovo' : ''}" style="cursor:pointer">${esc(u.nazov)}</label>
    </li>`).join('');

  ukony.forEach((u) => {
    const chk = document.getElementById(`uk-${u.id}`);
    chk.addEventListener('change', async () => {
      u.hotovo = chk.checked;
      chk.nextElementSibling.classList.toggle('hotovo', u.hotovo);
      obnovProgress();
      await sb.from('ukony').update({ hotovo: u.hotovo }).eq('id', u.id);
    });
  });
  obnovProgress();
}

/* ---- dokumenty ---- */
function initDokumenty() {
  const form = document.getElementById('form-dokument');
  const f = form.elements;
  DOKUMENT_TYPY.forEach(([key, label]) => f.typ.add(new Option(label, key)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = $('#dok-status');
    const file = f.subor.files[0];
    if (!file) { status.textContent = 'Najprv vyber fotku alebo scan.'; status.classList.add('err'); return; }
    status.classList.remove('err');
    status.textContent = 'Nahrávam…';
    try {
      const blob = await zmensiFotku(file, 1400);
      const cesta = `${z.id}/${Date.now()}.webp`;
      const { error: upErr } = await sb.storage.from('dokumenty').upload(cesta, blob, { contentType: 'image/webp' });
      if (upErr) throw new Error(upErr.message);
      const { error } = await sb.from('dokumenty').insert({
        id: uuid(),
        zakazka_id: z.id,
        typ: f.typ.value,
        nazov: `${dokumentTypLabel(f.typ.value)} — ${z.zosnuly_meno || z.cislo}`,
        storage_path: cesta,
      });
      if (error) throw new Error(error.message);
      form.reset();
      status.textContent = '';
      loadDokumenty();
    } catch (err) {
      status.textContent = 'Nepodarilo sa nahrať: ' + (err.message || err);
      status.classList.add('err');
    }
  });

  loadDokumenty();
}

async function loadDokumenty() {
  const { data } = await sb.from('dokumenty').select('*').eq('zakazka_id', z.id).order('created_at', { ascending: false });
  const doky = data || [];
  const grid = $('#dok-grid');
  if (!doky.length) { grid.innerHTML = '<p class="adm-empty" style="grid-column:1/-1;padding:10px 0">Zatiaľ žiadne dokumenty.</p>'; return; }

  const urls = await Promise.all(doky.map((d) => dokumentUrl(sb, d.storage_path)));
  grid.innerHTML = doky.map((d, i) => `
    <div class="dok-card">
      <a class="nahlad" href="${esc(urls[i])}" target="_blank" rel="noopener"><img src="${esc(urls[i])}" alt="" loading="lazy"></a>
      <div class="dok-info">
        <div class="dok-typ">${esc(dokumentTypLabel(d.typ))}</div>
        <div class="dok-nazov">${fmtDT(d.created_at)}</div>
      </div>
      <div class="dok-akcie"><button type="button" class="adm-btn danger sm" data-id="${esc(d.id)}" data-path="${esc(d.storage_path)}">Vymazať</button></div>
    </div>`).join('');

  grid.querySelectorAll('button[data-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Naozaj vymazať tento dokument?')) return;
      await sb.storage.from('dokumenty').remove([btn.dataset.path]);
      await sb.from('dokumenty').delete().eq('id', btn.dataset.id);
      loadDokumenty();
    });
  });
}

/* ---- parte ---- */
function slugify(s) {
  return s.normalize('NFD').replace(/[̀-ͯ]/g, '')
    .toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
}

async function initParte() {
  const box = $('#parte-box');

  if (z.parte_id) {
    const { data: p } = await sb.from('parte').select('*').eq('id', z.parte_id).maybeSingle();
    if (p) {
      box.innerHTML = `
        <div class="adm-row">
          <div>
            <div class="nazov">${esc(p.meno)}${p.published ? '' : '<span class="off">skryté</span>'}</div>
            <div class="meta">${p.published ? 'Zverejnené na webe.' : 'Zatiaľ skryté — zverejniť ho vieš v sekcii Web a parte.'}</div>
          </div>
          <div class="adm-actions">
            <a class="adm-btn ghost sm" href="/parte/${esc(p.slug)}" target="_blank" rel="noopener">Zobraziť parte</a>
            <a class="adm-btn ghost sm" href="/admin/web">Upraviť v správe webu</a>
          </div>
        </div>`;
      return;
    }
  }

  const chyba = [];
  if (!z.zosnuly_meno) chyba.push('meno zosnulého');
  if (!z.datum_umrtia) chyba.push('dátum úmrtia');
  box.innerHTML = `
    <p class="meta" style="font-size:13.5px;color:var(--muted);margin-bottom:14px">${chyba.length
      ? 'Na vytvorenie parte doplň: ' + chyba.join(', ') + '.'
      : 'Z údajov zákazky sa vytvorí parte. Zverejníš ho potom v sekcii Web a parte.'}</p>
    <button type="button" class="adm-btn sm" id="parte-vytvorit" ${chyba.length ? 'disabled style="opacity:.5;cursor:not-allowed"' : ''}>Vytvoriť parte z tejto zákazky</button>`;

  const btn = document.getElementById('parte-vytvorit');
  if (chyba.length) return;
  btn.addEventListener('click', async () => {
    const status = $('#parte-status');
    btn.disabled = true;
    status.textContent = 'Vytváram parte…';
    status.classList.remove('err');
    try {
      // voľný slug
      let slug = slugify(z.zosnuly_meno);
      for (let i = 2; i < 20; i++) {
        const { data: exist } = await sb.from('parte').select('id').eq('slug', slug).maybeSingle();
        if (!exist) break;
        slug = `${slugify(z.zosnuly_meno)}-${i}`;
      }
      let vek = null;
      if (z.datum_narodenia && z.datum_umrtia) {
        const n = new Date(z.datum_narodenia), u = new Date(z.datum_umrtia);
        vek = u.getFullYear() - n.getFullYear();
        if (u.getMonth() < n.getMonth() || (u.getMonth() === n.getMonth() && u.getDate() < n.getDate())) vek--;
      }
      const parteId = uuid();
      const [rd, rc] = (z.termin_rozlucka || 'T').split('T');
      const { error } = await sb.from('parte').insert({
        id: parteId,
        slug,
        meno: z.zosnuly_meno,
        pohlavie: z.zosnuly_pohlavie || 'zena',
        datum_narodenia: z.datum_narodenia,
        datum_umrtia: z.datum_umrtia,
        vek,
        rozlucka_datum: rd || null,
        rozlucka_cas: rc || null,
        rozlucka_miesto: z.miesto_rozlucky || null,
        published: false,
      });
      if (error) throw new Error(error.message);
      await sb.from('zakazky').update({ parte_id: parteId }).eq('id', z.id);
      z.parte_id = parteId;
      status.textContent = '';
      initParte();
    } catch (err) {
      status.textContent = 'Nepodarilo sa vytvoriť parte: ' + (err.message || err);
      status.classList.add('err');
      btn.disabled = false;
    }
  });
}

/* ---- poznámka ---- */
function initPoznamka() {
  document.getElementById('form-poznamka').elements.poznamka.value = z.poznamka || '';
  napojUlozenie($('#form-poznamka'), (f2) => ({ poznamka: f2.poznamka.value.trim() || null }));
}

/* ---- vymazanie ---- */
function initVymazanie() {
  $('#z-vymazat').addEventListener('click', async () => {
    if (!confirm(`Naozaj vymazať zákazku ${z.cislo || ''} (${z.zosnuly_meno || 'bez mena'})? Vymaže sa aj checklist a dokumenty. Parte na webe ostane.`)) return;
    await sb.from('zakazky').delete().eq('id', z.id);
    location.href = '/admin/zakazky';
  });
}
</script>
</AdminLayout>
