---
import Base from '../layouts/Base.astro';

const title = "Kontakt | Paciga, pohrebné a kamenárske služby";
const description = "Kontakt na pohrebnú službu Paciga. NON STOP 0903 596 364 a 0948 110 109. Pobočky Poprad, Spišská Belá a Liptovský Mikuláš.";
const ogTitle = "Kontakt | Paciga";
const ogDescription = "Sme tu. Kedykoľvek. NON STOP prevoz zosnulých, tri pobočky pod Tatrami.";
---
<Base title={title} description={description} active="kontakt" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/o-nas-tim.jpg">



  <!-- ============ KONTAKT: TELEFÓNY A FORMULÁR VEDĽA SEBA ============
       Prvé dve sekcie stránky stoja vedľa seba, aby sa obe zmestili na
       prvú obrazovku: vľavo telefóny, vpravo formulár. Pobočky a
       fakturačné údaje ostávajú pod tým, tie sa doscrollujú. -->
  <section class="contact-top">
    <div class="container ct-grid">
      <div class="ct-left">
        <div class="eyebrow" data-reveal>Kontakt</div>
        <h1 data-textreveal>Sme tu.<br>Kedykoľvek.</h1>
        <p class="ct-lead" data-reveal>Prevoz zosnulých zabezpečujeme NON STOP, každý deň v roku. Zavolajte a o všetko ostatné sa postaráme.</p>

        <div class="contact-phones">
          <div data-reveal>
            <div class="cp-label">Marek Paciga · NON STOP</div>
            <a class="cp-num" href="tel:0903596364">0903 596 364</a>
          </div>
          <div data-reveal>
            <div class="cp-label">Služba · NON STOP</div>
            <a class="cp-num" href="tel:0948110109">0948 110 109</a>
          </div>
        </div>
        <a class="contact-mail" href="mailto:paciga@paciga.sk" data-reveal>paciga@paciga.sk</a>
      </div>

      <div class="ct-right">
        <div class="ct-form-panel" data-reveal>
          <h2 class="ct-form-title">Napíšte nám</h2>
          <p class="ct-form-lead">Ak vám je ťažko telefonovať, napíšte nám. Ozveme sa vám čo najskôr a všetko vybavíme za vás.</p>
          <form id="kontakt-form" class="contact-form">
            <label>Vaše meno
              <input type="text" name="meno" maxlength="120" required autocomplete="name">
            </label>
            <div class="contact-form-row">
              <label>Telefón
                <input type="tel" name="telefon" maxlength="40" autocomplete="tel">
              </label>
              <label>E-mail
                <input type="email" name="email" maxlength="200" autocomplete="email">
              </label>
            </div>
            <label>Vaša správa
              <textarea name="sprava" rows="4" maxlength="4000" required></textarea>
            </label>
            <input type="text" name="web" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button type="submit" class="btn-gold">Odoslať správu</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ POBOČKY ============ -->
  <section class="branches">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Tri pobočky, jedna rodina</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <!-- Reálne údaje od klienta (3. 8. 2026). Veľké číslo na karte je
           NON STOP linka, tá je na všetkých troch pobočkách rovnaká.
           Druhé číslo je prevádzka a platí v otváracích hodinách.
           Spišská Belá má len jedno číslo, slúži na oboje.
           Navigácia vedie na pobočku (firemný záznam na mape), nie na
           adresu ulice. -->
      <div class="branch-grid">
        <article class="branch-card" data-reveal>
          <div class="branch-photo" data-parallax><span><video class="scene-video" src="/assets/town-poprad.mp4" data-poster="/assets/poster-poprad.webp" muted loop playsinline preload="none" aria-hidden="true"></video></span></div>
          <div class="branch-body">
            <h3>Poprad</h3>
            <p class="branch-addr">Francisciho 3288/35<br>058 01 Poprad</p>
            <a class="branch-tel" href="tel:0903596364">0903 596 364</a>
            <p class="branch-hours">NON STOP · 24/7</p>
            <p class="branch-mail"><a href="mailto:pacigapp@gmail.com">pacigapp@gmail.com</a></p>
            <p class="branch-hours">Prevádzka: <a class="branch-tel-sm" href="tel:0949011012">0949 011 012</a><br>Po až Pi 8:00 až 16:00</p>
            {/* Odkaz je zámerne posledný v zozname. Na mobile má .gold-link
                inline-flex kvôli 44 px dotyku, takže sa za ním dá zalomiť
                a čiarka by inak padla na začiatok ďalšieho riadka. */}
            <p class="branch-hours">Showroom: rakvy, urny, vence, kamenárstvo aj <a href="/sperky" class="gold-link">šperky</a></p>
            <a class="btn-line sm" href="https://www.google.com/maps/search/?api=1&query=Pohrebn%C3%A9%20a%20kamen%C3%A1rske%20slu%C5%BEby%20Paciga%20Poprad" target="_blank" rel="noopener">Navigovať na pobočku →</a>
          </div>
        </article>
        <article class="branch-card" data-reveal>
          <div class="branch-photo" data-parallax><span><video class="scene-video" src="/assets/town-bela.mp4" data-poster="/assets/poster-bela.webp" muted loop playsinline preload="none" aria-hidden="true"></video></span></div>
          <div class="branch-body">
            <h3>Spišská Belá</h3>
            <p class="branch-addr">Letná 17<br>059 01 Spišská Belá</p>
            <a class="branch-tel" href="tel:0903596364">0903 596 364</a>
            <p class="branch-hours">NON STOP aj prevádzka · 24/7</p>
            <p class="branch-mail"><a href="mailto:info.paciga@gmail.com">info.paciga@gmail.com</a></p>
            <p class="branch-hours">Sídlo firmy<br>Po až Pi 8:00 až 16:00</p>
            <a class="btn-line sm" href="https://www.google.com/maps/search/?api=1&query=Pohrebn%C3%A9%20a%20kamen%C3%A1rske%20slu%C5%BEby%20Paciga%20Spi%C5%A1sk%C3%A1%20Bel%C3%A1" target="_blank" rel="noopener">Navigovať na pobočku →</a>
          </div>
        </article>
        <article class="branch-card" data-reveal>
          <div class="branch-photo" data-parallax><span><video class="scene-video" src="/assets/town-lm.mp4" data-poster="/assets/poster-lm.webp" muted loop playsinline preload="none" aria-hidden="true"></video></span></div>
          <div class="branch-body">
            <h3>Liptovský Mikuláš</h3>
            <p class="branch-addr">Ester Šimerovej Martinčekovej 4506/4<br>031 01 Liptovský Mikuláš</p>
            <a class="branch-tel" href="tel:0903596364">0903 596 364</a>
            <p class="branch-hours">NON STOP · 24/7</p>
            <p class="branch-mail"><a href="mailto:pacigalm@gmail.com">pacigalm@gmail.com</a></p>
            <p class="branch-hours">Prevádzka: <a class="branch-tel-sm" href="tel:0949011051">0949 011 051</a><br>Po až Pi 8:00 až 16:00</p>
            <a class="btn-line sm" href="https://www.google.com/maps/search/?api=1&query=Pohrebn%C3%A9%20a%20kamen%C3%A1rske%20slu%C5%BEby%20Paciga%20Liptovsk%C3%BD%20Mikul%C3%A1%C5%A1" target="_blank" rel="noopener">Navigovať na pobočku →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ INTERIÉR POBOČIEK ============
       Fotky a video interiéru dodá klient; sloty držia miesto a pomer strán. -->
  <section class="interier">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Nazrite do našich pobočiek</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <p class="interier-lead" data-reveal>Príďte sa poradiť osobne. V každej pobočke si v pokoji pozriete rakvy, urny, vence aj šperky.</p>
      <div class="interier-grid">
        <figure class="interier-item" data-reveal>
          <div class="photo-slot ps-43" data-photo-slot><span>Miesto pre fotografiu</span><em>Interiér pobočky Poprad, showroom</em></div>
          <figcaption>Poprad</figcaption>
        </figure>
        <figure class="interier-item" data-reveal>
          <div class="photo-slot ps-43" data-photo-slot><span>Miesto pre fotografiu</span><em>Interiér pobočky Spišská Belá</em></div>
          <figcaption>Spišská Belá</figcaption>
        </figure>
        <figure class="interier-item" data-reveal>
          <div class="photo-slot ps-43" data-photo-slot><span>Miesto pre fotografiu</span><em>Interiér pobočky Liptovský Mikuláš</em></div>
          <figcaption>Liptovský Mikuláš</figcaption>
        </figure>
      </div>
      <div class="photo-slot interier-video" data-photo-slot data-reveal><span>Miesto pre video</span><em>Krátka prehliadka interiéru pobočiek</em></div>
    </div>
  </section>

  <!-- ============ FAKTURAČNÉ ÚDAJE ============ -->
  <section class="billing">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Fakturačné údaje</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <div class="billing-grid">
        <div class="bill-item" data-reveal>
          <div class="label">Obchodné meno a sídlo</div>
          <p>Pohrebné a kamenárske služby Paciga, s. r. o.<br>Partizánska 1140/22<br>059 01 Spišská Belá</p>
        </div>
        <div class="bill-item" data-reveal>
          <div class="label">Identifikátory</div>
          <p>IČO: 51 736 039<br>IČ DPH: SK2120765900</p>
        </div>
        <div class="bill-item" data-reveal>
          <div class="label">Elektronicky</div>
          <p>paciga@paciga.sk<br>www.paciga.sk</p>
        </div>
      </div>
    </div>
  </section>

<Fragment slot="scripts">
<script is:inline src="/js/forms.js"></script>
</Fragment>
</Base>
