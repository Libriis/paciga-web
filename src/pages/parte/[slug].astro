---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Zdielanie from '../../components/Zdielanie.astro';
import { getParteBySlug, getKondolencie, inicialky, fmtDlhy, fmtKratky, svieckyText, mapUrl, icsDataUrl, dnesnyDatum } from '../../lib/parte';

export const prerender = false;

const { slug } = Astro.params;
const p = slug ? await getParteBySlug(slug) : null;
if (!p) return Astro.redirect('/opustili-nas', 302);

const kondolencie = await getKondolencie(p.id);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=3600');

const zena = p.pohlavie === 'zena';
const zomrel = zena ? 'zomrela' : 'zomrel';
const narodenie = zena ? 'Narodila sa' : 'Narodil sa';
const rozluckaS = zena ? 's našou drahou zosnulou' : 's naším drahým zosnulým';
const vekText = p.vek === 1 ? '1 rok' : p.vek && p.vek <= 4 ? `${p.vek} roky` : `${p.vek} rokov`;

// rozlúčka po svojom dni prechádza do minulého času a stráca akčné odkazy
const dnes = dnesnyDatum();
const rozluckaKompletna = !!(p.rozlucka_datum && p.rozlucka_cas && p.rozlucka_miesto);
const rozluckaPrebehla = rozluckaKompletna && p.rozlucka_datum!.slice(0, 10) < dnes;

const rozluckaVeta = rozluckaKompletna
  ? rozluckaPrebehla
    ? `Posledná rozlúčka sa konala ${fmtDlhy(p.rozlucka_datum)}.`
    : `Posledná rozlúčka ${fmtDlhy(p.rozlucka_datum)} o ${p.rozlucka_cas}, ${p.rozlucka_miesto}.`
  : '';

const title = `${p.meno} | Opustili nás | Paciga`;
const description = `Smútočné oznámenie: ${p.meno}, ${zomrel} ${fmtDlhy(p.datum_umrtia)}${p.vek ? ` vo veku ${vekText}` : ''}.${rozluckaVeta ? ' ' + rozluckaVeta : ''}`;
const ogDescription = rozluckaVeta
  ? `${rozluckaVeta.replace(/\.$/, '')}. S úctou, pohrebná služba Paciga.`
  : 'S úctou, pohrebná služba Paciga.';

const ics = icsDataUrl(p);
const jsonld = p.rozlucka_datum && p.rozlucka_cas ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Posledná rozlúčka: ${p.meno}`,
  startDate: `${p.rozlucka_datum}T${p.rozlucka_cas}:00+02:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: p.rozlucka_miesto },
  organizer: { '@type': 'Organization', name: 'Paciga', url: 'https://www.paciga.sk' },
}).replace(/</g, '\\u003c') : null;
---
<Base title={title} description={description} active="opustili-nas" mainId="parte-main"
  ogTitle={`${p.meno} | Smútočné oznámenie`} ogDescription={ogDescription}
  ogImage={p.foto_url ?? undefined}>

  <Fragment slot="head">
    {jsonld && <script type="application/ld+json" set:html={jsonld}></script>}
  </Fragment>

  <!-- ============ FIXNÝ PANEL: FOTKA + TICHÁ SVIECA ============
       Panel sa nikdy nescrolluje (position:fixed), scrolluje len pravý
       stĺpec. Svieca sedí na strede dolnej časti fotky, počet zapálení
       je stále viditeľný. Kontrakt pre candles.js: .phero[data-slug],
       #phero-light, .phero-count, trieda .lit. -->
  <aside class="phero" data-name={p.meno} data-slug={p.slug}>
    <div class="phero-media">
      {p.foto_url
        ? <Foto src={p.foto_url} alt={p.meno} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 44vw" loading="eager" fetchpriority="high" />
        : <div class="phero-initials" aria-hidden="true">{inicialky(p.meno)}</div>}
      <!-- svieca leží na fotke, na desktope vyššie, aby pod ňou bolo zdieľanie -->
      <button type="button" class="phero-candle" id="phero-light" aria-pressed="false">
        <span class="phero-halo" aria-hidden="true"></span>
        <span class="phero-flame" aria-hidden="true"></span>
        <span class="phero-wick" aria-hidden="true"></span>
        <span class="phero-body" aria-hidden="true"></span>
        <span class="phero-label"><span class="off">Zapáliť sviečku</span><span class="on">Sviečka horí</span></span>
        <span class="phero-sviecky"><span class="phero-count">{p.sviecky > 0 ? svieckyText(p.sviecky) : ''}</span></span>
      </button>
    </div>
    <a href="/opustili-nas" class="parte-back">← Všetky oznámenia</a>
    <!-- zdieľanie pod sviečkou: na desktope na fotke, na mobile kartou pod ňou -->
    <Zdielanie url={new URL(`/parte/${p.slug}`, Astro.site ?? Astro.url).href} titulok={p.meno} typ="parte" naFotke />
  </aside>

  <!-- ============ SCROLLOVACÍ OBSAH ============ -->
  <section class="parte-content">
    <div class="eyebrow" data-reveal>Smútočné oznámenie</div>
    <h1 data-reveal>{p.meno}</h1>

    <div class="parte-rows" data-reveal>
      {p.datum_narodenia && <div class="parte-row"><span class="label">{narodenie}</span><span class="value">{fmtDlhy(p.datum_narodenia)}</span></div>}
      <div class="parte-row"><span class="label">{zena ? 'Zomrela' : 'Zomrel'}</span><span class="value">&#8224; {fmtDlhy(p.datum_umrtia)}</span></div>
      {p.vek && <div class="parte-row"><span class="label">Vo veku</span><span class="value">{vekText}</span></div>}
    </div>

    <div class="parte-verse" data-reveal>
      <p>„{p.odkaz_rodine ?? 'Rodine a blízkym vyjadrujeme úprimnú sústrasť. Je nám cťou sprevádzať vás poslednou rozlúčkou.'}“</p>
      <div class="parte-verse-author">Pohrebná služba Paciga</div>
    </div>

    {rozluckaKompletna && !rozluckaPrebehla && (
      <section class="parte-card" data-reveal>
        <div class="parte-card-label">Posledná rozlúčka {rozluckaS}</div>
        <div class="parte-when">{fmtDlhy(p.rozlucka_datum)} o {p.rozlucka_cas}</div>
        <div class="parte-card-rows">
          <div class="parte-card-row"><span class="k">Miesto</span><span class="v">📍 {p.rozlucka_miesto}</span></div>
        </div>
        <div class="parte-card-actions">
          <a class="parte-pill" href={mapUrl(p.rozlucka_miesto!)} target="_blank" rel="noopener">Zobraziť na mape →</a>
          {ics && <a class="parte-pill" href={ics} download={`rozlucka-${p.slug}.ics`}>Pridať do kalendára</a>}
        </div>
      </section>
    )}
    {rozluckaKompletna && rozluckaPrebehla && (
      <section class="parte-card" data-reveal>
        <div class="parte-card-label">Posledná rozlúčka</div>
        <div class="parte-konala">Rozlúčka {rozluckaS} sa konala</div>
        <div class="parte-when">{fmtDlhy(p.rozlucka_datum)}</div>
        <div class="parte-card-rows">
          <div class="parte-card-row"><span class="k">Miesto</span><span class="v">📍 {p.rozlucka_miesto}</span></div>
        </div>
      </section>
    )}

    {kondolencie.length > 0 && (
      <div class="parte-kond-list">
        <h2 data-reveal>Kondolencie</h2>
        {kondolencie.map((k) => (
          <blockquote class="kond-item" data-reveal>
            <p>„{k.odkaz}“</p>
            <footer>{k.meno}<span class="kond-date"> · {fmtKratky(k.created_at)}</span></footer>
          </blockquote>
        ))}
      </div>
    )}

    <section class="parte-card" data-reveal>
      <form id="kondolencia-form" class="kond-form" data-slug={p.slug}>
        <div class="parte-card-label">Napísať kondolenciu</div>
        <p class="kond-form-note">Odkaz s úctou odovzdáme rodine. Pri parte ho zverejníme po schválení.</p>
        <label>Vaše meno
          <input type="text" name="meno" maxlength="120" required autocomplete="name">
        </label>
        <label>Váš odkaz
          <textarea name="odkaz" rows="5" maxlength="2000" required></textarea>
        </label>
        <input type="text" name="web" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit" class="btn-gold">Odoslať kondolenciu</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <p class="pcond-note">Vence a kvetinovú výzdobu doručíme priamo na obrad. Kvety na rozlúčku · <a class="link-underline gold" href="tel:0903596364">0903 596 364</a></p>
    </section>
  </section>

<Fragment slot="scripts">
<script is:inline src="/js/candles.js"></script>
<script is:inline src="/js/forms.js"></script>
</Fragment>
</Base>
