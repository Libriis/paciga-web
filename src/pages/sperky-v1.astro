---
/*
  ŠPERKY — variant V1 „Vitrína" (lokálny návrh, nie je v navigácii).
  Múzejná galéria: biele produktové fotky ako exponáty vo vitríne na tmavom
  plátne. Vzor: HODINKEE produktové karty (Mobbin) + filter chips z e-commerce.
*/
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import type { FaqItem } from '../components/Faq.astro';

const otazky: FaqItem[] = [
  {
    q: 'Čo sa do šperku gravíruje?',
    a: 'Odtlačok prsta vášho blízkeho a nápis podľa vášho želania. Práve odtlačok robí zo šperku kúsok, ktorý sa nedá nahradiť.',
  },
  {
    q: 'Z akých kovov si môžem vybrať?',
    a: 'Zo zlata, striebra a ružového zlata. Prívesok nosíte na jemnej retiazke alebo na kordónovej šnúrke.',
  },
  {
    q: 'Aké tvary sú v ponuke?',
    a: 'Srdce a okrúhly medailón. Oba tvary vieme vyrobiť v ktoromkoľvek z ponúkaných kovov.',
  },
  {
    q: 'Môžem si zvoliť vlastný nápis?',
    a: 'Áno. Každý šperk gravírujeme na mieru a znenie nápisu je celkom na vás. Najčastejšie býva na šperku meno, dátum alebo krátke venovanie.',
  },
  {
    q: 'Kde si šperky môžem pozrieť naživo?',
    a: 'V showroome našej pobočky v Poprade na adrese Francisciho 3288/35. Fotografie na tejto stránke sú len ukážkou, kompletnú kolekciu vám ukážeme na mieste.',
  },
];

// Exponáty vitríny — len reálna ponuka (srdce a kruh; zlato, striebro, ružové zlato).
const exponaty = [
  { img: '/assets/sperky/srdce-zlato.jpg', cat: 'retiazky', kat: 'Retiazka', nazov: 'Zlaté srdce', pozn: 'Odtlačok prsta a nápis podľa vášho želania.' },
  { img: '/assets/sperky/srdce-striebro.jpg', cat: 'retiazky', kat: 'Retiazka', nazov: 'Strieborné srdce', pozn: 'Odtlačok prsta a nápis podľa vášho želania.' },
  { img: '/assets/sperky/kruh-zlato.jpg', cat: 'retiazky', kat: 'Retiazka', nazov: 'Zlatý medailón', pozn: 'Okrúhly disk s odtlačkom a venovaním.' },
  { img: '/assets/sperky/kruh-striebro.jpg', cat: 'retiazky', kat: 'Retiazka', nazov: 'Strieborný medailón', pozn: 'Okrúhly disk s odtlačkom a venovaním.' },
  { img: '/assets/sperky/srdce-ruzove.jpg', cat: 'retiazky', kat: 'Šnúrka', nazov: 'Srdce z ružového zlata', pozn: 'Na čiernej kordónovej šnúrke.' },
  { img: '/assets/sperky/srdce-zlato-meno.jpg', cat: 'gravir', kat: 'Gravír', nazov: 'Meno a dátum', pozn: 'Ukážka gravíru s menom a dátumom.' },
];

const title = 'Spomienkové šperky | Paciga, pohrebné a kamenárske služby';
const description = 'Spomienkové šperky s odtlačkom prsta vášho blízkeho. Retiazky a náramky zo zlata, striebra a ružového zlata, gravírovanie podľa želania. Showroom v Poprade.';
---
<Base title={`V1 Vitrína · ${title}`} description={description} active="sperky" ogImage="/assets/sperky/kolekcia.jpg">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <!-- ============ HERO ============ -->
  <section class="page-head">
    <div class="container">
      <div class="eyebrow" data-reveal>Spomienkové šperky</div>
      <h1 data-textreveal>Nikdy nezabudnem.</h1>
      <p class="page-head-lead" data-reveal>
        Šperk s odtlačkom prsta vášho blízkeho. Vyberáte tvar, kov aj nápis.
        My sa postaráme, aby zostal s vami každý deň.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-7" data-reveal>
        <a href="mailto:paciga@paciga.sk" class="btn-gold">Napíšte nám</a>
        <a href="/kontakt" class="link-underline">Showroom v Poprade</a>
      </div>
    </div>
  </section>

  <!-- ============ VITRÍNA (kolekcia) ============ -->
  <section class="pb-6">
    <div class="container">
      <figure class="v1-plate overflow-hidden" data-reveal>
        <img src="/assets/sperky/kolekcia.jpg" alt="Kolekcia spomienkových šperkov Paciga: retiazky a náramky so srdcami a medailónmi" class="block w-full" fetchpriority="high" decoding="async" />
      </figure>
      <figcaption class="mt-4 flex items-center justify-between text-[11px] uppercase tracking-[0.2em] text-dim" data-reveal>
        <span>Kolekcia · srdce a kruh</span>
        <span>Zlato · striebro · ružové zlato</span>
      </figcaption>
    </div>
  </section>

  <!-- ============ GALÉRIA S FILTROM ============ -->
  <section class="py-[clamp(80px,12vh,140px)]">
    <div class="container">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <div class="eyebrow">Vitrína</div>
          <h2>Každý kúsok je exponát.</h2>
        </div>
        <!-- filter chips — pattern z produktových listingov (Mobbin) -->
        <div class="flex flex-wrap gap-2.5" role="group" aria-label="Filter ponuky">
          <button type="button" class="v1-chip is-on" data-filter="vsetko">Všetko</button>
          <button type="button" class="v1-chip" data-filter="retiazky">Retiazky a šnúrky</button>
          <button type="button" class="v1-chip" data-filter="naramky">Náramky</button>
          <button type="button" class="v1-chip" data-filter="gravir">Gravír</button>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-[22px] sm:grid-cols-2 lg:grid-cols-3" id="v1-grid">
        {exponaty.map((e, i) => (
          <article class="v1-card" data-cat={e.cat} data-reveal>
            <div class="v1-plate">
              <img src={e.img} alt={`${e.nazov}, spomienkový šperk s gravírovaným odtlačkom prsta`} class="block aspect-square w-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="mt-4 border-t border-line pt-4">
              <div class="text-[11px] uppercase tracking-[0.2em] text-dim">č. {String(i + 1).padStart(2, '0')} · {e.kat}</div>
              <h3 class="mt-1.5 text-[20px]">{e.nazov}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-soft">{e.pozn}</p>
            </div>
          </article>
        ))}

        <!-- náramky — široká karta cez dva stĺpce -->
        <article class="v1-card sm:col-span-2" data-cat="naramky" data-reveal>
          <div class="v1-plate">
            <img src="/assets/sperky/naramky.jpg" alt="Kordónové náramky s gravírovanými príveskami na vankúšiku" class="block aspect-[3/2] w-full object-cover sm:aspect-[2/1]" loading="lazy" decoding="async" />
          </div>
          <div class="mt-4 border-t border-line pt-4">
            <div class="text-[11px] uppercase tracking-[0.2em] text-dim">č. 07 · Náramky</div>
            <h3 class="mt-1.5 text-[20px]">Kordónové náramky</h3>
            <p class="mt-1 text-[15px] leading-relaxed text-soft">Čierna šnúrka s posuvnými uzlami a prívesok s odtlačkom. Náramkové prívesky aj v modrej a čiernej.</p>
          </div>
        </article>
      </div>

      <p class="mt-10 text-[14px] text-dim" data-reveal>Ukážky z ponuky. Kompletnú kolekciu vám ukážeme v showroome v Poprade.</p>
    </div>
  </section>

  <!-- ============ AKO VZNIKÁ ============ -->
  <section class="bg-ink2 py-[clamp(80px,12vh,140px)]">
    <div class="container">
      <div class="eyebrow" data-reveal>Ako šperk vzniká</div>
      <h2 data-textreveal>Tri kroky k spomienke.</h2>
      <div class="mt-12 grid grid-cols-1 gap-[22px] md:grid-cols-3">
        {[
          { n: '01', t: 'Odtlačok', p: 'Odtlačok prsta vášho blízkeho snímeme my. Stačí nám povedať, o koho ide, všetko ostatné vybavíme.' },
          { n: '02', t: 'Gravír', p: 'Do zvoleného tvaru a kovu vygravírujeme odtlačok a nápis podľa vášho želania. Meno, dátum alebo krátke venovanie.' },
          { n: '03', t: 'Odovzdanie', p: 'Hotový šperk si prevezmete v showroome v Poprade alebo vám ho doručíme.' },
        ].map((k) => (
          <div class="rounded-[18px] border border-line bg-panel p-[26px]" data-reveal>
            <div class="text-[13px] tracking-[0.2em] text-dim">{k.n}</div>
            <h3 class="mt-3 text-[21px]">{k.t}</h3>
            <p class="mt-2.5 text-[15.5px] leading-relaxed text-soft">{k.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ČASTÉ OTÁZKY ============ -->
  <section class="py-[clamp(80px,12vh,140px)]">
    <div class="container">
      <Faq items={otazky} eyebrow="Časté otázky" heading="Čo sa najčastejšie pýtate" />
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-panel py-[clamp(100px,14vh,170px)] text-center">
    <div class="container">
      <h2 data-textreveal>Napíšte nám. Radi vám poradíme.</h2>
      <p class="mx-auto mt-5 max-w-[52ch] text-[clamp(18px,1.7vw,22px)] leading-relaxed text-soft" data-reveal>Šperky si môžete pozrieť v showroome našej pobočky v Poprade.</p>
      <div class="mt-8" data-reveal>
        <a href="tel:0903596364" class="phone-big inline-block">0903 596 364</a>
        <div class="mt-3.5 text-[14px] tracking-[0.04em] text-dim">📍 Francisciho 3288/35, 058 01 Poprad</div>
      </div>
      <div class="mt-9 flex justify-center" data-reveal>
        <a href="mailto:paciga@paciga.sk" class="btn-gold">Napíšte nám</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Biela podložka exponátu — fotky majú biele pozadie, vitrína ho priznáva
     ako svetlo v tmavej miestnosti. Rám je hairline, hover ho rozsvieti. */
  .v1-plate {
    background: #f9f9f9;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition: border-color 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.45s ease;
  }
  .v1-card:hover .v1-plate {
    border-color: rgb(var(--fg-rgb) / 0.4);
    transform: translateY(-5px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .v1-card.is-hidden { display: none; }

  .v1-chip {
    padding: 9px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }
  .v1-chip:hover { color: var(--text); border-color: rgb(var(--fg-rgb) / 0.3); }
  .v1-chip.is-on { background: var(--gold); color: var(--bg); border-color: transparent; }
</style>

<script is:inline slot="scripts">
  // Filter vitríny — čistý DOM, bez knižníc.
  (function () {
    var chips = document.querySelectorAll('.v1-chip');
    var cards = document.querySelectorAll('#v1-grid .v1-card');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.classList.remove('is-on'); });
        chip.classList.add('is-on');
        var f = chip.getAttribute('data-filter');
        cards.forEach(function (card) {
          var show = f === 'vsetko' || card.getAttribute('data-cat') === f;
          card.classList.toggle('is-hidden', !show);
        });
        if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
      });
    });
  })();
</script>
