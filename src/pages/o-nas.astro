---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SIRKY_HERO, SIRKY_KRONIKA, KVALITA_POZADIE, KVALITA_KARTA } from '../lib/images';
/* Užší záber tímu: široká tímová fotka (o-nas-tim.jpg) je od 15. 8. 2026
   hero na homepage, O nás dostáva iný záber z toho istého fotenia, nech
   sa web neopakuje. OG náhľad ostáva široká fotka. */
import tim from '../assets/o-nas-tim-blizko.jpg';
import kron2016 from '../assets/kron-2016.jpg';
import kron2018 from '../assets/kron-2018.jpg';
import kron3000 from '../assets/kron-3000.jpg';
import kronDnes from '../assets/kron-dnes.jpg';
/* Pôvodne asset-05 (dvaja členovia tímu pri limuzíne); vymenené 14. 8. 2026,
   pán vpravo už vo firme nepracuje. Vozidlá bez ľudí z tej istej série. */
import ludia from '../assets/o-nas-vozidla.jpg';
import fleetStill from '../assets/fleet-still.jpg';

const title = "O nás | Paciga, pohrebné a kamenárske služby";
const description = "Rodinná pohrebná a kamenárska služba Paciga. Od roku 2018 sprevádzame rodiny v Poprade, Spišskej Belej a Liptovskom Mikuláši. Viac než 3 000 vybavených pohrebov.";
const ogTitle = "O nás | Paciga";
const ogDescription = "Rodinná firma spod Tatier. Od roku 2018 sprevádzame rodiny s ľudskosťou, dôstojnosťou a empatiou.";

// Nosiči pre pás „celý tím". Mená sú zástupné, kým klient dodá reálny zoznam.
const nosici = [
  'Peter Krupa', 'Ján Šoltés', 'Milan Gavura', 'Štefan Bača', 'Jozef Krempaský',
  'Tomáš Olekšák', 'Marek Pavlica', 'Michal Zoričák', 'Ondrej Britaňák', 'Lukáš Hudáček',
];
---
<Base title={title} description={description} active="o-nas" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/o-nas-tim.jpg">



  <!-- ============ HLAVIČKA: newsroom band s fotkou ============ -->
  <section class="news-hero has-photo">
    <div class="nh-media" aria-hidden="true">
      <Image src={tim} widths={SIRKY_HERO} sizes="100vw" quality={KVALITA_POZADIE} alt="" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="container news-hero-inner">
      <div>
        <div class="eyebrow" data-reveal>O nás</div>
        <h1 data-textreveal>Rodinná firma<br>spod Tatier.</h1>
      </div>
    </div>
    <div class="container news-hero-chips" data-reveal>
      <div class="situ-label">Čo vás zaujíma?</div>
      <div class="situ-row">
        <a href="#pribeh" class="situ-chip">Náš príbeh</a>
        <a href="#tim" class="situ-chip">Náš tím</a>
        <a href="#vozidla" class="situ-chip">Vozový park</a>
      </div>
    </div>
  </section>

  <!-- ============ ČÍSLA ============
       Zámerne hneď pod hero: subhero má min-height 72vh, takže pás vykúka nad
       ohybom a počítadlo sa rozbehne pri prvom pohybe scrollu.
       Tichý pás v troch stĺpcoch, nie monumentálne riadky. Čísla nesú váhu
       obsahu, nie plochy. -->
  <section class="stats" data-seam>
    <div class="container">
      <div class="stat-strip" data-statstrip>
        <i class="stat-rule" aria-hidden="true"></i>
        <div class="stat">
          <span class="stat-num"><span data-count="3000">0</span>+</span>
          <span class="stat-word">pohrebov</span>
          <p class="stat-note">Vybavených od vzniku firmy v máji 2018.</p>
        </div>
        <div class="stat">
          <span class="stat-num"><span data-count="3">0</span></span>
          <span class="stat-word">pobočky</span>
          <p class="stat-note">Poprad, Spišská Belá a Liptovský Mikuláš.</p>
        </div>
        <div class="stat">
          <span class="stat-num">24/7</span>
          <span class="stat-word">nonstop</span>
          <p class="stat-note">Prevoz zosnulých v ktorúkoľvek hodinu, aj v noci a cez sviatky.</p>
        </div>
      </div>

      <!-- výrok v jednom bloku s číslami; slová sa odhaľujú so scrollom
           (mašinéria #quote-text vo main.js, serif Playfair len pre citáty) -->
      <div class="quote-inner" id="quote">
        <p id="quote-text">Od prvého telefonátu po dôstojnú rozlúčku.</p>
      </div>
    </div>
  </section>

  <!-- ============ KRONIKA ============ -->
  <section class="kronika" id="pribeh">
    <div class="container">
      <!-- Bez nadpisu — os začína rovno prvým uzlom (žiadosť klienta).
           Jedna súvislá sekcia: bývalý „Náš príbeh" (editoriálne dvojice) je
           vliaty do časovej osi — texty aj foto sloty nesú uzly kroniky.
           Striedavé dvojice okolo zvislej osi; os sa plní so scrollom a uzly
           sa rozsvietia, keď ich prejde. Fotky sú zatiaľ placeholdery. -->
      <div class="kron">
        <div class="kron-rail" aria-hidden="true"><i id="kron-fill"></i></div>

        <div class="kron-item" data-reveal>
          <div class="kron-body">
            <div class="kron-year">2016</div>
            <h3>Vlastné prenosné chladenie</h3>
            <p>Na výstave Slovak Funeral sme predstavili vlastnú technológiu prenosného chladenia. Ako prví v regióne.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <Image class="kron-photo" src={kron2016} widths={SIRKY_KRONIKA} sizes="(max-width: 860px) 92vw, (max-width: 1288px) 44vw, 565px" quality={KVALITA_KARTA} alt="Stany Paciga s technikou pri príprave hrobového miesta" loading="lazy" decoding="async" />
        </div>

        <div class="kron-item kron-flip" data-reveal>
          <div class="kron-body">
            <div class="kron-year">2018</div>
            <h3>Vznik spoločnosti Paciga</h3>
            <p>24. mája 2018 sme v Spišskej Belej nadviazali na spoločnosť Archa Belá. Sme rodinná firma a od prvého dňa staviame na tom, čo v ťažkých chvíľach rozhoduje: na ľudskosti, dôstojnosti a spoľahlivosti.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <Image class="kron-photo" src={kron2018} widths={SIRKY_KRONIKA} sizes="(max-width: 860px) 92vw, (max-width: 1288px) 44vw, 565px" quality={KVALITA_KARTA} alt="Nosiči Paciga s rakvou pri kaplnke" loading="lazy" decoding="async" />
        </div>

        <div class="kron-item" data-reveal>
          <div class="kron-body">
            <div class="kron-year">3&nbsp;000+</div>
            <h3>Rodiny, ktoré sme sprevádzali</h3>
            <p>Zabezpečujeme kompletné pohrebné služby, kvetinovú výzdobu, prevoz zosnulých doma aj zo zahraničia a kamenárske práce od výkopu hrobu po žulový pomník.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <Image class="kron-photo" src={kron3000} widths={SIRKY_KRONIKA} sizes="(max-width: 860px) 92vw, (max-width: 1288px) 44vw, 565px" quality={KVALITA_KARTA} alt="Smútočný obrad pod stanom Paciga" loading="lazy" decoding="async" />
        </div>

        <div class="kron-item kron-flip kron-now" data-reveal>
          <div class="kron-body">
            <div class="kron-year">Dnes</div>
            <h3>Tri mestá pod Tatrami</h3>
            <p>Poprad, Spišská Belá a Liptovský Mikuláš. Sme pri vás každý deň, v ktorúkoľvek hodinu. Čestne a na vysokej profesionálnej úrovni.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <Image class="kron-photo" src={kronDnes} widths={SIRKY_KRONIKA} sizes="(max-width: 860px) 92vw, (max-width: 1288px) 44vw, 565px" quality={KVALITA_KARTA} alt="Stan Paciga na cintoríne pod zasneženými Tatrami" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOTOPÁS: ĽUDIA ============ -->
  <div class="album-band album-band-right" id="ludia" data-parallax>
    <span><Image src={ludia} widths={SIRKY_HERO} sizes="100vw" quality={KVALITA_POZADIE} alt="Pohrebná limuzína Mercedes-Benz a prevozné vozidlo Paciga na lúke pod Tatrami" loading="lazy" decoding="async" /></span>
    <div class="album-shade" aria-hidden="true"></div>
    <div class="container album-caption">
      <span class="micro-label" data-reveal>Ľudia</span>
      <h2 data-textreveal>Kto sa o vás postará</h2>
      <p data-reveal>Sme rodina a kolegovia, ktorí svoju prácu berú ako poslanie. Za každou rozlúčkou stojí konkrétny človek, ktorý je pri vás od prvého telefonátu až po poslednú bodku.</p>
    </div>
  </div>

  <!-- ============ TÍM ============
       Odpoveď na otázku z pásu nad tým, preto tu nie je vlastný veľký nadpis.
       Fotka vypĺňa celú kartu, dole cez ňu ide závoj a v ňom sedí meno s rolou.
       Karta pod kurzorom ostane ostrá, ostatné dve klesnú a rozostria sa,
       čiže tou istou mechanikou ako kapitoly služieb na homepage.
       Vybraný variant V2 z /lab-tim.

       data-reveal je zámerne na mriežke a nie na kartách: GSAP by kartám
       zapísal opacity inline a stlmenie nezvýraznených by neprešlo. -->
  <section class="team" id="tim" data-seam>
    <div class="container">
      <div class="section-head">
        <h2 class="team-head" data-maskreveal>Náš tím</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <div class="team-grid" data-reveal>
        <article class="team-card">
          <div class="photo-slot team-shot" data-photo-slot><span>Miesto pre fotografiu</span><em>Portrét na výšku, neutrálne pozadie</em></div>
          <div class="team-veil" aria-hidden="true"></div>
          <div class="team-body">
            <h3 class="team-name">Meno a priezvisko</h3>
            <span class="team-role">Doplniť rolu</span>
          </div>
        </article>
        <article class="team-card">
          <div class="photo-slot team-shot" data-photo-slot><span>Miesto pre fotografiu</span><em>Portrét na výšku, neutrálne pozadie</em></div>
          <div class="team-veil" aria-hidden="true"></div>
          <div class="team-body">
            <h3 class="team-name">Meno a priezvisko</h3>
            <span class="team-role">Doplniť rolu</span>
          </div>
        </article>
        <article class="team-card">
          <div class="photo-slot team-shot" data-photo-slot><span>Miesto pre fotografiu</span><em>Portrét na výšku, neutrálne pozadie</em></div>
          <div class="team-veil" aria-hidden="true"></div>
          <div class="team-body">
            <h3 class="team-name">Meno a priezvisko</h3>
            <span class="team-role">Doplniť rolu</span>
          </div>
        </article>
      </div>

      {/* Sekcia „Vedúci pobočiek" tu bola od 3. 8. 2026 (žiadosť klienta),
          9. 8. 2026 ju klient stiahol. Mená v nej boli zástupné a reálne
          nedodal, takže radšej nič než vymyslení ľudia. Ak sa vráti, ide
          o blok .team-lead-head plus druhú .team-grid s tromi kartami. */}

      <!-- Celý tím: desať nosičov v páse miniatúr pod hlavnými kartami.
           Pás je do kliknutia skrytý, sekcia tak drží pôvodný rytmus troch
           kariet. Miniatúra nesie len siluetu; meno a rola žijú vo väčšej
           karte, ktorá vystúpi nad miniatúrou pod kurzorom. Silueta je
           dočasný placeholder, kým prídu fotografie nosičov.
           team-full je bez data-reveal: GSAP by hidden bloku zapísal inline
           opacity a otváranie by sa s ním bilo; fade rieši CSS trieda. -->
      <div class="team-more" data-reveal>
        <button type="button" class="btn-line team-toggle" id="team-toggle" aria-expanded="false" aria-controls="team-full">Zobraziť celý tím</button>
      </div>
      <div class="team-full" id="team-full" hidden>
        <div class="team-mini-grid">
          {nosici.map((meno) => (
            <article class="team-mini" tabindex="0" aria-label={`${meno}, nosič`}>
              <span class="team-mini-photo" aria-hidden="true">
                <svg viewBox="0 0 64 64" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M32 30c6.6 0 12-5.4 12-12S38.6 6 32 6 20 11.4 20 18s5.4 12 12 12Zm0 7c-11.9 0-23 6-23 17.4V64h46v-9.6C55 43 43.9 37 32 37Z"/></svg>
              </span>
              <div class="team-mini-pop" aria-hidden="true">
                <span class="team-pop-photo"><svg viewBox="0 0 64 64" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M32 30c6.6 0 12-5.4 12-12S38.6 6 32 6 20 11.4 20 18s5.4 12 12 12Zm0 7c-11.9 0-23 6-23 17.4V64h46v-9.6C55 43 43.9 37 32 37Z"/></svg></span>
                <div class="team-pop-body">
                  <h3 class="team-pop-name">{meno}</h3>
                  <span class="team-pop-role">Nosič</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FLOTILA ============
       Sekcia „Ako prví v regióne" tu bola do 14. 8. 2026; klient ju dal
       stiahnuť, lebo prvenstvá sa opakovali s obsahom kroniky vyššie. -->

  <section class="fleetband" id="vozidla">
    <div class="fleetband-media" data-parallax aria-hidden="true">
      <span><Image src={fleetStill} widths={SIRKY_HERO} sizes="100vw" quality={KVALITA_POZADIE} alt="" loading="lazy" decoding="async" /></span>
      <div class="fleetband-shade"></div>
    </div>
    <div class="container fleetband-content">
      <h2 data-textreveal>Flotila, ktorá vzdáva úctu</h2>
      <p data-reveal>Vozidlá Mercedes-Benz s chladením, automatickou prevodovkou a pohonom 4×4. Dôstojne a spoľahlivo za každého počasia. Súčasťou flotily je pohrebná limuzína ocenená ako najkrajšia na Slovensku.</p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-band" data-seam>
    <div class="cta-inner">
      <h2 data-textreveal>Sme pri vás, keď to najviac potrebujete</h2>
      <p data-reveal>Zavolajte kedykoľvek. Poradíme, prevezmeme a s úctou zabezpečíme všetko potrebné.</p>
      <a href="tel:0903596364" class="btn-gold btn-lg" data-reveal>NON STOP · 0903 596 364</a>
    </div>
  </section>

</Base>

<script is:inline>
  (() => {
    const btn = document.getElementById('team-toggle');
    const full = document.getElementById('team-full');
    if (!btn || !full) return;
    btn.addEventListener('click', () => {
      const opening = full.hidden;
      if (opening) {
        full.hidden = false;
        void full.offsetHeight; /* reflow, inak by transition nezahrala */
        full.classList.add('is-open');
      } else {
        full.classList.remove('is-open');
        setTimeout(() => { full.hidden = true; }, 450);
      }
      btn.setAttribute('aria-expanded', String(opening));
      btn.textContent = opening ? 'Skryť celý tím' : 'Zobraziť celý tím';
    });
  })();
</script>
