---
import Base from '../layouts/Base.astro';

const title = "O nás | Paciga, pohrebné a kamenárske služby";
const description = "Rodinná pohrebná a kamenárska služba Paciga. Od roku 2018 sprevádzame rodiny v Poprade, Spišskej Belej a Liptovskom Mikuláši. Viac než 3 000 vybavených pohrebov.";
const ogTitle = "O nás | Paciga";
const ogDescription = "Rodinná firma spod Tatier. Od roku 2018 sprevádzame rodiny s ľudskosťou, dôstojnosťou a empatiou.";
---
<Base title={title} description={description} active="o-nas" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/o-nas-tim.jpg">



  <!-- ============ SUBHERO ============ -->
  <section class="subhero">
    <div class="subhero-media" aria-hidden="true">
      <img src="/assets/o-nas-tim.jpg" alt="" fetchpriority="high" decoding="async">
      <div class="subhero-shade"></div>
    </div>
    <div class="container subhero-content">
      <div class="eyebrow" data-reveal>O nás</div>
      <h1 data-textreveal>Rodinná firma<br>spod Tatier.</h1>
      <p class="subhero-lead" data-reveal>Pohrebné a kamenárske služby Paciga. Od roku 2018 sprevádzame rodiny v Poprade, Spišskej Belej a Liptovskom Mikuláši.</p>
    </div>
  </section>

  <!-- ============ ČÍSLA ============
       Zámerne hneď pod hero: subhero má min-height 72vh, takže pás vykúka nad
       ohybom a počítadlo sa rozbehne pri prvom pohybe scrollu.
       Tichý pás v troch stĺpcoch, nie monumentálne riadky. Čísla nesú váhu
       obsahu, nie plochy. -->
  <section class="stats" data-seam>
    <div class="container">
      <div class="stat-strip" data-statstrip>
        <i class="stat-rule" aria-hidden="true"></i>
        <div class="stat">
          <span class="stat-num"><span data-count="3000">0</span>+</span>
          <span class="stat-word">pohrebov</span>
          <p class="stat-note">Vybavených od vzniku firmy v máji 2018.</p>
        </div>
        <div class="stat">
          <span class="stat-num"><span data-count="3">0</span></span>
          <span class="stat-word">pobočky</span>
          <p class="stat-note">Poprad, Spišská Belá a Liptovský Mikuláš.</p>
        </div>
        <div class="stat">
          <span class="stat-num">24/7</span>
          <span class="stat-word">nonstop</span>
          <p class="stat-note">Prevoz zosnulých v ktorúkoľvek hodinu, aj v noci a cez sviatky.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOTOPÁS: NAŠA PRÁCA ============ -->
  <div class="album-band" data-parallax>
    <span><img src="/assets/cintorin.jpg" alt="Stan Paciga pri poslednej rozlúčke na cintoríne" loading="lazy" decoding="async"></span>
    <div class="album-shade" aria-hidden="true"></div>
    <div class="container album-caption">
      <span class="micro-label" data-reveal>Naša práca</span>
      <p class="album-line" data-reveal>Od prvého telefonátu po dôstojnú rozlúčku.</p>
    </div>
  </div>

  <!-- ============ KRONIKA ============ -->
  <section class="kronika" data-seam>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow" data-reveal>Kronika</div>
        <h2 data-textreveal>Náš príbeh</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <!-- Jedna súvislá sekcia: bývalý „Náš príbeh" (editoriálne dvojice) je
           vliaty do časovej osi — texty aj foto sloty nesú uzly kroniky.
           Striedavé dvojice okolo zvislej osi; os sa plní so scrollom a uzly
           sa rozsvietia, keď ich prejde. Fotky sú zatiaľ placeholdery. -->
      <div class="kron">
        <div class="kron-rail" aria-hidden="true"><i id="kron-fill"></i></div>

        <div class="kron-item" data-reveal>
          <div class="kron-body">
            <div class="kron-year">2016</div>
            <h3>Vlastné prenosné chladenie</h3>
            <p>Na výstave Slovak Funeral sme predstavili vlastnú technológiu prenosného chladenia. Ako prví v regióne.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <div class="photo-slot ps-43" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Archív: stánok na výstave Slovak Funeral 2016</em>
          </div>
        </div>

        <div class="kron-item kron-flip" data-reveal>
          <div class="kron-body">
            <div class="kron-year">2018</div>
            <h3>Vznik spoločnosti Paciga</h3>
            <p>24. mája 2018 sme v Spišskej Belej nadviazali na spoločnosť Archa Belá. Sme rodinná firma a od prvého dňa staviame na tom, čo v ťažkých chvíľach rozhoduje: na ľudskosti, dôstojnosti a spoľahlivosti.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <div class="photo-slot ps-43" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Interiér pobočky, kde prijímate rodiny</em>
          </div>
        </div>

        <div class="kron-item" data-reveal>
          <div class="kron-body">
            <div class="kron-year">3&nbsp;000+</div>
            <h3>Rodiny, ktoré sme sprevádzali</h3>
            <p>Zabezpečujeme kompletné pohrebné služby, kvetinovú výzdobu, prevoz zosnulých doma aj zo zahraničia a kamenárske práce od výkopu hrobu po žulový pomník.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <div class="photo-slot ps-43" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Kvetinárstvo, výroba vencov a smútočnej výzdoby</em>
          </div>
        </div>

        <div class="kron-item kron-flip kron-now" data-reveal>
          <div class="kron-body">
            <div class="kron-year">Dnes</div>
            <h3>Tri mestá pod Tatrami</h3>
            <p>Poprad, Spišská Belá a Liptovský Mikuláš. Sme pri vás každý deň, v ktorúkoľvek hodinu. Čestne a na vysokej profesionálnej úrovni.</p>
          </div>
          <span class="kron-dot" aria-hidden="true"></span>
          <div class="photo-slot ps-43" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Tím pred pobočkou v Poprade, dnes</em>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOTOPÁS: ĽUDIA ============ -->
  <div class="album-band album-band-right" id="ludia" data-parallax>
    <span><img src="/assets/asset-05.jpg" alt="Dvaja členovia tímu Paciga v rovnošatách pri pohrebnej limuzíne pod Tatrami" loading="lazy" decoding="async"></span>
    <div class="album-shade" aria-hidden="true"></div>
    <div class="container album-caption">
      <span class="micro-label" data-reveal>Ľudia</span>
      <h2 data-textreveal>Kto sa o vás postará</h2>
      <p data-reveal>Sme rodina a kolegovia, ktorí svoju prácu berú ako poslanie. Za každou rozlúčkou stojí konkrétny človek, ktorý je pri vás od prvého telefonátu až po poslednú bodku.</p>
    </div>
  </div>

  <!-- ============ TÍM ============
       Odpoveď na otázku z pásu nad tým, preto tu nie je vlastný veľký nadpis.
       Fotka vypĺňa celú kartu, dole cez ňu ide závoj a v ňom sedí meno s rolou.
       Karta pod kurzorom ostane ostrá, ostatné dve klesnú a rozostria sa,
       čiže tou istou mechanikou ako kapitoly služieb na homepage.
       Vybraný variant V2 z /lab-tim.

       data-reveal je zámerne na mriežke a nie na kartách: GSAP by kartám
       zapísal opacity inline a stlmenie nezvýraznených by neprešlo. -->
  <section class="team" id="tim" data-seam>
    <div class="container">
      <div class="section-head">
        <h2 class="team-head" data-maskreveal>Náš tím</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <div class="team-grid" data-reveal>
        <article class="team-card">
          <div class="photo-slot team-shot" data-photo-slot><span>Miesto pre fotografiu</span><em>Portrét na výšku, neutrálne pozadie</em></div>
          <div class="team-veil" aria-hidden="true"></div>
          <div class="team-body">
            <h3 class="team-name">Meno a priezvisko</h3>
            <span class="team-role">Doplniť rolu</span>
          </div>
        </article>
        <article class="team-card">
          <div class="photo-slot team-shot" data-photo-slot><span>Miesto pre fotografiu</span><em>Portrét na výšku, neutrálne pozadie</em></div>
          <div class="team-veil" aria-hidden="true"></div>
          <div class="team-body">
            <h3 class="team-name">Meno a priezvisko</h3>
            <span class="team-role">Doplniť rolu</span>
          </div>
        </article>
        <article class="team-card">
          <div class="photo-slot team-shot" data-photo-slot><span>Miesto pre fotografiu</span><em>Portrét na výšku, neutrálne pozadie</em></div>
          <div class="team-veil" aria-hidden="true"></div>
          <div class="team-body">
            <h3 class="team-name">Meno a priezvisko</h3>
            <span class="team-role">Doplniť rolu</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ PRVENSTVÁ ============ -->
  <section class="prvenstva">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Ako prví v regióne</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <!-- Každé prvenstvo dostane vizuálny dôkaz. Poradenstvo sa zámerne fotí
           ako miesto bez ľudí; inscenovaná konzultácia by sekcii uškodila. -->
      <div class="pl-list">
        <div class="ed-pair ed-tight" data-reveal>
          <div class="ed-text">
            <span class="pl-num">01</span>
            <h3>Prenosné chladenie</h3>
            <p>Vlastnú technológiu sme prvýkrát predstavili na výstave Slovak Funeral v roku 2016.</p>
          </div>
          <div class="photo-slot ps-32" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Prenosné chladenie v prevádzke, detail zariadenia</em>
          </div>
        </div>
        <div class="ed-pair ed-tight ed-flip" data-reveal>
          <div class="ed-text">
            <span class="pl-num">02</span>
            <h3>3D vizualizácia pomníka</h3>
            <p>Pomník uvidíte skôr, než ho začneme vyrábať.</p>
          </div>
          <div class="photo-slot ps-32" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Vizualizácia pomníka na obrazovke, vedľa vzorky žuly</em>
          </div>
        </div>
        <div class="ed-pair ed-tight" data-reveal>
          <div class="ed-text">
            <span class="pl-num">03</span>
            <h3>Smútkové poradenstvo</h3>
            <p>Podpora a sprevádzanie v procese smútenia.</p>
          </div>
          <div class="photo-slot ps-32" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Miesto na rozhovor s rodinou: dve kreslá, stôl, mäkké svetlo. Bez ľudí</em>
          </div>
        </div>
        <div class="ed-pair ed-tight ed-flip" data-reveal>
          <div class="ed-text">
            <span class="pl-num">04</span>
            <h3>Medzinárodný prevoz</h3>
            <p>Preprava zosnulých zo zahraničia vrátane všetkých dokumentov.</p>
          </div>
          <div class="photo-slot ps-32" data-photo-slot>
            <span>Miesto pre fotografiu</span><em>Vozidlo pripravené na cestu, dokumenty na sedadle</em>
          </div>
        </div>
      </div>
      <p class="pl-note" data-reveal>V podtatranskom regióne sme jediným členom Asociácie pohrebných služieb na Slovensku.</p>
    </div>
  </section>

  <!-- ============ FLOTILA ============ -->
  <section class="fleetband">
    <div class="fleetband-media" data-parallax aria-hidden="true">
      <span><img src="/assets/fleet-still.jpg" alt="" loading="lazy" decoding="async"></span>
      <div class="fleetband-shade"></div>
    </div>
    <div class="container fleetband-content">
      <h2 data-textreveal>Flotila, ktorá vzdáva úctu</h2>
      <p data-reveal>Vozidlá Mercedes-Benz s chladením, automatickou prevodovkou a pohonom 4×4. Dôstojne a spoľahlivo za každého počasia. Súčasťou flotily je pohrebná limuzína ocenená ako najkrajšia na Slovensku.</p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-band" data-seam>
    <div class="cta-inner">
      <h2 data-textreveal>Sme pri vás, keď to najviac potrebujete</h2>
      <p data-reveal>Zavolajte kedykoľvek. Poradíme, prevezmeme a s úctou zabezpečíme všetko potrebné.</p>
      <a href="tel:0903596364" class="btn-gold btn-lg" data-reveal>NON STOP · 0903 596 364</a>
    </div>
  </section>

</Base>
