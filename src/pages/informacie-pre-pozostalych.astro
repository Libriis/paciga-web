---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SIRKY_HERO, KVALITA_POZADIE } from '../lib/images';
import infoHero from '../assets/info-hero.jpg';
import Faq from '../components/Faq.astro';
import type { FaqItem } from '../components/Faq.astro';
import IkonaKroku from '../components/IkonaKroku.astro';

const otazky: FaqItem[] = [
  {
    q: 'Komu mám zavolať ako prvému?',
    a: 'Ak úmrtie nastalo doma alebo za nejasných okolností, volajte najprv tiesňovú linku 112. Operátor vyšle lekára na prehliadku. Po prehliadke zavolajte nám na číslo 0903 596 364 a prevoz aj všetko ostatné zabezpečíme za vás. Ak úmrtie nastalo v nemocnici, kontaktuje vás poverený zamestnanec nemocnice.',
  },
  {
    q: 'V akom čase vám môžem volať?',
    a: 'Kedykoľvek. Prevoz zosnulých zabezpečujeme nepretržite, 24 hodín denne, každý deň v roku vrátane víkendov a sviatkov. Volajte 0903 596 364 alebo 0948 110 109.',
  },
  {
    q: 'Musím si objednať pohreb u služby, ktorá vykonala prevoz na pitvu?',
    a: 'Nie. Prevoz na pitvu vykonáva pohrebná služba zazmluvnená nemocnicou alebo privolaná políciou, ďalšie služby si u nej objednávať nemusíte. Pohrebnú službu si vyberáte vy, podľa vlastného uváženia. Nenechajte sa ovplyvniť vo chvíli, keď ste najzraniteľnejší.',
  },
  {
    q: 'Aké doklady si mám pripraviť?',
    a: 'Občiansky preukaz zosnulého a váš občiansky preukaz ako obstarávateľa pohrebu. K tomu oblečenie pre zosnulého. Podrobný zoznam nájdete vyššie na tejto stránke.',
  },
  {
    q: 'Čo ak niektoré doklady nemám poruke?',
    a: 'Nič sa nedeje. Vybavovanie kvôli tomu nezastavíme a s dohľadaním chýbajúcich dokladov vám pomôžeme neskôr.',
  },
  {
    q: 'Kto vypláca príspevok na pohreb a čo k nemu treba?',
    a: 'Príspevok na pohreb vo výške 200 eur vypláca Úrad práce, sociálnych vecí a rodiny na základe tlačiva Žiadosť o príspevok na pohreb. K žiadosti treba fotokópiu úmrtného listu, faktúru od pohrebnej služby a potvrdenie od pohrebnej služby. Žiadosť vyplníme a vybavíme za vás vrátane príloh. Vy nemusíte robiť nič. Od 1. januára 2027 je príspevok 250 eur (zákon č. 149/2026 Z. z.).',
  },
  {
    q: 'Do kedy musí byť pohreb?',
    a: 'Ak zosnulý nie je v chladiacom zariadení, pohreb musí byť do 96 hodín od úmrtia, nie však skôr ako po 24 hodinách. V chladiacom zariadení do 14 dní od úmrtia, v mraziacom do 30 dní od uloženia. Ak sa vykonala pitva, platia osobitné pravidlá. Určuje to zákon č. 131/2010 Z. z. o pohrebníctve, § 3. Termín s vami dohodneme tak, aby lehota platila.',
  },
  {
    q: 'Blízky zomrel v zahraničí. Čo mám robiť?',
    a: 'Príbuzných na Slovensku informuje veľvyslanectvo Slovenskej republiky v danej krajine. Prepravu zosnulého zo zahraničia zabezpečíme vrátane vybavenia všetkých potrebných dokumentov. Volajte +421 903 596 364.',
  },
  {
    q: 'Kde všade pôsobíte?',
    a: 'Máme tri pobočky: Poprad, Spišská Belá a Liptovský Mikuláš. Prevoz zosnulých zabezpečujeme nepretržite a prepravu vieme zariadiť aj zo zahraničia.',
  },
];

/* Dátum poslednej vecnej zmeny textu. Stránka nesie údaje, ktoré mení
   zákon (príspevok na pohreb 200 eur), a vyhľadávač aj AI asistent podľa
   dátumu posudzujú, či je informácia ešte platná. Preto je viditeľný pod
   nadpisom a zároveň v schema ako dateModified. Prepíš ho pri zmene faktov,
   pri zmene vzhľadu nie. Posledné fakty: stretnutie s klientom 3. 8. 2026. */
const AKTUALIZOVANE = { iso: '2026-11-10', text: '10. novembra 2026' };

const title = "Informácie pre pozostalých | Paciga, pohrebné a kamenárske služby";
const description = "Čo robiť pri úmrtí blízkeho doma, v nemocnici, za nejasných okolností alebo v zahraničí. Aké dokumenty pripraviť a ako požiadať o príspevok na pohreb. NON STOP 0903 596 364.";
const ogTitle = "Informácie pre pozostalých | Paciga";
const ogDescription = "Čo robiť, keď zomrie blízky človek. Pokojne a krok za krokom.";

const zaklad = Astro.site ?? Astro.url;
const strankaLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: new URL('/informacie-pre-pozostalych', zaklad).href,
  name: 'Čo robiť, keď zomrie blízky človek',
  description,
  inLanguage: 'sk-SK',
  dateModified: AKTUALIZOVANE.iso,
  isPartOf: { '@id': new URL('/', zaklad).href + '#web' },
  publisher: { '@id': new URL('/', zaklad).href + '#firma' },
};
---
<Base title={title} description={description} active="informacie-pre-pozostalych" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/info-hero.jpg">

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(strankaLd)} is:inline />
  </Fragment>



  <!-- ============ HLAVIČKA: newsroom band s fotkou ============ -->
  <section class="news-hero has-photo">
    <div class="nh-media" aria-hidden="true">
      <Image src={infoHero} widths={SIRKY_HERO} sizes="100vw" quality={KVALITA_POZADIE} alt="" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="container news-hero-inner">
      <div>
        <div class="eyebrow" data-reveal>Informácie pre pozostalých</div>
        <h1 data-textreveal>Čo robiť, keď zomrie<br>blízky človek</h1>
        <div class="clanok-meta" data-reveal>
          <span>Aktualizované <time datetime={AKTUALIZOVANE.iso}>{AKTUALIZOVANE.text}</time></span>
        </div>
      </div>
    </div>
    <div class="container news-hero-chips" data-reveal>
      <div class="situ-label">Kde nastalo úmrtie?</div>
      <div class="situ-row">
        <a href="#doma" class="situ-chip">Doma</a>
        <a href="#nemocnica" class="situ-chip">V nemocnici</a>
        <a href="#okolnosti" class="situ-chip">Za nejasných okolností</a>
        <a href="#zahranicie" class="situ-chip">V zahraničí</a>
      </div>
    </div>
  </section>

  <!-- ============ SITUAČNÝ ROZCESTNÍK ============ -->
  <!-- ============ PRVÉ KROKY ============ -->
  <section class="guide">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Prvé kroky podľa situácie</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>

      <div class="step" id="doma" data-reveal>
        <div class="step-num" aria-hidden="true">01</div>
        <div class="step-body">
          <h3>Úmrtie doma</h3>
          <p>Ihneď volajte tiesňovú linku 112. Operátor vyšle lekára na prehliadku. Lekár zistí príčinu, okolnosti a čas úmrtia, vypíše Potvrdenie o prehliadke mŕtveho tela a rozhodne, či je potrebná pitva.</p>
          <ul>
            <li>Ak lekár nariadi pitvu, prevoz na súdnolekárske pracovisko v Martine zabezpečíme my.</li>
            <li>Ak pitva nariadená nie je, zavolajte nám. Zosnulého s úctou prevezieme do chladiaceho zariadenia, pozri&#32;<a class="gold-link" href="/pohrebne-sluzby/prevoz-zosnulych">prevoz zosnulých NON STOP</a>.</li>
          </ul>
          <a href="tel:0903596364" class="step-tel">0903 596 364</a>
        </div>
        <IkonaKroku typ="dom" />
      </div>

      <div class="step" id="nemocnica" data-reveal>
        <div class="step-num" aria-hidden="true">02</div>
        <div class="step-body">
          <h3>Úmrtie v nemocnici</h3>
          <p>Poverený zamestnanec nemocnice vás bude kontaktovať a oznámi vám, či lekár nariadil pitvu. Prevoz na pitvu vykoná pohrebná služba zazmluvnená nemocnicou. Ďalšie služby si u nej objednávať nemusíte.</p>
          <ul>
            <li>Pohrebnú službu si vyberáte vy, podľa vlastného uváženia.</li>
            <li>Zavolajte nám a o všetko ostatné sa postaráme. Zosnulého uložíme v chladiacom zariadení alebo využijeme&#32;<a class="gold-link" href="/pohrebne-sluzby/prenosne-chladenie">prenosné chladenie</a>.</li>
          </ul>
          <a href="tel:0903596364" class="step-tel">0903 596 364</a>
        </div>
        <IkonaKroku typ="nemocnica" />
      </div>

      <div class="step" id="okolnosti" data-reveal>
        <div class="step-num" aria-hidden="true">03</div>
        <div class="step-body">
          <h3>Úmrtie za nejasných okolností</h3>
          <p>Volajte 112. Ak lekár nariadi súdnu pitvu, zosnulého treba previezť na pracovisko súdneho lekárstva v Martine. Na tieto prevozy máme uzatvorenú zmluvu s Úradom pre dohľad nad zdravotnou starostlivosťou, prevoz teda zabezpečíme my.</p>
          <ul>
            <li>Ani v tomto prípade nie ste povinní objednať si pohreb u služby, ktorá prevoz vykonala.</li>
            <li>Nenechajte sa ovplyvniť vo chvíli, keď ste najzraniteľnejší. Rozhodnite sa slobodne.</li>
          </ul>
          <a href="tel:0948110109" class="step-tel">0948 110 109</a>
        </div>
        <IkonaKroku typ="otaznik" />
      </div>

      <div class="step" id="zahranicie" data-reveal>
        <div class="step-num" aria-hidden="true">04</div>
        <div class="step-body">
          <h3>Úmrtie v zahraničí</h3>
          <p>Príbuzných na Slovensku informuje veľvyslanectvo Slovenskej republiky v danej krajine. <a class="gold-link" href="/pohrebne-sluzby/medzinarodny-prevoz">Prepravu zosnulého zo zahraničia</a>&#32;zabezpečíme vrátane vybavenia všetkých potrebných dokumentov.</p>
          <a href="tel:+421903596364" class="step-tel">+421 903 596 364</a>
        </div>
        <IkonaKroku typ="svet" />
      </div>

    </div>
  </section>

  <!-- ============ ČO SI PRIPRAVIŤ ============ -->
  <section class="firsts">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Čo si pripraviť na vybavenie pohrebu</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <div class="firsts-grid">
        <article class="first-card" data-reveal>
          <h3>Občiansky preukaz zosnulého</h3>
          <p>Základný doklad na vybavenie úmrtného listu a ďalších náležitostí.</p>
        </article>
        <article class="first-card" data-reveal>
          <h3>Váš občiansky preukaz</h3>
          <p>Doklad obstarávateľa pohrebu, teda osoby, ktorá rozlúčku vybavuje.</p>
        </article>
        <article class="first-card" data-reveal>
          <h3>Oblečenie pre zosnulého</h3>
          <p>Pre mužov spodná bielizeň, ponožky, topánky, košeľa, kravata a oblek. Pre ženy spodná bielizeň, pančuchy, topánky, blúzka, kostým a šatka. Ak vhodné nemáte, pozrite si&#32;<a class="gold-link" href="/pohrebne-sluzby/oblecenie-pre-zosnuleho">oblečenie pre zosnulého</a>.</p>
        </article>
      </div>
      <p class="firsts-note" data-reveal>Ak niektoré doklady nenájdete, nič sa nedeje. Pomôžeme vám ich vybaviť neskôr.</p>
    </div>
  </section>

  <!-- ============ PRÍSPEVOK NA POHREB ============ -->
  <section class="guide">
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Príspevok na pohreb</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <div class="step" data-reveal>
        <div class="step-num" aria-hidden="true">€</div>
        <div class="step-body">
          <h3>Štátna sociálna dávka 200 eur</h3>
          <p>Príspevok na pohreb vo výške 200 eur vypláca Úrad práce, sociálnych vecí a rodiny na základe tlačiva Žiadosť o príspevok na pohreb. K žiadosti treba:</p>
          <ul>
            <li>Fotokópiu úmrtného listu.</li>
            <li>Faktúru od pohrebnej služby.</li>
            <li>Potvrdenie od pohrebnej služby.</li>
          </ul>
          <p class="step-note">Žiadosť vyplníme a vybavíme za vás vrátane všetkých príloh. Vy nemusíte robiť nič.</p>
          <p class="step-note">Od 1. januára 2027 je príspevok 250 eur (zákon č.&nbsp;149/2026 Z.&nbsp;z.).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ČASTÉ OTÁZKY ============ -->
  <section class="faq-section">
    <div class="container">
      <Faq items={otazky} eyebrow="Časté otázky" heading="Na čo sa nás pýtate najčastejšie"
        note="Nenašli ste svoju otázku? Zavolajte nám na 0903 596 364. Poradíme vám aj v prípade, že si nás nakoniec nevyberiete." />
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-band">
    <div class="cta-inner">
      <h2 data-textreveal>Nie ste na to sami</h2>
      <p data-reveal>Jeden telefonát stačí. Poradíme vám, čo ďalej, a všetko potrebné vybavíme za vás.</p>
      <a href="tel:0903596364" class="btn-gold btn-lg" data-reveal>NON STOP · 0903 596 364</a>
      <p data-reveal>
        Osobne nás nájdete na pobočkách&#32;
        <a class="gold-link" href="/poprad">Pohrebné služby Poprad</a>,&#32;
        <a class="gold-link" href="/spisska-bela">Pohrebné služby Spišská Belá</a> a&#32;
        <a class="gold-link" href="/liptovsky-mikulas">Pohrebné služby Liptovský Mikuláš</a>. Všetky čísla a adresy sú na stránke&#32;<a class="gold-link" href="/kontakt">Kontakt</a>.
      </p>
    </div>
  </section>

  <!-- ============ PLÁVAJÚCA NON STOP LIŠTA ============ -->
  <div class="callbar" id="callbar" role="complementary" aria-label="NON STOP kontakt">
    <div class="container callbar-inner">
      <span class="callbar-label">NON STOP prevoz zosnulých</span>
      <a href="tel:0903596364" class="callbar-tel"><span class="dot" aria-hidden="true"></span>0903 596 364</a>
    </div>
  </div>

<Fragment slot="scripts">
<script is:inline>
(function () {
  var bar = document.getElementById('callbar');
  if (!bar) return;
  var shown = false;
  function check() {
    var on = (window.scrollY || window.pageYOffset) > 500;
    if (on !== shown) { shown = on; bar.classList.toggle('on', on); }
  }
  window.addEventListener('scroll', check, { passive: true });
  check();
})();
</script>
</Fragment>
</Base>
