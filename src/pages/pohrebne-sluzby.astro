---
import Base from '../layouts/Base.astro';
import Ui21 from '../components/Ui21.astro';
import { OfferCarousel, type KartaSluzby } from '../components/ui/offer-carousel';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SIRKY_HERO, KVALITA_POZADIE, KVALITA_KARTA } from '../lib/images';
import sluzbyHero from '../assets/sluzby-hero.jpg';
import limuzina from '../assets/o-nas-limuzina.jpg';
import fc01 from '../assets/asset-01.jpg';
import fc04 from '../assets/asset-04.jpg';
import rakvyFoto from '../assets/svc-rakvy.jpg';
import veniecFoto from '../assets/svc-starostlivost.jpg';
import kamenFoto from '../assets/svc-kamenarstvo.jpg';
import kremaciaFoto from '../assets/svc-kremacia.jpg';
import predpripravaFoto from '../assets/interier-lm.jpg';
import sperkyFoto from '../assets/svc-sperky-odtlacok.jpg';
import oblecenieFoto from '../assets/svc-oblecenie.jpg';
import kartyFoto from '../assets/svc-karty.jpg';
import medzFoto from '../assets/svc-medzinarodny-prevoz.jpg';
import limuzinaFoto from '../assets/svc-limuzina.jpg';
import chladenieFoto from '../assets/svc-chladenie.jpg';
import vizualizaciaFoto from '../assets/svc-3d-vizualizacia.jpg';
import poradenstvoFoto from '../assets/svc-poradenstvo.jpg';

const title = "Pohrebné služby | Paciga, pohrebné a kamenárske služby";
const description = "Kompletné pohrebné služby Paciga: rakvy, obrad, kremácia, prevoz zosnulých NON STOP, kvetinárstvo, kamenárstvo, spomienkové šperky. Poprad, Spišská Belá, Liptovský Mikuláš.";
const ogTitle = "Pohrebné služby | Paciga";
const ogDescription = "Pätnásť služieb pod jednou strechou. Od prvého telefonátu po žulový pomník.";

/* Fotky pre karty karuselu: karta je 330 px, fotka ~330×226; 660 px pokryje DPR 2.
   Ostrov dostáva hotové URL, astro:assets ostáva jediná obrázková cesta. */
const fotoKarty = async (img: ImageMetadata) =>
  (await getImage({ src: img, width: 660, quality: KVALITA_KARTA, format: 'webp' })).src;

const [fRakva, fObrad, fKremacia, fVeniec, fOblecenie, fKarty, fPrevoz, fMedz, fLimo, fChladenie, fKamen, fVizualizacia, fPoradenstvo, fPredpriprava, fSperk] =
  await Promise.all([
    fotoKarty(rakvyFoto),
    fotoKarty(fc01),
    fotoKarty(kremaciaFoto),
    fotoKarty(veniecFoto),
    fotoKarty(oblecenieFoto),
    fotoKarty(kartyFoto),
    fotoKarty(fc04),
    fotoKarty(medzFoto),
    fotoKarty(limuzinaFoto),
    fotoKarty(chladenieFoto),
    fotoKarty(kamenFoto),
    fotoKarty(vizualizaciaFoto),
    fotoKarty(poradenstvoFoto),
    fotoKarty(predpripravaFoto),
    fotoKarty(sperkyFoto),
  ]);

const skupinaObrad: KartaSluzby[] = [
  { id: 'rakvy', foto: fRakva, tag: 'Rozlúčka a obrad', nazov: 'Rakvy', popis: 'Dvadsať prevedení od svetlého dreva po mahagón. V showroome v Poprade si ich pozriete naživo.', cislo: '01', fakt: '20 prevedení', href: '/pohrebne-sluzby/rakvy' },
  { id: 'rozlucka', foto: fObrad, tag: 'Rozlúčka a obrad', nazov: 'Rozlúčka a pochovanie', popis: 'Kompletné zabezpečenie obradu vrátane prípravy miesta, výzdoby a organizácie celého priebehu.', cislo: '02', fakt: 'kompletný obrad', href: '/pohrebne-sluzby/rozlucka-a-pochovanie' },
  { id: 'kremacia', foto: fKremacia, tag: 'Rozlúčka a obrad', nazov: 'Kremácia s obradom alebo bez', popis: 'Možnosť rozlúčky, ktorá rešpektuje želania zosnulého aj pozostalých. Poradíme vám s výberom.', cislo: '03', fakt: 'poradíme s výberom', href: '/pohrebne-sluzby/kremacia' },
  { id: 'kvetinarstvo', foto: fVeniec, tag: 'Rozlúčka a obrad', nazov: 'Kvetinárstvo', popis: 'Vence, kytice a kvetinová výzdoba obradu. Osemdesiatjeden prevedení v katalógu.', cislo: '04', fakt: '81 prevedení', href: '/pohrebne-sluzby/kvetinarstvo' },
  { id: 'oblecenie', foto: fOblecenie, tag: 'Rozlúčka a obrad', nazov: 'Oblečenie pre zosnulého', popis: 'Dôstojné oblečenie a úprava zosnulého. Súčasť rozlúčky, ktorá odráža rešpekt a úctu.', cislo: '05', fakt: 'rešpekt a úcta', href: '/pohrebne-sluzby/oblecenie-pre-zosnuleho' },
  { id: 'karty', foto: fKarty, tag: 'Rozlúčka a obrad', nazov: 'Spomienkové karty', popis: 'Jedinečný spôsob, ako si uctiť pamiatku zosnulého a zdieľať spomienku s rodinou a blízkymi.', cislo: '06', fakt: 'spomienka pre rodinu', href: '/pohrebne-sluzby/spomienkove-karty' },
];

const skupinaPrevoz: KartaSluzby[] = [
  { id: 'prevoz', foto: fPrevoz, tag: 'Prevoz a technológie', nazov: 'Prevoz zosnulých NON STOP', popis: 'Dôstojný a rýchly prevoz z bytov a nemocníc, 24 hodín denne. Dbáme na hygienické aj právne predpisy.', cislo: '07', fakt: '24 hodín denne', href: '/pohrebne-sluzby/prevoz-zosnulych' },
  { id: 'medzinarodny-prevoz', foto: fMedz, tag: 'Prevoz a technológie', nazov: 'Medzinárodný prevoz', popis: 'Preprava zosnulých zo zahraničia vrátane vybavenia všetkých dokumentov. Ako prví v regióne.', cislo: '08', fakt: 'prví v regióne', href: '/pohrebne-sluzby/medzinarodny-prevoz' },
  { id: 'pohrebna-limuzina', foto: fLimo, tag: 'Prevoz a technológie', nazov: 'Pohrebná limuzína', popis: 'Mercedes-Benz E 400, ocenený ako najkrajšia pohrebná limuzína na Slovensku za rok 2024.', cislo: '09', fakt: 'ocenená 2024', href: '/pohrebne-sluzby/pohrebna-limuzina' },
  { id: 'chladenie', foto: fChladenie, tag: 'Prevoz a technológie', nazov: 'Prenosné chladenie', popis: 'Vlastná technológia, ktorú sme ako prví predstavili na výstave Slovak Funeral. Umožňuje dôstojnú rozlúčku aj doma.', cislo: '10', fakt: 'rozlúčka aj doma', href: '/pohrebne-sluzby/prenosne-chladenie' },
];

const skupinaKamen: KartaSluzby[] = [
  { id: 'kamenarstvo', foto: fKamen, tag: 'Kamenárstvo', nazov: 'Kamenárske práce', popis: 'Výroba betónových hrobiek, predaj a montáž žulových pomníkov, písmo aj doplnky. Od výkopu po hotový pomník.', cislo: '11', fakt: 'od výkopu po pomník', href: '/kamenarstvo' },
  { id: 'vizualizacia', foto: fVizualizacia, tag: 'Kamenárstvo', nazov: '3D vizualizácia pomníka', popis: 'Pomník uvidíte ešte pred výrobou. Ako prví v regióne pripravíme presnú 3D vizualizáciu.', cislo: '12', fakt: 'návrh pred výrobou', href: '/kamenarstvo#navrh' },
];

const skupinaPodpora: KartaSluzby[] = [
  { id: 'poradenstvo', foto: fPoradenstvo, tag: 'Podpora a spomienka', nazov: 'Smútkové poradenstvo', popis: 'Strata blízkeho je jedna z najťažších skúseností. Sprevádzame vás procesom smútenia, nie ste v tom sami.', cislo: '13', fakt: 'nie ste v tom sami', href: '/pohrebne-sluzby/smutkove-poradenstvo' },
  { id: 'predpriprava', foto: fPredpriprava, tag: 'Podpora a spomienka', nazov: 'Predpríprava pohrebu', popis: 'Naplánujte si poslednú rozlúčku vopred podľa vlastných predstáv a odbremeňte svojich blízkych.', cislo: '14', fakt: 'odbremení blízkych', href: '/pohrebne-sluzby/predpriprava-pohrebu' },
  { id: 'sperky', foto: fSperk, tag: 'Podpora a spomienka', nazov: 'Spomienkové šperky s odtlačkom', popis: 'Náramky a retiazky s gravírovaným odtlačkom prsta. Kúsok blízkeho človeka navždy pri vás.', cislo: '15', fakt: 'gravírovaný odtlačok', href: '/sperky' },
];
---
<Base title={title} description={description} active="pohrebne-sluzby" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/sluzby-hero.jpg">



  <!-- ============ HLAVIČKA: newsroom band s fotkou ============ -->
  <section class="news-hero has-photo">
    <div class="nh-media" aria-hidden="true">
      <Image src={sluzbyHero} widths={SIRKY_HERO} sizes="100vw" quality={KVALITA_POZADIE} alt="" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="container news-hero-inner">
      <div>
        <div class="eyebrow" data-reveal>Pohrebné služby</div>
        <h1 data-textreveal>Od prvého telefonátu<br>po poslednú rozlúčku.</h1>
      </div>
    </div>
    <div class="container news-hero-chips" data-reveal>
      <div class="situ-label">Čo potrebujete vybaviť?</div>
      <div class="situ-row">
        <a href="#skupina-obrad" class="situ-chip">Rozlúčka a obrad</a>
        <a href="#skupina-prevoz" class="situ-chip">Prevoz a technológie</a>
        <a href="#skupina-kamenarstvo" class="situ-chip">Kamenárstvo</a>
        <a href="#skupina-podpora" class="situ-chip">Podpora a spomienka</a>
        <a href="#limuzina" class="situ-chip">Smútočná limuzína</a>
      </div>
    </div>
  </section>

  <!-- ============ ROZCESTNÍK SKUPÍN ============ -->
  <!-- ============ SKUPINY SLUŽIEB ============ -->
  <section class="svcgroups">
    <div class="container">

      <div class="svcgroup" id="skupina-obrad">
        <div class="svcgroup-head">
          <h2 data-textreveal>Rozlúčka a obrad</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <div data-reveal>
          <Ui21>
            <OfferCarousel client:visible polozky={skupinaObrad} />
          </Ui21>
        </div>
      </div>

      <div class="svcgroup" id="skupina-prevoz">
        <div class="svcgroup-head">
          <h2 data-textreveal>Prevoz a technológie</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <div data-reveal>
          <Ui21>
            <OfferCarousel client:visible polozky={skupinaPrevoz} />
          </Ui21>
        </div>
      </div>

      <div class="svcgroup" id="skupina-kamenarstvo">
        <div class="svcgroup-head">
          <h2 data-textreveal>Kamenárstvo</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <div data-reveal>
          <Ui21>
            <OfferCarousel client:visible polozky={skupinaKamen} />
          </Ui21>
        </div>
      </div>

      <div class="svcgroup" id="skupina-podpora">
        <div class="svcgroup-head">
          <h2 data-textreveal>Podpora a spomienka</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <div data-reveal>
          <Ui21>
            <OfferCarousel client:visible polozky={skupinaPodpora} />
          </Ui21>
        </div>
      </div>

    </div>
  </section>

  <!-- ============ LIMUZÍNA ============ -->
  <section class="fleetband" id="limuzina">
    <div class="fleetband-media" aria-hidden="true">
      <Image src={limuzina} widths={SIRKY_HERO} sizes="100vw" quality={KVALITA_POZADIE} alt="" loading="lazy" decoding="async" />
      <div class="fleetband-shade"></div>
    </div>
    <div class="container fleetband-content">
      <div class="eyebrow" data-reveal>Flotila</div>
      <h2 data-textreveal>Pohrebná limuzína</h2>
      <p data-reveal>Ocenená ako najkrajšia na Slovensku. Elegancia a dôstojnosť na poslednej ceste, za každého počasia.</p>
      <p data-reveal><a class="btn-line" href="/pohrebne-sluzby/pohrebna-limuzina">Pozrieť flotilu →</a></p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-band">
    <div class="cta-inner">
      <h2 data-textreveal>Nemusíte vybavovať nič sami</h2>
      <p data-reveal>Zavolajte kedykoľvek. Poradíme, prevezmeme a s úctou zabezpečíme všetko potrebné.</p>
      <a href="tel:0903596364" class="btn-gold btn-lg" data-reveal>NON STOP · 0903 596 364</a>
    </div>
  </section>

  <!-- ============ PLÁVAJÚCA NON STOP LIŠTA ============ -->
  <div class="callbar" id="callbar" role="complementary" aria-label="NON STOP kontakt">
    <div class="container callbar-inner">
      <span class="callbar-label">NON STOP prevoz zosnulých</span>
      <a href="tel:0903596364" class="callbar-tel"><span class="dot" aria-hidden="true"></span>0903 596 364</a>
    </div>
  </div>

<Fragment slot="scripts">
<script is:inline>
(function () {
  var bar = document.getElementById('callbar');
  if (bar) {
    var shown = false;
    var check = function () {
      var on = (window.scrollY || window.pageYOffset) > 500;
      if (on !== shown) { shown = on; bar.classList.toggle('on', on); }
    };
    window.addEventListener('scroll', check, { passive: true });
    check();
  }

})();
</script>
</Fragment>
</Base>
