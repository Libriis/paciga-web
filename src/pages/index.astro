---
import Base from '../layouts/Base.astro';
import { getParteList, inicialky, fmtKratky } from '../lib/parte';
import { RECENZIE, VYBER, GOOGLE_PROFIL } from '../data/recenzie';

export const prerender = false;

const parteList = (await getParteList()).slice(0, 4);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const title = "Paciga | Pohrebné a kamenárske služby | NON STOP 24/7";
const description = "Pohrebné a kamenárske služby Paciga v Poprade, Spišskej Belej a Liptovskom Mikuláši. NON STOP prevoz zosnulých 24 hodín denne. Volajte 0903 596 364.";
const ogTitle = "Paciga | Pohrebné a kamenárske služby";
const ogDescription = "Dôstojná rozlúčka za každých okolností. NON STOP prevoz zosnulých, volajte 0903 596 364.";
---
<Base title={title} description={description} active="domov" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/asset-07.jpg" mainId="paci" journey>



  <!-- ============ POSLEDNÁ CESTA (scrollovaná filmová jazda — frame scrub) ============ -->
  <section class="journey" id="hero">
    <div class="journey-pin" id="journey-pin">
      <img class="journey-poster" id="journey-poster" src="/assets/journey-poster.jpg" alt="Flotila vozidiel Paciga v rannej hmle pod Vysokými Tatrami" fetchpriority="high" decoding="async">
      <canvas id="journey-canvas" aria-hidden="true"
        data-frames="1110" data-path="assets/journey/f-&#123;i&#125;.webp"
        data-frames-m="555" data-path-m="assets/journey-m/f-&#123;i&#125;.webp"></canvas>
      <div class="journey-shade" aria-hidden="true"></div>

      <!-- HUD: stanice cesty (klikateľné kapitoly) -->
      <div class="journey-hud">
        <span class="jh-line" aria-hidden="true"><i id="jh-fill"></i></span>
        <button type="button" class="jh-station" data-station="0" aria-label="Prejsť na kapitolu Rozlúčka">Rozlúčka</button>
        <button type="button" class="jh-station" data-station="1" aria-label="Prejsť na kapitolu Cesta">Cesta</button>
        <button type="button" class="jh-station" data-station="2" aria-label="Prejsť na kapitolu Starostlivosť">Starostlivosť</button>
        <button type="button" class="jh-station" data-station="3" aria-label="Prejsť na kapitolu Spomienka">Spomienka</button>
        <button type="button" class="jh-station" data-station="4" aria-label="Prejsť na kapitolu Svetlo">Svetlo</button>
      </div>
      <button type="button" class="journey-skip" id="journey-skip">Preskočiť príbeh</button>

      <!-- texty staníc (pinované nad canvasom) -->
      <div class="journey-text jt-hero" data-jt="0">
        <div class="container">
          <div class="eyebrow" data-hero-el>Rodinná pohrebná a kamenárska služba · od 2018</div>
          <h1 id="hero-title"><span class="line"><span>Dôstojná rozlúčka</span></span><span class="line"><span>za&nbsp;každých okolností.</span></span></h1>
          <p class="hero-lead" data-hero-el>Pohrebné obrady, preprava a kamenárstvo. Sme pri vás nepretržite, každý deň v roku.</p>
          <div class="hero-actions" data-hero-el>
            <a href="tel:0903596364" class="btn-gold">NON STOP · 0903 596 364</a>
            <a href="#sluzby" class="link-underline">Naše služby →</a>
          </div>
        </div>
      </div>
      <div class="journey-text jt-mid" data-jt="1">
        <h2>Zavolajte v&nbsp;ktorúkoľvek hodinu.</h2>
        <p>Prevoz zosnulého, dokumenty aj celý obrad vybavíme za vás. Aj v noci, aj cez sviatky.</p>
        <a href="tel:0903596364" class="jt-phone">0903 596 364</a>
      </div>
      <div class="journey-text jt-mid" data-jt="2">
        <div class="badge-pill"><span>Ocenená ako najkrajšia na Slovensku</span></div>
        <h2>Pohrebná limuzína,<br>ktorá vzdáva úctu</h2>
      </div>
      <div class="journey-text jt-mid" data-jt="3">
        <h2>Kompletná starostlivosť<br>pod jednou strechou</h2>
        <p>Obrad a pochovanie, kremácia, kvetinová výzdoba, spomienkové predmety aj kamenárstvo.</p>
      </div>
      <div class="journey-text jt-mid" data-jt="4">
        <h2>„Nikdy nezabudnem.“</h2>
        <p>Spomienkové šperky s odtlačkom prsta. Kúsok blízkeho človeka navždy.</p>
      </div>
      <div class="journey-text jt-mid" data-jt="5">
        <h2>Sme z&nbsp;tohto kraja.<br>A&nbsp;sme tu pre vás.</h2>
        <p>Poprad, Spišská Belá a Liptovský Mikuláš</p>
        <a href="tel:0903596364" class="btn-gold jt-cta">NON STOP · 0903 596 364</a>
      </div>
    </div>

    <!-- reduced-motion / no-JS: kľúčové zábery pod sebou -->
    <div class="journey-fallback" aria-hidden="true">
      <img src="/assets/journey-poster.jpg" alt="" loading="lazy">
    </div>
  </section>

  <!-- ============ ČO SPRAVIŤ AKO PRVÉ (krízová dráha) ============
       Pilotná utility-first sekcia (Tailwind v4, tokeny z tw.css). -->
  <section class="firststeps bg-ink2 border-y border-solid border-line py-[clamp(120px,16vh,200px)]" id="prve-kroky">
    <div class="container">
      <div>
        <h2 class="text-[clamp(28px,3.6vw,46px)]" data-textreveal>Čo spraviť ako prvé</h2>
        <p class="mt-3 text-soft text-[18.6px]" data-textreveal>Tri kroky. O všetko ostatné sa postaráme my.</p>
      </div>
      <!-- tracing beam: svetelná linka spája kroky 01 → 03 pri scrolle -->
      <div class="fs-beam" aria-hidden="true">
        <i id="fs-beam-fill"></i>
        <span class="fs-beam-dot" style="left:0%"></span>
        <span class="fs-beam-dot" style="left:33.75%"></span>
        <span class="fs-beam-dot" style="left:67.5%"></span>
      </div>
      <ol class="list-none grid grid-cols-1 gap-[30px] min-[861px]:grid-cols-3 min-[861px]:gap-[clamp(28px,3vw,48px)] mt-[clamp(40px,6vh,64px)] min-[861px]:mt-0">
        <li class="border-t border-solid border-line pt-[22px]" data-reveal>
          <span class="text-[13px] font-[650] tracking-[0.14em] text-gold">01</span>
          <h3 class="mt-[14px] text-[21px]">Zavolajte nám</h3>
          <p class="mt-[10px] text-soft text-[17.4px] leading-[1.65]">Kedykoľvek, aj v noci a cez sviatky. Sme na linke nepretržite.</p>
          <a class="inline-block mt-[14px] text-[clamp(22px,2.2vw,28px)] font-[680] text-gold [font-variation-settings:var(--wide)] transition-colors duration-300 hover:text-soft" href="tel:0903596364">0903 596 364</a>
        </li>
        <li class="border-t border-solid border-line pt-[22px]" data-reveal>
          <span class="text-[13px] font-[650] tracking-[0.14em] text-gold">02</span>
          <h3 class="mt-[14px] text-[21px]">My prídeme k vám</h3>
          <p class="mt-[10px] text-soft text-[17.4px] leading-[1.65]">Zabezpečíme dôstojný prevoz zosnulého. Doma, v nemocnici aj v zariadení.</p>
        </li>
        <li class="border-t border-solid border-line pt-[22px]" data-reveal>
          <span class="text-[13px] font-[650] tracking-[0.14em] text-gold">03</span>
          <h3 class="mt-[14px] text-[21px]">Ostatné vybavíme spolu</h3>
          <p class="mt-[10px] text-soft text-[17.4px] leading-[1.65]">Dokumenty, obrad, kvety aj oznámenia. Prevedieme vás krok za krokom.</p>
        </li>
      </ol>
      <a class="inline-block mt-[clamp(36px,5vh,54px)] text-[17.4px] text-soft border-b border-solid border-line pb-[3px] transition-colors duration-300 hover:text-snow" href="/informacie-pre-pozostalych" data-reveal>Podrobný sprievodca pre pozostalých →</a>
    </div>
  </section>

  <!-- ============ QUOTE (scrub word reveal) ============ -->
  <section class="quote" id="quote">
    <div class="orb" style="top:-20%;right:-12%" aria-hidden="true"></div>
    <div class="container quote-inner">
      <div class="quote-mark" aria-hidden="true">“</div>
      <p id="quote-text">{VYBER.fontaniOpora}</p>
      <div class="quote-author" data-reveal>{RECENZIE.fontani.meno} · recenzia Google</div>
      <div class="quote-badge" data-reveal><span class="stars" aria-hidden="true">★★★★★</span><span>Hodnotenie rodín na Google</span></div>
    </div>
  </section>

  <!-- ============ NONSTOP callout ============ -->
  <section class="nonstop">
    <div class="container nonstop-inner">
      <div class="nonstop-left">
        <div class="gold-rule" data-line aria-hidden="true"></div>
        <div>
          <div class="nonstop-title" data-reveal>Potrebujete pomôcť práve teraz?</div>
          <div class="nonstop-sub" data-reveal>NON STOP prevoz zosnulých. Sme pri vás v ktorúkoľvek hodinu, aj v noci a cez víkendy.</div>
        </div>
      </div>
      <div class="nonstop-right" data-reveal>
        <span class="micro-label">NON STOP LINKA</span>
        <a href="tel:0903596364" class="phone-primary">0903 596 364</a>
        <a href="tel:0948110109" class="phone-secondary">0948 110 109</a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES (register: kapitoly zvislo, služby ako riadky) ============ -->
  <section id="sluzby" class="register">
    <div class="orb" style="top:4%;right:-12%" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow" data-reveal>Čo pre vás zabezpečíme</div>
        <h2 data-textreveal>Kompletná starostlivosť<br>pod jednou strechou</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>

      <div class="reg-group" data-reveal>
        <div class="reg-side">
          <div class="reg-kap">Kapitola I</div>
          <h3>Obrad a preprava</h3>
          <p>Od prvého telefonátu po dôstojnú rozlúčku.</p>
        </div>
        <div class="reg-list">
          <a class="reg-row" href="/pohrebne-sluzby#rakvy"><span class="reg-num">01</span><span class="reg-name">Rakvy</span><span class="reg-desc">Široký výber elegantných rakiev z prvotriednych materiálov.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#limuzina"><span class="reg-num">02</span><span class="reg-name">Pohrebná limuzína</span><span class="reg-desc">Exkluzívna limuzína, ocenená ako najkrajšia na Slovensku.</span><span class="reg-go" aria-hidden="true">→</span><span class="reg-thumb" style="background-image:url('/assets/asset-06.jpg')" aria-hidden="true"></span></a>
          <a class="reg-row" href="/pohrebne-sluzby#chladenie"><span class="reg-num">03</span><span class="reg-name">Prenosné chladenie</span><span class="reg-desc">Špeciálna technológia chladenia priamo u vás.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#rozlucka"><span class="reg-num">04</span><span class="reg-name">Rozlúčka a pochovanie</span><span class="reg-desc">Kompletné zabezpečenie obradu aj organizácie.</span><span class="reg-go" aria-hidden="true">→</span><span class="reg-thumb" style="background-image:url('/assets/asset-01.jpg')" aria-hidden="true"></span></a>
          <a class="reg-row" href="/pohrebne-sluzby#prevoz"><span class="reg-num">05</span><span class="reg-name">Prevoz zosnulých</span><span class="reg-desc">NON STOP dôstojný a rýchly prevoz z bytov a nemocníc.</span><span class="reg-go" aria-hidden="true">→</span><span class="reg-thumb" style="background-image:url('/assets/asset-04.jpg')" aria-hidden="true"></span></a>
          <a class="reg-row" href="/pohrebne-sluzby#kremacia"><span class="reg-num">06</span><span class="reg-name">Kremácia</span><span class="reg-desc">S obradom alebo bez, s rešpektom k želaniam zosnulého aj pozostalých.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#medzinarodny-prevoz"><span class="reg-num">07</span><span class="reg-name">Medzinárodný prevoz</span><span class="reg-desc">Preprava zo zahraničia vrátane vybavenia dokumentov.</span><span class="reg-go" aria-hidden="true">→</span><span class="reg-thumb" style="background-image:url('/assets/asset-09.jpg')" aria-hidden="true"></span></a>
        </div>
      </div>

      <div class="reg-group" data-reveal>
        <div class="reg-side">
          <div class="reg-kap">Kapitola II</div>
          <h3>Starostlivosť o pozostalých</h3>
          <p>Čo pomáha niesť smútok: kvety, spomienky, podpora.</p>
        </div>
        <div class="reg-list">
          <a class="reg-row" href="/pohrebne-sluzby#kvetinarstvo"><span class="reg-num">08</span><span class="reg-name">Kvetinárstvo</span><span class="reg-desc">Vlastná výroba kytíc, vencov a smútočnej výzdoby.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#predpriprava"><span class="reg-num">09</span><span class="reg-name">Predpríprava pohrebu</span><span class="reg-desc">Naplánujte rozlúčku vopred a odbremeňte blízkych.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#karty"><span class="reg-num">10</span><span class="reg-name">Spomienkové karty</span><span class="reg-desc">Uctenie pamiatky a zdieľanie odkazu s rodinou.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#oblecenie"><span class="reg-num">11</span><span class="reg-name">Oblečenie pre zosnulého</span><span class="reg-desc">Kompletné sady oblečenia, s rešpektom a úctou.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#poradenstvo"><span class="reg-num">12</span><span class="reg-name">Smútkové poradenstvo</span><span class="reg-desc">Podpora a sprevádzanie v procese smútenia.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/sperky"><span class="reg-num">13</span><span class="reg-name">Spomienkové šperky</span><span class="reg-desc">Náramky a retiazky s odtlačkom prsta zosnulého.</span><span class="reg-go" aria-hidden="true">→</span><span class="reg-thumb" style="background-image:url('/assets/asset-08.jpg')" aria-hidden="true"></span></a>
        </div>
      </div>

      <div class="reg-group" id="kamenarstvo" data-reveal>
        <div class="reg-side">
          <div class="reg-kap">Kapitola III</div>
          <h3>Kamenárstvo</h3>
          <p>Spomienka vytesaná do žuly.</p>
        </div>
        <div class="reg-list">
          <a class="reg-row" href="/pohrebne-sluzby#kamenarstvo"><span class="reg-num">14</span><span class="reg-name">Kamenárstvo</span><span class="reg-desc">Hrobky, žulové pomníky, montáž a rekonštrukcie.</span><span class="reg-go" aria-hidden="true">→</span></a>
          <a class="reg-row" href="/pohrebne-sluzby#vizualizacia"><span class="reg-num">15</span><span class="reg-name">3D vizualizácia pomníka</span><span class="reg-desc">Uvidíte výsledok ešte pred samotnou výrobou.</span><span class="reg-go" aria-hidden="true">→</span></a>
        </div>
      </div>

    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats">
    <div class="container stats-grid">
      <div class="stat" data-reveal>
        <div class="stat-num"><span data-count="8">0</span></div>
        <div class="stat-label">rokov pri rodinách · s vami od roku 2018</div>
      </div>
      <div class="stat" data-reveal>
        <div class="stat-num"><span data-count="3">0</span></div>
        <div class="stat-label">pobočky: Poprad, Spišská Belá a Liptovský Mikuláš</div>
      </div>
      <div class="stat" data-reveal>
        <div class="stat-num">24/7</div>
        <div class="stat-label">NON STOP prevoz zosnulých</div>
      </div>
    </div>
  </section>

  <!-- ============ POBOCKY ============ -->
  <section id="pobocky" class="branches">
    <div class="orb" style="top:-16%;left:30%" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Tri pobočky, jedna rodina</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      <div class="branch-grid">
        <article class="branch-card" data-reveal>
          <div class="branch-photo" data-parallax><span><video class="scene-video" src="/assets/town-poprad.mp4" poster="/assets/asset-03.jpg" muted loop playsinline preload="none" aria-hidden="true"></video></span></div>
          <div class="branch-body">
            <h3>Poprad</h3>
            <p class="branch-addr">Francisciho 3288/35<br>058 01 Poprad</p>
            <a class="branch-tel" href="tel:0903596364">0903 596 364</a>
            <p class="branch-hours">NON STOP prevoz zosnulých · 24/7</p>
            <a class="link-underline gold" href="https://www.google.com/maps?q=Francisciho%203288%2F35%2C%20058%2001%20Poprad" target="_blank" rel="noopener">Zobraziť na mape →</a>
          </div>
        </article>
        <article class="branch-card" data-reveal>
          <div class="branch-photo" data-parallax><span><video class="scene-video" src="/assets/town-bela.mp4" poster="/assets/asset-10.jpg" muted loop playsinline preload="none" aria-hidden="true"></video></span></div>
          <div class="branch-body">
            <h3>Spišská Belá</h3>
            <p class="branch-addr">Letná 17<br>059 01 Spišská Belá</p>
            <a class="branch-tel" href="tel:0948110109">0948 110 109</a>
            <p class="branch-hours">Sídlo firmy · NON STOP prevoz 24/7</p>
            <a class="link-underline gold" href="https://www.google.com/maps?q=Letn%C3%A1%2017%2C%20059%2001%20Spi%C5%A1sk%C3%A1%20Bel%C3%A1" target="_blank" rel="noopener">Zobraziť na mape →</a>
          </div>
        </article>
        <article class="branch-card" data-reveal>
          <div class="branch-photo" data-parallax><span><video class="scene-video" src="/assets/town-lm.mp4" poster="/assets/asset-11.jpg" muted loop playsinline preload="none" aria-hidden="true"></video></span></div>
          <div class="branch-body">
            <h3>Liptovský Mikuláš</h3>
            <p class="branch-addr">Ester Šimerovej Martinčekovej 4506/4<br>031 01 Liptovský Mikuláš</p>
            <a class="branch-tel" href="tel:0903596364">0903 596 364</a>
            <p class="branch-hours">NON STOP prevoz zosnulých · 24/7</p>
            <a class="link-underline gold" href="https://www.google.com/maps?q=Ester%20%C5%A0imerovej%20Martin%C4%8Dekovej%204506%2F4%2C%20031%2001%20Liptovsk%C3%BD%20Mikul%C3%A1%C5%A1" target="_blank" rel="noopener">Zobraziť na mape →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ OPUSTILI NAS ============ -->
  <section id="opustili" class="memoriam">
    <div class="orb" style="bottom:-18%;left:-14%" aria-hidden="true"></div>
    <div class="container">
      <div class="memoriam-head">
        <div>
          <h2 data-textreveal>Opustili nás</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <a href="/opustili-nas" class="link-underline gold" data-reveal>Všetky spomienky →</a>
      </div>
      <div class="memoriam-grid">
        {parteList.map((p) => (
          <div class="memoriam-card" data-reveal data-slug={p.slug}>
            <div class="memoriam-photo" aria-hidden="true">{p.foto_url
              ? <img src={p.foto_url} alt="" loading="lazy" decoding="async" />
              : <span>{inicialky(p.meno)}</span>}</div>
            <h3>{p.meno}</h3>
            <div class="memoriam-date">† {fmtKratky(p.datum_umrtia)}</div>
            <div class="memoriam-candle" aria-hidden="true"><i class="flame"></i></div><div class="memoriam-links"><button type="button" class="gold-link candle-btn">Zapáliť sviečku<span class="candle-count">{p.sviecky > 0 ? ` · ${p.sviecky}` : ''}</span></button><a href={`/parte/${p.slug}`} class="soft-link">Kondolencia</a></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ RECENZIE (svetlá sekcia) ============ -->
  <section class="reviews" id="recenzie">
    <div class="container">
      <div class="reviews-head">
        <div class="stars" aria-hidden="true">★★★★★</div>
        <h2 data-textreveal>Skutočné rodiny. Skutočné slová.</h2>
        <p data-textreveal>Recenzie z profilu Google.</p>
      </div>
      <div class="reviews-grid">
        <blockquote class="review" data-reveal>
          <p>„{VYBER.harbinRozlucka}“</p>
          <footer>{RECENZIE.harbin.meno}</footer>
        </blockquote>
        <blockquote class="review" data-reveal>
          <p>„{VYBER.branislavKratky}“</p>
          <footer>{RECENZIE.branislav.meno}</footer>
        </blockquote>
        <blockquote class="review" data-reveal>
          <p>„{RECENZIE.gardosova.text}“</p>
          <footer>{RECENZIE.gardosova.meno}</footer>
        </blockquote>
      </div>
      <p class="reviews-more" data-reveal>
        <a class="link-underline gold" href={GOOGLE_PROFIL} target="_blank" rel="noopener">Všetky recenzie na Google →</a>
      </p>
    </div>
  </section>

  <!-- ============ PARTNERI (marquee) ============ -->
  <section class="partners">
    <div class="partners-marquee" id="partners-marquee">
      <div class="partners-track">
        <span class="partners-set">
