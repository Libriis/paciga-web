---
import Base from '../layouts/Base.astro';
import Ui21 from '../components/Ui21.astro';
import LogoCloudSwap from '../components/ui/logo-clouds';
import Foto from '../components/Foto.astro';
import Text from '../components/Text.astro';
import PobockyKarty from '../components/PobockyKarty.astro';
import { getParteList, inicialky, fmtKratky } from '../lib/parte';
import { RECENZIE, VYBER, GOOGLE_PROFIL, GOOGLE_HODNOTENIE } from '../data/recenzie';
// Fotky tejto stránky sa neimportujú cez astro:assets. Stránka má
// prerender = false, takže by z nich vznikli runtime cesty na obrázkovú
// službu a tá pri output: 'static' neexistuje. Hotové varianty sú
// v public/assets/ssr, generuje ich scripts/staticke-obrazky.mjs.

export const prerender = false;

const parteList = (await getParteList()).slice(0, 4);

/* rail recenzií — nekonečná slučka (štýl 21st.dev infinite-moving-cards);
   výňatky podľa pravidiel v data/recenzie.ts, nič vymyslené */
const RECENZIE_RAIL = [
  { t: VYBER.harbinRozlucka, m: RECENZIE.harbin.meno },
  { t: VYBER.branislavKratky, m: RECENZIE.branislav.meno },
  { t: RECENZIE.gardosova.text, m: RECENZIE.gardosova.meno },
  { t: VYBER.fontaniVdaka, m: RECENZIE.fontani.meno },
  { t: VYBER.gallikovaUroven, m: RECENZIE.gallikova.meno },
  { t: RECENZIE.hegli.text, m: RECENZIE.hegli.meno },
];
/* tri stĺpce po dvoch recenziách; každý sa posúva iným tempom */
const REV_COLS = [RECENZIE_RAIL.slice(0, 2), RECENZIE_RAIL.slice(2, 4), RECENZIE_RAIL.slice(4, 6)];
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

/* partneri pre logo cloud — serializovateľné props do React ostrova */
const PARTNERI = [
  { name: 'potom.sk', href: 'https://potom.sk/' },
  { name: 'Kvety Victor', href: 'https://kvetyvictor.sk/' },
  { name: 'More matracov', href: 'https://more-matracov.sk/' },
  { name: 'Reštaurácia Aréna', href: 'https://www.restauracia-arena.sk/' },
  { name: 'Mercedes-Benz', href: 'https://www.mercedes-benz.sk/' },
  { name: 'iZlato', href: 'https://www.izlato.sk/' },
  { name: 'Silencia', href: 'https://silencia.sk/' },
  { name: 'spominam.sk', href: 'https://spominam.sk/' },
];

const title = "Paciga | Pohrebné a kamenárske služby | NON STOP 24/7";
const description = "Pohrebné a kamenárske služby Paciga v Poprade, Spišskej Belej a Liptovskom Mikuláši. NON STOP prevoz zosnulých 24 hodín denne. Volajte 0903 596 364.";
const ogTitle = "Paciga | Pohrebné a kamenárske služby";
const ogDescription = "Dôstojná rozlúčka za každých okolností. NON STOP prevoz zosnulých, volajte 0903 596 364.";
---
<Base title={title} description={description} active="domov" ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/asset-07.jpg" mainId="paci" journey>

  <!-- ============ POSLEDNÁ CESTA (scrollovaná filmová jazda — frame scrub) ============ -->
  <section class="journey" id="hero">
    <div class="journey-pin" id="journey-pin">
      {/* Hotové súbory, nie <Image>. Táto stránka má prerender = false kvôli
          parte z databázy, takže <Image> na nej vracia runtime cestu na
          obrázkovú službu, ktorá sa pri output: 'static' nenasadzuje, a poster
          vracal 404. Šírky aj kvalita sedia s SIRKY_HERO a KVALITA_POZADIE.
          Prekresli cez scripts/staticke-obrazky.mjs. */}
      <img class="journey-poster" id="journey-poster" src="/assets/ssr/journey-poster-1920.webp" srcset="/assets/ssr/journey-poster-480.webp 480w, /assets/ssr/journey-poster-768.webp 768w, /assets/ssr/journey-poster-1080.webp 1080w, /assets/ssr/journey-poster-1440.webp 1440w, /assets/ssr/journey-poster-1920.webp 1920w" sizes="100vw" width="1920" height="1080" alt="Nosiči Paciga v rovnošatách nesú rakvu s kvetinovou výzdobou" loading="eager" fetchpriority="high" decoding="async" />
      <canvas class="journey-canvas" id="journey-canvas" aria-hidden="true" data-journey="a"
        data-frames="965" data-path="assets/journey/f-&#123;i&#125;.webp"
        data-frames-m="482" data-path-m="assets/journey-m/f-&#123;i&#125;.webp"></canvas>
      <div class="journey-shade" aria-hidden="true"></div>

      <!-- HUD V1 „Rivian dráha": spodný pás — počítadlo + skip, ruler
           z tickov s markerom, klikateľné stanice na štartoch kapitol -->
      <div class="jhud">
        <div class="jhud-top">
          <span class="jhud-count"><b id="jhud-now">01</b> / 05</span>
          <button type="button" class="jhud-skip" id="journey-skip">Preskočiť<span class="jhud-skip-tail">&nbsp;príbeh</span></button>
        </div>
        <div class="jhud-ruler" aria-hidden="true">
          <i class="jhud-fill" id="jhud-fill"></i>
          <span class="jhud-bound" style="left:20%"></span>
          <span class="jhud-bound" style="left:40%"></span>
          <span class="jhud-bound" style="left:60%"></span>
          <span class="jhud-bound" style="left:80%"></span>
          <i class="jhud-marker" id="jhud-marker"></i>
        </div>
        <div class="jhud-stations">
          <button type="button" class="jhs" data-station="0" style="left:0%" aria-label="Prejsť na kapitolu Rozlúčka"><span class="jhs-num">01</span><span>Rozlúčka</span></button>
          <button type="button" class="jhs" data-station="1" style="left:20%" aria-label="Prejsť na kapitolu Starostlivosť"><span class="jhs-num">02</span><span>Starostlivosť</span></button>
          <button type="button" class="jhs" data-station="2" style="left:40%" aria-label="Prejsť na kapitolu Cesta"><span class="jhs-num">03</span><span>Cesta</span></button>
          <button type="button" class="jhs" data-station="3" style="left:60%" aria-label="Prejsť na kapitolu Spomienka"><span class="jhs-num">04</span><span>Spomienka</span></button>
          <button type="button" class="jhs" data-station="4" style="left:80%" aria-label="Prejsť na kapitolu Blízko vás"><span class="jhs-num">05</span><span>Blízko vás</span></button>
        </div>
      </div>

      <!-- texty staníc (pinované nad canvasom) -->
      <div class="journey-text jt-hero" data-jt="0">
        <div class="container">
          <Text as="div" class="eyebrow" data-hero-el kluc="index.hero.eyebrow">Rodinná pohrebná a kamenárska služba · od 2018</Text>
          <h1 id="hero-title"><span class="line"><span>Dôstojná rozlúčka</span></span><span class="line"><span>za&nbsp;každých okolností.</span></span></h1>
          <Text as="p" class="hero-lead" data-hero-el kluc="index.hero.lead">Pohrebné obrady, preprava a kamenárstvo. Sme pri vás nepretržite, každý deň v roku.</Text>
          <div class="hero-actions" data-hero-el>
            <a href="tel:0903596364" class="btn-gold">NON STOP · 0903 596 364</a>
            <a href="#sluzby" class="btn-line">Naše služby →</a>
          </div>
        </div>
      </div>
      <div class="journey-text jt-mid" data-jt="1">
        <h2>Kompletná starostlivosť<br>pod jednou strechou</h2>
        <Text as="p" kluc="index.jazda.starostlivost">Obrad a pochovanie, kremácia, kvetinová výzdoba, spomienkové predmety aj kamenárstvo.</Text>
      </div>
      <div class="journey-text jt-mid" data-jt="2">
        <div class="badge-pill"><Text kluc="index.jazda.ocenenie">Ocenená ako najkrajšia na Slovensku</Text></div>
        <h2>Pohrebná limuzína,<br>ktorá vzdáva úctu</h2>
      </div>
      <div class="journey-text jt-mid" data-jt="3">
        <h2>„Nikdy nezabudnem.“</h2>
        <Text as="p" kluc="index.jazda.sperky">Spomienkové šperky s odtlačkom prsta. Kúsok blízkeho človeka navždy.</Text>
      </div>
      <div class="journey-text jt-mid" data-jt="4">
        <h2>Spod Tatier<br>Aj vo&nbsp;vašom meste</h2>
        <Text as="p" kluc="index.jazda.pobocky">Poprad, Spišská Belá a Liptovský Mikuláš</Text>
        <a href="tel:0903596364" class="btn-gold jt-cta">NON STOP · 0903 596 364</a>
      </div>
    </div>

    <!-- reduced-motion / no-JS: kľúčové zábery pod sebou -->
    <div class="journey-fallback" aria-hidden="true">
      <img src="/assets/ssr/journey-poster-1920.webp" srcset="/assets/ssr/journey-poster-480.webp 480w, /assets/ssr/journey-poster-768.webp 768w, /assets/ssr/journey-poster-1080.webp 1080w, /assets/ssr/journey-poster-1440.webp 1440w, /assets/ssr/journey-poster-1920.webp 1920w" sizes="100vw" width="1920" height="1080" alt="" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- ============ ČO SPRAVIŤ AKO PRVÉ (krízová dráha) ============
       Pilotná utility-first sekcia (Tailwind v4, tokeny z tw.css). -->
  <section class="firststeps relative overflow-hidden bg-ink2 border-y border-solid border-line py-[clamp(68px,9vh,115px)]" id="prve-kroky">
    <span class="fs-q" aria-hidden="true">?</span>
    <div class="container">
      <div>
        <h2 class="text-[clamp(28px,3.6vw,46px)]" data-textreveal>Čo spraviť ako prvé</h2>
        <p class="mt-3 text-soft text-[18.6px]" data-textreveal>Tri kroky. O všetko ostatné sa postaráme my.</p>
      </div>
      <!-- tracing beam: svetelná linka spája kroky 01 → 03 pri scrolle -->
      <div class="fs-beam" aria-hidden="true">
        <i id="fs-beam-fill"></i>
        <span class="fs-beam-dot" style="left:0%"></span>
        <span class="fs-beam-dot" style="left:33.75%"></span>
        <span class="fs-beam-dot" style="left:67.5%"></span>
      </div>
      <ol class="list-none grid grid-cols-1 gap-[30px] min-[861px]:grid-cols-3 min-[861px]:gap-[clamp(28px,3vw,48px)] mt-[clamp(40px,6vh,64px)] min-[861px]:mt-0">
        <li class="border-t border-solid border-line min-[861px]:border-t-0 min-[861px]:pt-0 pt-[22px]" data-reveal>
          <span class="text-[13px] font-[650] tracking-[0.14em] text-gold">01</span>
          <h3 class="mt-[14px] text-[21px]">Zavolajte nám</h3>
          <p class="mt-[10px] text-soft text-[17.4px] leading-[1.65]">Kedykoľvek, aj o tretej ráno. Sme na linke nepretržite.</p>
          <a class="inline-block mt-[14px] text-[clamp(22px,2.2vw,28px)] font-[680] text-gold [font-variation-settings:var(--wide)] transition-colors duration-300 hover:text-soft" href="tel:0903596364">0903 596 364</a>
        </li>
        <li class="border-t border-solid border-line min-[861px]:border-t-0 min-[861px]:pt-0 pt-[22px]" data-reveal>
          <span class="text-[13px] font-[650] tracking-[0.14em] text-gold">02</span>
          <h3 class="mt-[14px] text-[21px]">My prídeme k vám</h3>
          <p class="mt-[10px] text-soft text-[17.4px] leading-[1.65]">Zosnulého dôstojne prevezieme. Doma, v nemocnici aj v zariadení.</p>
        </li>
        <li class="border-t border-solid border-line min-[861px]:border-t-0 min-[861px]:pt-0 pt-[22px]" data-reveal>
          <span class="text-[13px] font-[650] tracking-[0.14em] text-gold">03</span>
          <h3 class="mt-[14px] text-[21px]">Ostatné vybavíme spolu</h3>
          <p class="mt-[10px] text-soft text-[17.4px] leading-[1.65]">Dokumenty, obrad, kvety aj oznámenia. Prevedieme vás krok za krokom.</p>
        </li>
      </ol>
      <a class="btn-line mt-[clamp(36px,5vh,54px)]" href="/informacie-pre-pozostalych" data-reveal>Podrobný sprievodca pre pozostalých →</a>
    </div>
  </section>

  <!-- ============ SLUŽBY (21st.dev bankkroll/commerce-hero) ============
       Štruktúra predlohy 1:1: panel s nadpisom a zapusteným blokom vľavo
       hore, pod ním karty s názvom navrchu, médiom v strede a vyrezaným
       rohom vpravo dole s kruhovou šípkou. Farby v brand tokenoch.
       Fotky sú zatiaľ placeholdery s popisom, čo na zábere má byť. -->
  <section id="sluzby" class="register">
    <div class="orb" style="top:4%;right:-12%" aria-hidden="true"></div>
    <div class="container">

      <div class="svc-head">
        <div class="svc-head-left">
          <div class="eyebrow svc-eyebrow" data-reveal>Čo všetko vybavíme za vás</div>
          <h2 class="svc-title" data-textreveal><span class="svc-title-grad">Všetko potrebné</span><br>pod jednou strechou</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <p class="svc-lead svc-tags" data-reveal>
            <a href="/pohrebne-sluzby#rakvy">#rakvy</a>
            <a href="/pohrebne-sluzby#rozlucka">#rozlúčka</a>
            <a href="/pohrebne-sluzby#kremacia">#kremácia</a>
            <a href="/pohrebne-sluzby#kvetinarstvo">#kvetinárstvo</a>
            <a href="/pohrebne-sluzby#oblecenie">#oblečenie</a>
            <a href="/pohrebne-sluzby#karty">#spomienkovékarty</a>
            <a href="/pohrebne-sluzby#prevoz">#prevozNONSTOP</a>
            <a href="/pohrebne-sluzby#medzinarodny-prevoz">#medzinárodnýprevoz</a>
            <a href="/pohrebne-sluzby#limuzina">#pohrebnálimuzína</a>
            <a href="/pohrebne-sluzby#chladenie">#chladenie</a>
            <a href="/pohrebne-sluzby#kamenarstvo">#kamenárstvo</a>
            <a href="/pohrebne-sluzby#vizualizacia">#3Dvizualizácia</a>
            <a href="/pohrebne-sluzby#poradenstvo">#smútkovéporadenstvo</a>
            <a href="/pohrebne-sluzby#predpriprava">#predpríprava</a>
            <a href="/sperky">#spomienkovéšperky</a>
          </p>
      </div>

      <div class="svc-grid">
        <a class="svc-card" href="/pohrebne-sluzby#rakvy" data-reveal>
          <h3 class="svc-card-title">Obrad<br>a preprava</h3>
          <div class="svc-card-media">
            <img class="svc-card-photo" src="/assets/ssr/svc-obrad-640.webp" srcset="/assets/ssr/svc-obrad-320.webp 320w, /assets/ssr/svc-obrad-480.webp 480w, /assets/ssr/svc-obrad-640.webp 640w, /assets/ssr/svc-obrad-960.webp 960w, /assets/ssr/svc-obrad-1280.webp 1280w" sizes="(max-width: 900px) 92vw, 33vw" width="1280" height="1280" alt="Biela pohrebná limuzína Paciga so smútočným sprievodom" loading="lazy" decoding="async" />
          </div>
          <span class="svc-link">Zobraziť služby
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </span>
        </a>

        <a class="svc-card" href="/pohrebne-sluzby#kvetinarstvo" data-reveal>
          <h3 class="svc-card-title">Starostlivosť<br>o pozostalých</h3>
          <div class="svc-card-media">
            <img class="svc-card-photo" src="/assets/ssr/svc-starostlivost-640.webp" srcset="/assets/ssr/svc-starostlivost-320.webp 320w, /assets/ssr/svc-starostlivost-480.webp 480w, /assets/ssr/svc-starostlivost-640.webp 640w, /assets/ssr/svc-starostlivost-960.webp 960w, /assets/ssr/svc-starostlivost-1280.webp 1280w" sizes="(max-width: 900px) 92vw, 33vw" width="1280" height="1280" alt="Personál Paciga nesie smútočný veniec v tvare srdca" loading="lazy" decoding="async" />
          </div>
          <span class="svc-link">Zobraziť služby
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </span>
        </a>

        <a class="svc-card" id="kamenarstvo" href="/pohrebne-sluzby#kamenarstvo" data-reveal>
          <h3 class="svc-card-title">Kamenárstvo</h3>
          <div class="svc-card-media">
            <img class="svc-card-photo" src="/assets/ssr/svc-kamenarstvo-640.webp" srcset="/assets/ssr/svc-kamenarstvo-320.webp 320w, /assets/ssr/svc-kamenarstvo-480.webp 480w, /assets/ssr/svc-kamenarstvo-640.webp 640w, /assets/ssr/svc-kamenarstvo-960.webp 960w, /assets/ssr/svc-kamenarstvo-1280.webp 1280w" sizes="(max-width: 900px) 92vw, 33vw" width="1280" height="1280" alt="Žulový pomník z kamenárstva Paciga na cintoríne" loading="lazy" decoding="async" />
          </div>
          <span class="svc-link">Zobraziť služby
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </span>
        </a>
      </div>

      <a class="btn-gold svc-all" href="/pohrebne-sluzby" data-reveal>Prezrieť si všetky naše služby</a>
    </div>
  </section>

  <!-- ============ RECENZIE (21st.dev sshahaider/testimonials-columns-1) ============
       Tri stĺpce sa nekonečne posúvajú nahor, každý iným tempom (15/19/17 s
       ako v predlohe). Namiesto profilovej fotky ide logo Google, lebo
       recenzie sú odtiaľ. Hodnotenie po kartách nepridávam, dáta ho
       neobsahujú a recenzie sa nevymýšľajú. -->
  <section class="reviews" id="recenzie">
    <!-- logo Google raz, karty ho použijú cez <use> -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <symbol id="g-logo" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </symbol>
    </svg>

    <div class="container">
      <div class="rev-head">
        <span class="rev-badge">Recenzie</span>
        <h2 data-textreveal>Slová rodín, ktoré sme sprevádzali.</h2>
        <p data-reveal>Všetky pochádzajú z nášho profilu na Google.</p>
        <a class="rev-rating" data-reveal href={GOOGLE_PROFIL} target="_blank" rel="noopener" aria-label={`Hodnotenie ${GOOGLE_HODNOTENIE.toFixed(1).replace('.', ',')} z 5 na Google`}>
          <span class="rev-stars" style={`--fill:${(GOOGLE_HODNOTENIE / 5) * 100}%`} aria-hidden="true">
            <span class="rev-stars-bg">★★★★★</span>
            <span class="rev-stars-fg">★★★★★</span>
          </span>
          <b>{GOOGLE_HODNOTENIE.toFixed(1).replace('.', ',')}</b>
          <i>na Google</i>
        </a>
      </div>

      <div class="rev-cols" data-reveal>
        {REV_COLS.map((col) => (
          <div class="rev-col">
            <div>
              {[0, 1].map((dup) => col.map((r) => (
                <article class="revcol-card" aria-hidden={dup === 1 ? 'true' : undefined}>
                  <p>„{r.t}“</p>
                  <footer>
                    <svg class="rev-g" aria-hidden="true"><use href="#g-logo" /></svg>
                    <span>
                      <b>{r.m}</b>
                      <i>Google</i>
                    </span>
                  </footer>
                </article>
              )))}
            </div>
          </div>
        ))}
      </div>

      <p class="reviews-more" data-reveal>
        <a class="btn-line" href={GOOGLE_PROFIL} target="_blank" rel="noopener">Všetky recenzie na Google →</a>
      </p>
    </div>
  </section>

  <!-- ============ POBOCKY ============ -->
  <section id="pobocky" class="branches">
    <div class="orb" style="top:-16%;left:30%" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <h2 data-textreveal>Tri pobočky, jedna rodina</h2>
        <div class="gold-line" data-line aria-hidden="true"></div>
      </div>
      {/* zjednotené s /kontakt (14.8.2026): jeden komponent, plné údaje
          vrátane mailov, prevádzkových čísel a otváracích hodín */}
      <PobockyKarty />
    </div>
  </section>

  <!-- ============ NONSTOP callout ============ -->
  <section class="nonstop">
    <div class="container nonstop-inner">
      <div class="nonstop-left">
        <div class="gold-rule" data-line aria-hidden="true"></div>
        <div>
          <div class="nonstop-title" data-reveal>Potrebujete pomôcť práve teraz?</div>
          <div class="nonstop-sub" data-reveal>NON STOP prevoz zosnulých. Sme pri vás v ktorúkoľvek hodinu, aj v noci a cez víkendy.</div>
        </div>
      </div>
      <div class="nonstop-right" data-reveal>
        <span class="micro-label">NON STOP LINKA</span>
        <a href="tel:0903596364" class="phone-primary">0903 596 364</a>
        <a href="tel:0948110109" class="phone-secondary">0948 110 109</a>
      </div>
    </div>
  </section>

  <!-- ============ OPUSTILI NAS ============ -->
  <section id="opustili" class="memoriam">
    <div class="orb" style="bottom:-18%;left:-14%" aria-hidden="true"></div>
    <div class="container">
      <div class="memoriam-head">
        <div>
          <h2 data-textreveal>Opustili nás</h2>
          <div class="gold-line" data-line aria-hidden="true"></div>
        </div>
        <a href="/opustili-nas" class="btn-line" data-reveal>Všetky spomienky →</a>
      </div>
      <div class="memoriam-grid">
        {parteList.map((p) => (
          <div class={`memoriam-card${p.sviecky > 0 ? " warm" : ""}${p.sviecky >= 10 ? " heat3" : p.sviecky >= 3 ? " heat2" : ""}`} data-reveal data-slug={p.slug}>
            <a class="memoriam-link" href={`/parte/${p.slug}`}>
              <div class="memoriam-photo" aria-hidden="true">{p.foto_url
                ? <Foto src={p.foto_url} widths={[220, 440]} sizes="(max-width: 560px) 92vw, 260px" />
                : <span>{inicialky(p.meno)}</span>}</div>
              <h3>{p.meno}</h3>
              <div class="memoriam-date">† {fmtKratky(p.datum_umrtia)}</div>
            </a>
            <div class="memoriam-candle" aria-hidden="true"><span class="spark"></span><span class="spark"></span><span class="spark"></span><i class="flame"></i></div><div class="memoriam-links"><button type="button" class="gold-link candle-btn">Zapáliť sviečku<span class="candle-count">{p.sviecky > 0 ? ` · ${p.sviecky}` : ''}</span></button><a href={`/parte/${p.slug}`} class="soft-link">Kondolencia</a></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA band ============ -->
  <section class="cta-band" id="kontakt">
    <div class="cta-inner">
      <h2 data-textreveal>Sme pri vás, keď to najviac potrebujete</h2>
      <p data-textreveal>Zavolajte kedykoľvek. Poradíme vám a všetko ostatné vybavíme.</p>
      <a href="tel:0903596364" class="btn-gold btn-lg" data-reveal>NON STOP · 0903 596 364</a>
    </div>
  </section>

  <!-- ============ PARTNERI — logo cloud s vlnou (21st.dev logo-clouds) ============
       React ostrov cez Ui21; marquee nahradený statickým cloudom monogramov,
       ktorým každých pár sekúnd prebehne wipe vlna. -->
  <section class="partners">
    <div class="container">
      <Ui21>
        <LogoCloudSwap
          client:visible
          partners={PARTNERI}
          title="Naši partneri"
          subtitle="Overené značky, s ktorými spolupracujeme."
        />
      </Ui21>
    </div>
  </section>

<Fragment slot="scripts">
<script is:inline src="/js/candles.js"></script>
</Fragment>
</Base>
