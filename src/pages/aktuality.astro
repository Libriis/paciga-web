---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { getClanky, maDetail } from '../lib/clanky';

// Články spravuje redaktor v /admin/clanky, preto sa čítajú za behu.
// Bez databázy (alebo kým je tabuľka prázdna) padne knižnica späť na
// pôvodný src/data/aktuality.ts, takže prehľad nikdy nie je prázdny.
export const prerender = false;

const title = "Aktuality | Paciga, pohrebné a kamenárske služby";
const description = "Aktuality pohrebnej služby Paciga: prvé kroky po úmrtí, plánovanie vopred, spomienkové šperky a novinky z našej práce.";
const ogTitle = "Aktuality | Paciga";
const ogDescription = "Rady a novinky, ktoré pomáhajú: prvé kroky po úmrtí, plánovanie vopred aj spomienkové šperky.";

// Kategórie z verejných aktualít odstránené 14.8.2026 na pokyn klienta:
// prehľad je jednoduchý chronologický zoznam bez filtrov a štítkov.
// Pole kategoria v DB a admine ostáva, len sa nezobrazuje.
const clanky = await getClanky();
---
<Base title={title} description={description} active="aktuality" ogTitle={ogTitle} ogDescription={ogDescription}>

  <!-- ============ HLAVIČKA: newsroom band (Jeton pattern, 29. 7. 2026) ====
       Biely akcentový pás so zaoblenym spodkom: obrí titulok vľavo,
       lead vpravo. Biela je jediný povolený akcent, plocha robí dôraz. -->
  <section class="news-hero">
    <div class="container news-hero-inner">
      <div>
        <div class="eyebrow" data-reveal>Aktuality</div>
        <h1 data-textreveal>Rady a novinky,<br>ktoré pomáhajú.</h1>
      </div>
      <p class="news-hero-lead" data-reveal>Prvé kroky po úmrtí, plánovanie vopred, spomienkové šperky a novinky z našej práce. Pre pozostalých aj pre tých, ktorí myslia dopredu.</p>
    </div>
  </section>

  <!-- ============ NAJNOVŠIE ČLÁNKY + FILTER + MRIEŽKA ============ -->
  <section class="news">
    <div class="container">

      <div class="news-head" data-reveal>
        <h2>Najnovšie články</h2>
      </div>

      <div class="news-grid">
        {clanky.map((c) => (
          <article class:list={['news-card', { 'has-detail': maDetail(c) }]} data-reveal>
            <div class="news-photo">
              <Foto src={c.foto} alt={c.fotoAlt} widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, (max-width: 1100px) 46vw, 30vw" />
            </div>
            <div class="news-card-body">
              {/* článok s telom: klikateľná je celá karta (stretched link) */}
              <h3>{maDetail(c)
                ? <a class="news-card-link" href={`/aktuality/${c.slug}`}>{c.titulok}</a>
                : c.titulok}</h3>
              <div class="news-date">{c.datum}</div>
              <p>{c.text}</p>
              {maDetail(c)
                ? <span class="news-go">Čítať článok →</span>
                : c.link && <a class="news-go" href={c.link}>{c.linkText}</a>}
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</Base>
