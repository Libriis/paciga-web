---
import Base from '../layouts/Base.astro';

const title = "Aktuality | Paciga, pohrebné a kamenárske služby";
const description = "Novinky pohrebnej služby Paciga: spolupráce, konferencie a praktické rady pre pozostalých.";
const ogTitle = "Aktuality | Paciga";
const ogDescription = "Čo je nové v Pacige: novinky, partnerstvá a rady, ktoré pomáhajú.";
---
<Base title={title} description={description} active="aktuality" ogTitle={ogTitle} ogDescription={ogDescription}>



  <!-- ============ HLAVIČKA ============ -->
  <section class="page-head">
    <div class="container">
      <div class="eyebrow" data-reveal>Aktuality</div>
      <h1 data-textreveal>Čo je nové<br>v Pacige.</h1>
      <p class="page-head-lead" data-reveal>Novinky, spolupráce a praktické rady, ktoré pomáhajú pozostalým aj tým, ktorí myslia dopredu.</p>
    </div>
  </section>

  <!-- ============ ZOZNAM ČLÁNKOV ============ -->
  <section class="news">
    <div class="container">

      <article class="news-item" data-reveal>
        <div class="news-date">29. mája 2026</div>
        <div class="news-body">
          <div class="news-tag">Rada</div>
          <h3>Odtlačok prsta zosnulého na pamiatku</h3>
          <p>Ako vzniká spomienkový šperk: od sňatia odtlačku až po gravírovanie do striebra, zlata alebo ružového zlata. Kúsok blízkeho človeka, ktorý zostáva navždy.</p>
          <a class="news-go" href="/sperky">Pozrieť kolekciu šperkov →</a>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">26. mája 2026</div>
        <div class="news-body">
          <div class="news-tag">Novinka</div>
          <h3>Zúčastnili sme sa Medzinárodnej konferencie pohrebných služieb na Slovensku</h3>
          <p>Priniesli sme si poznatky a kontakty, ktoré posúvajú naše služby ďalej. Vzdelávame sa, aby ste u nás vždy našli aktuálny štandard starostlivosti.</p>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">30. januára 2026</div>
        <div class="news-body">
          <div class="news-tag">Rada</div>
          <h3>Viac než pohrebná služba: kompletné riešenie pre pozostalých</h3>
          <p>Od prevozu a obradu po kamenárstvo a smútkové poradenstvo. Prehľad všetkého, čo za vás vieme vybaviť, aby ste sa mohli sústrediť na rozlúčku.</p>
          <a class="news-go" href="/pohrebne-sluzby">Prehľad služieb →</a>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">14. januára 2026</div>
        <div class="news-body">
          <div class="news-tag">Rada</div>
          <h3>Riešenie pozostalosti po pohrebe</h3>
          <p>Dedičské konanie, úrady, zmluvy a účty. Na koho sa obrátiť po pohrebe a s čím vám vieme pomôcť my a naši partneri.</p>
          <a class="news-go" href="/informacie-pre-pozostalych">Sprievodca pre pozostalých →</a>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">11. decembra 2025</div>
        <div class="news-body">
          <div class="news-tag">Spolupráca</div>
          <h3>Spolupráca so Spomínam.sk</h3>
          <p>Spájame sa s platformou Spomínam.sk, aby spomienky na blízkych zostali živé aj v digitálnom priestore.</p>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">26. novembra 2025</div>
        <div class="news-body">
          <div class="news-tag">Spolupráca</div>
          <h3>Digitálna pomoc po pohrebe: spolupracujeme s platformou Potom.sk</h3>
          <p>Potom.sk uľahčuje pozostalým vybavovanie všetkého, čo po pohrebe nasleduje. Sme radi, že našim rodinám vieme ponúknuť aj túto podporu.</p>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">13. októbra 2025</div>
        <div class="news-body">
          <div class="news-tag">Rada</div>
          <h3>Smútočné oznámenia, fotografia zosnulého a smútočná hudba</h3>
          <p>Praktický sprievodca prípravou parte, výberom fotografie a hudby na rozlúčku. Malé rozhodnutia, ktoré dodajú obradu osobný tón.</p>
        </div>
      </article>

      <article class="news-item" data-reveal>
        <div class="news-date">9. októbra 2025</div>
        <div class="news-body">
          <div class="news-tag">Novinka</div>
          <h3>XXI. Konferencia HCA Slovakia</h3>
          <p>Boli sme pri tom: odborná konferencia o štandardoch a inováciách v pohrebníctve. Držíme krok s tým najlepším v odbore.</p>
        </div>
      </article>

    </div>
  </section>

</Base>
