{
  "ci": {
    "collect": {
      "url": [
        "https://paciga-web.vercel.app/",
        "https://paciga-web.vercel.app/kontakt",
        "https://paciga-web.vercel.app/sperky"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],

        "resource-summary:font:count": ["error", { "maxNumericValue": 2 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 150000 }],

        "resource-summary:total:size": ["warn", { "maxNumericValue": 1300000 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 700000 }],

        "uses-responsive-images": "off",
        "unused-css-rules": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
