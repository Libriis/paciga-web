# Supabase — URL projektu a "anon public" kľúč (Settings → API)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Resend — e-maily z kontaktného formulára a notifikácie kondolencií (nepovinné)
RESEND_API_KEY=re_...
# Odosielateľ — po overení domény paciga.sk v Resend zmeň napr. na "Paciga web <web@paciga.sk>"
RESEND_FROM=Paciga web <onboarding@resend.dev>
# Kam chodia dopyty a notifikácie
KONTAKT_EMAIL=paciga@paciga.sk

# Ľubovoľný náhodný reťazec — soľ pre anonymné hashovanie IP pri sviečkach
SVIECKA_SALT=zmen-ma-na-nahodny-retazec

# Podpisový kľúč pre zapaľovanie sviečok. Musí sa PRESNE zhodovať s hodnotou
# v tabuľke private.app_secret (kluc 'sviecka_hmac'). Bez neho sa dá počítadlo
# sviečok nafúknuť priamym volaním databázy. Náhodný reťazec, napr.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SVIECKA_RPC_SECRET=zmen-ma-na-nahodny-retazec
